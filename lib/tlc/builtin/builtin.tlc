package builtin;

// Compiler intrinsics. The compiler supplies the bodies of trace, va, and panic,
// and of the methods on Malloc. It replaces atomic_load, atomic_store, atomic_rmw,
// atomic_cmpxchg, and fence with atomic instructions. memeql and memcmp are ordinary
// tlc in this file.
// The comptime slice overload is chosen when both arguments are comptime values.
// A call of two constant []const u8 values is folded while compiling.

// Type is the type of a type. typeof produces it.
// The compiler adds this export. A typedef with this name would hide it.

// One field returned by Type.fields. name is the field's name. kind is its type.
// kind points at that type. The type is constant. Storing through kind is rejected.
export type Field struct {
    export name []const u8;
    export kind *const Type;
};

// The spelling of this type, the same text a diagnostic prints.
// The bytes are constant. A store through the pointer is type mismatch.
export func Type::name(self this) *const u8;

// The fields of a named struct, in the order they are written.
// A tuple lists one field per element. The name is the index, "0", "1", and so on.
// The element is constant. A type that is neither a named struct nor a tuple has length 0.
export func Type::fields(self this) []const Field;

// `{0}` and `{1}` read elements of a compile-time tuple. `{{` and `}}` are braces.
// A string element is copied as text. An integer element is decimal. The call is that text.
export func fmt[T type](text comptime []const u8, value comptime T) []const u8;

// The calls that have not returned, newest first.
// The pointer addresses this thread's buffer. The next call on that thread replaces that text.
export func trace() *const u8;

// The extra arguments of the variadic function this call is inside.
// The pointer is the argument pointer vprintf takes. Each call reads those arguments from the start.
export func va() *u8;

// Prints the message and the call stack, then aborts the process.
export func panic(message *const u8) void;

// The libc heap. new and delete call malloc, free, and realloc directly.
export type Malloc struct {};

// The allocator new and delete use when the call names none.
export var allocator Malloc;

// Reserves size bytes. An alignment above 16 uses aligned_alloc.
// Returns null when the reservation fails. The caller handles null.
export unsafe func Malloc::malloc(self *this, size i32, align i32) ?*u8;

// Releases a block from malloc or realloc. A null pointer does nothing.
export func Malloc::free(self *this, ptr *u8) void;

// Changes the size of a block. A null pointer reserves a new block, as malloc does.
// Returns null when the reservation fails. The caller handles null.
export unsafe func Malloc::realloc(self *this, ptr *u8, size i32, align i32) ?*u8;

// 1 when the lengths match and every element matches. Otherwise 0.
export func memeql[T type](lhs *const T, lhslen i32, rhs *const T, rhslen i32) i32 {
    if (lhslen != rhslen) {
        return 0;
    }
    var i i32 = 0;
    while (i < lhslen) {
        if (lhs[i] != rhs[i]) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// True when both slices are comptime values and hold the same elements.
// Chosen instead of the runtime overload when both arguments are comptime.
export func memeql[T type](lhs comptime []const T, rhs comptime []const T) bool {
    if (lhs.len != rhs.len) {
        return false;
    }
    var i i32 = 0;
    while (i < lhs.len) {
        if (lhs[i] != rhs[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// True when the slices have the same length and the same elements.
export func memeql[T type](lhs []const T, rhs []const T) bool {
    if (lhs.len != rhs.len) {
        return false;
    }
    var i i32 = 0;
    while (i < lhs.len) {
        if (lhs[i] != rhs[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Element order. -1 when lhs is less, 1 when lhs is greater, 0 when they match.
// A shared prefix takes the shorter length as less.
export func memcmp[T type](lhs *const T, lhslen i32, rhs *const T, rhslen i32) i32 {
    var n i32 = lhslen;
    if (rhslen < n) {
        n = rhslen;
    }
    var i i32 = 0;
    while (i < n) {
        if (lhs[i] < rhs[i]) {
            return -1;
        }
        if (rhs[i] < lhs[i]) {
            return 1;
        }
        i = i + 1;
    }
    if (lhslen < rhslen) {
        return -1;
    }
    if (rhslen < lhslen) {
        return 1;
    }
    return 0;
}

// Element order of two comptime slices, the same rule as the pointer form.
// Chosen instead of the runtime overload when both arguments are comptime.
export func memcmp[T type](lhs comptime []const T, rhs comptime []const T) i32 {
    var n i32 = lhs.len;
    if (rhs.len < n) {
        n = rhs.len;
    }
    var i i32 = 0;
    while (i < n) {
        if (lhs[i] < rhs[i]) {
            return -1;
        }
        if (rhs[i] < lhs[i]) {
            return 1;
        }
        i = i + 1;
    }
    if (lhs.len < rhs.len) {
        return -1;
    }
    if (rhs.len < lhs.len) {
        return 1;
    }
    return 0;
}

// Element order of two slices, the same rule as the pointer form.
export func memcmp[T type](lhs []const T, rhs []const T) i32 {
    var n i32 = lhs.len;
    if (rhs.len < n) {
        n = rhs.len;
    }
    var i i32 = 0;
    while (i < n) {
        if (lhs[i] < rhs[i]) {
            return -1;
        }
        if (rhs[i] < lhs[i]) {
            return 1;
        }
        i = i + 1;
    }
    if (lhs.len < rhs.len) {
        return -1;
    }
    if (rhs.len < lhs.len) {
        return 1;
    }
    return 0;
}

// Atomic operations. The body typechecks the call. Code generation replaces the call,
// so this body does not run. order is 0 relaxed, 1 acquire, 2 release, 3 acq_rel, 4 seq_cst.
// T is an integer of 8, 16, 32, or 64 bits, or a pointer. Another T is not supported yet.
// A var order is type mismatch. An unknown order is type mismatch.
export func atomic_load[T type](p *T, order comptime i32) T {
    panic("atomic");
    return *p;
}

export func atomic_store[T type](p *T, value T, order comptime i32) void {
    *p = value;
    panic("atomic");
}

// op is 0 xchg, 1 add, 2 sub, 3 and, 4 or, 5 xor. The result is the previous value.
export func atomic_rmw[T type](p *T, op comptime i32, value T, order comptime i32) T {
    panic("atomic");
    return *p;
}

// Strong compare-exchange. The results are the previous value and whether the store happened.
// success is the order when the values match. failure is the order when they do not.
export func atomic_cmpxchg[T type](p *T, expected T, desired T, success comptime i32, failure comptime i32) (T, bool) {
    panic("atomic");
    return *p, false;
}

// A relaxed fence is no instruction. Another order is a fence.
// The name is not a value. `var f = fence` is not supported yet.
export func fence(order comptime i32) void {
    panic("atomic");
}
