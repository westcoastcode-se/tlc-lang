package builtin;

// Compiler intrinsics. `extern(abi="compiler")` marks a type, method, or function
// the compiler implements or checks against. A signature that drifts is `type mismatch`.
// The compiler supplies the bodies of trace, va, and panic, and of the methods on Malloc.
// atomic_load, atomic_store, atomic_rmw, atomic_cmpxchg, and fence have no body:
// code generation replaces the call.
// Allocator is that trait. The typed alloc and realloc defaults are ordinary tlc here.
// memeql and memcmp live in std/mem.

// The trait new and delete require. Every file can name Allocator.
// malloc returns null when the reservation fails. free releases that block.
// realloc changes the size. A null pointer reserves a new block, as malloc does.
extern(abi="compiler") export type Allocator trait {
    unsafe func malloc(size i32, align i32) ?*u8;
    func free(ptr *u8) void;
    unsafe func realloc(ptr *u8, size i32, align i32) ?*u8;
}

// One object. Null from malloc is `out of memory`, the same failure as `new`.
// The function is `unsafe`, so the body does not repeat the prefix.
extern(abi="compiler") export unsafe func Allocator::malloc[T type](self *this) ?*T {
    var value = self.malloc(sizeof(T), alignof(T));
    return ?*T(value);
}

// One object. The result is not optional. A failed reservation aborts.
extern(abi="compiler") export func Allocator::alloc[T type](self *this) *T {
    unsafe {
        var raw = self.malloc(sizeof(T), alignof(T));
        if (raw != null) {
            return *T(raw);
        }
    }
    panic("out of memory"b);
}

// `count` elements. The result is that slice. A count below 1 is `type mismatch`.
extern(abi="compiler") export func Allocator::alloc[T type](self *this, count i32) []T {
    if (count < 1) {
        panic("type mismatch"b);
    }
    unsafe {
        var raw = self.malloc(count * sizeof(T), alignof(T));
        if (raw != null) {
            return (*T(raw))[0:count];
        }
    }
    panic("out of memory"b);
}

// One object, replacing `ptr`. A null pointer reserves a new block.
extern(abi="compiler") export func Allocator::realloc[T type](self *this, ptr *T) *T {
    unsafe {
        var raw = self.realloc(*u8(ptr), sizeof(T), alignof(T));
        if (raw != null) {
            return *T(raw);
        }
    }
    panic("out of memory"b);
}

// `count` elements. A block that already holds at least `count` is returned as it is.
// A count below 1 is `type mismatch`.
extern(abi="compiler") export func Allocator::realloc[T type](self *this, block []T, count i32) []T {
    if (count < 1) {
        panic("type mismatch"b);
    }
    if (block.len >= count) {
        return block;
    }
    unsafe {
        var raw = self.realloc(*u8(*T(block)), count * sizeof(T), alignof(T));
        if (raw != null) {
            return (*T(raw))[0:count];
        }
    }
    panic("out of memory"b);
}

extern(abi="compiler") export type TypeKind enum {
    Other,
    Function,
    Struct,
}

extern(abi="compiler") type Desc struct {
    name *const u8;
    fields []const Field;
}

extern(abi="compiler") export type Function struct {
    desc *const Desc;
    export has_this bool;
    export generic bool;
    export variadic bool;
}

extern(abi="compiler") export type Struct struct {
    desc *const Desc;
    export generic bool;
}

extern(abi="compiler") export type Other struct {
    desc *const Desc;
}

// CompiledType is the tagged value stored for one type.
// TypeKind(value) reads which arm is active. Other is every type that is not a
// function and not a struct: a union, a pointer, an array, a slice, an enum, a tuple.
// Function is a function. has_this is true when it has a receiver. generic is true
// when it has type parameters. variadic is true when the parameter list ends with `...`.
// Struct is a struct. generic is true when that struct is a specialization.
// desc holds the spelling and the fields. Another package cannot name desc.
// The compiler supplies the bodies of name and fields.
extern(abi="compiler") export type CompiledType union(TypeKind) {
    Other Other;
    Function Function;
    Struct Struct;
}

// Type is a pointer to that value. typeof returns Type. The union is not copied.
extern(abi="compiler") export type Type *const CompiledType;

// One field returned by fields. name is the field's name. kind is its type.
// kind is that Type pointer. The type is constant. Storing through kind is rejected.
extern(abi="compiler") export type Field struct {
    export name []const u8;
    export kind Type;
};

// The spelling of this type, the same text a diagnostic prints.
// The bytes are constant. A store through the pointer is type mismatch.
extern(abi="compiler") export func CompiledType::name(self *const this) *const u8;

// The fields of a named struct, in the order they are written.
// A tuple lists one field per element. The name is the index, "0", "1", and so on.
// The element is constant. A type that is neither a named struct nor a tuple has length 0.
extern(abi="compiler") export func CompiledType::fields(self *const this) []const Field;

// `{0}` and `{1}` read elements of a compile-time tuple. `{{` and `}}` are braces.
// A string element is copied as text. An integer element is decimal. The call is that text.
extern(abi="compiler") export func fmt[T type](text comptime []const u8, value comptime T) []const u8;

// The calls that have not returned, newest first.
// The pointer addresses this thread's buffer. The next call on that thread replaces that text.
extern(abi="compiler") export func trace() *const u8;

// The extra arguments of the variadic function this call is inside.
// The pointer is the argument pointer vprintf takes. Each call reads those arguments from the start.
extern(abi="compiler") export func va() *u8;

// Prints the message and the call stack, then aborts the process.
extern(abi="compiler") export func panic(message *const u8) void;

// The libc heap. new and delete call malloc, free, and realloc directly.
extern(abi="compiler") export type Malloc struct {};

// The allocator new and delete use when the call names none.
export var allocator Malloc;

// Reserves size bytes. An alignment above 16 uses aligned_alloc.
// Returns null when the reservation fails. The caller handles null.
extern(abi="compiler") export unsafe func Malloc::malloc(self *this, size i32, align i32) ?*u8;

// Releases a block from malloc or realloc. A null pointer does nothing.
extern(abi="compiler") export func Malloc::free(self *this, ptr *u8) void;

// Changes the size of a block. A null pointer reserves a new block, as malloc does.
// Returns null when the reservation fails. The caller handles null.
extern(abi="compiler") export unsafe func Malloc::realloc(self *this, ptr *u8, size i32, align i32) ?*u8;

// Atomic operations. Code generation replaces the call. There is no body.
// order is 0 relaxed, 1 acquire, 2 release, 3 acq_rel, 4 seq_cst.
// T is an integer of 8, 16, 32, or 64 bits, a pointer, f32, f64, or bool.
// Another T is not supported yet.
// On a float, add and sub are floating operations. and, or, xor, and cmpxchg use the bits.
// A var order is type mismatch. An unknown order is type mismatch.
extern(abi="compiler") export func atomic_load[T type](p *T, order comptime i32) T;

extern(abi="compiler") export func atomic_store[T type](p *T, value T, order comptime i32) void;

// op is 0 xchg, 1 add, 2 sub, 3 and, 4 or, 5 xor. The result is the previous value.
extern(abi="compiler") export func atomic_rmw[T type](p *T, op comptime i32, value T, order comptime i32) T;

// Strong compare-exchange. The results are the previous value and whether the store happened.
// success is the order when the values match. failure is the order when they do not.
extern(abi="compiler") export func atomic_cmpxchg[T type](p *T, expected T, desired T, success comptime i32, failure comptime i32) (T, bool);

// A relaxed fence is no instruction. Another order is a fence.
// The name is not a value. `var f = fence` is not supported yet.
extern(abi="compiler") export func fence(order comptime i32) void;
