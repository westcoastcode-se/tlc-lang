package gl;

import { SDL_GL_GetProcAddress } from "vendor/sdl3";
import "builtin";

// OpenGL constants and the core-profile entry points both examples call.
// libGL does not export those entry points. `load` stores each address from
// SDL_GL_GetProcAddress in a function pointer. A missing entry point panics
// instead of being stored. A file-scope function pointer needs an initializer,
// so each one starts as a placeholder with the same signature. Shader source,
// program linking, and vertex layout stay in the program.

export extern(abi="c") type GLenum enum {
    TRIANGLES = 0x0004,
    COLOR_BUFFER_BIT = 0x00004000,
    FLOAT = 0x1406,
    ARRAY_BUFFER = 0x8892,
    DYNAMIC_DRAW = 0x88E8,
    FRAGMENT_SHADER = 0x8B30,
    VERTEX_SHADER = 0x8B31,
    COMPILE_STATUS = 0x8B81,
    LINK_STATUS = 0x8B82,
}

type FnViewport func (i32, i32, i32, i32) void;
type FnClearColor func (f32, f32, f32, f32) void;
type FnClear func (u32) void;
type FnGen func (i32, *u32) void;
type FnBindVertexArray func (u32) void;
type FnBindBuffer func (u32, u32) void;
type FnBufferData func (u32, i64, *void, u32) void;
type FnEnableAttrib func (u32) void;
type FnAttribPointer func (u32, i32, u32, u8, i32, *void) void;
type FnUseProgram func (u32) void;
type FnCreateShader func (u32) u32;
type FnShaderSource func (u32, i32, **const u8, ?*i32) void;
type FnObject func (u32) void;
type FnGetIv func (u32, u32, *i32) void;
type FnInfoLog func (u32, i32, ?*i32, *u8) void;
type FnCreateProgram func () u32;
type FnAttachShader func (u32, u32) void;
type FnDrawArrays func (u32, i32, i32) void;

func unloaded_viewport(x i32, y i32, width i32, height i32) void {}
func unloaded_clear_color(red f32, green f32, blue f32, alpha f32) void {}
func unloaded_u32(value u32) void {}
func unloaded_gen(count i32, arrays *u32) void {}
func unloaded_pair(a u32, b u32) void {}
func unloaded_buffer(target u32, size i64, data *void, usage u32) void {}
func unloaded_attrib(index u32, size i32, kind u32, normalized u8, stride i32, offset *void) void {}
func unloaded_shader(kind u32) u32 { return 0; }
func unloaded_source(shader u32, count i32, source **const u8, length ?*i32) void {}
func unloaded_iv(object u32, pname u32, params *i32) void {}
func unloaded_log(object u32, size i32, length ?*i32, log *u8) void {}
func unloaded_program() u32 { return 0; }
func unloaded_draw(mode u32, first i32, count i32) void {}

export var Viewport FnViewport = unloaded_viewport;
export var ClearColor FnClearColor = unloaded_clear_color;
export var Clear FnClear = unloaded_u32;
export var GenVertexArrays FnGen = unloaded_gen;
export var BindVertexArray FnBindVertexArray = unloaded_u32;
export var GenBuffers FnGen = unloaded_gen;
export var BindBuffer FnBindBuffer = unloaded_pair;
export var BufferData FnBufferData = unloaded_buffer;
export var EnableVertexAttribArray FnEnableAttrib = unloaded_u32;
export var VertexAttribPointer FnAttribPointer = unloaded_attrib;
export var UseProgram FnUseProgram = unloaded_u32;
export var CreateShader FnCreateShader = unloaded_shader;
export var ShaderSource FnShaderSource = unloaded_source;
export var CompileShader FnObject = unloaded_u32;
export var GetShaderiv FnGetIv = unloaded_iv;
export var GetShaderInfoLog FnInfoLog = unloaded_log;
export var CreateProgram FnCreateProgram = unloaded_program;
export var AttachShader FnAttachShader = unloaded_pair;
export var LinkProgram FnObject = unloaded_u32;
export var GetProgramiv FnGetIv = unloaded_iv;
export var GetProgramInfoLog FnInfoLog = unloaded_log;
export var DeleteShader FnObject = unloaded_u32;
export var DrawArrays FnDrawArrays = unloaded_draw;

func bind(name *const u8) ?*void {
    var raw = SDL_GL_GetProcAddress(name);
    if (raw == null) {
        builtin.panic(name);
    }
    return raw;
}

export func load() bool {
    Viewport = FnViewport(bind("glViewport"));
    ClearColor = FnClearColor(bind("glClearColor"));
    Clear = FnClear(bind("glClear"));
    GenVertexArrays = FnGen(bind("glGenVertexArrays"));
    BindVertexArray = FnBindVertexArray(bind("glBindVertexArray"));
    GenBuffers = FnGen(bind("glGenBuffers"));
    BindBuffer = FnBindBuffer(bind("glBindBuffer"));
    BufferData = FnBufferData(bind("glBufferData"));
    EnableVertexAttribArray = FnEnableAttrib(bind("glEnableVertexAttribArray"));
    VertexAttribPointer = FnAttribPointer(bind("glVertexAttribPointer"));
    UseProgram = FnUseProgram(bind("glUseProgram"));
    CreateShader = FnCreateShader(bind("glCreateShader"));
    ShaderSource = FnShaderSource(bind("glShaderSource"));
    CompileShader = FnObject(bind("glCompileShader"));
    GetShaderiv = FnGetIv(bind("glGetShaderiv"));
    GetShaderInfoLog = FnInfoLog(bind("glGetShaderInfoLog"));
    CreateProgram = FnCreateProgram(bind("glCreateProgram"));
    AttachShader = FnAttachShader(bind("glAttachShader"));
    LinkProgram = FnObject(bind("glLinkProgram"));
    GetProgramiv = FnGetIv(bind("glGetProgramiv"));
    GetProgramInfoLog = FnInfoLog(bind("glGetProgramInfoLog"));
    DeleteShader = FnObject(bind("glDeleteShader"));
    DrawArrays = FnDrawArrays(bind("glDrawArrays"));
    return 1;
}
