package testing;

import "builtin";

extern(abi="c") func printf(fmt *const u8, ...) i32;
extern(abi="c") func vprintf(fmt *const u8, ap *u8) i32;

export func error(fmt *const u8, ...) i32 {
    var stack = builtin.StackTrace.get();
    var i i32 = 0;
    while (i < stack.frames.len) {
        var frame = stack.frames[i];
        if (i + 1 == stack.frames.len) {
            printf("%s:%d:%d: %s: "b, *u8(frame.file), frame.line, frame.column, *u8(frame.name));
        } else {
            printf("%s:%d:%d: %s\n"b, *u8(frame.file), frame.line, frame.column, *u8(frame.name));
        }
        i = i + 1;
    }
    if (stack.frames.len == 0) {
        printf(": "b);
    }
    stack.free();
    vprintf(fmt, builtin.va());
    printf("\n"b);
    return 1;
}
