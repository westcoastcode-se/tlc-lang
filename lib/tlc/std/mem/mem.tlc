package mem;

// Element comparison. The compiler folds the comptime slice overload of two constant []const u8 values.
// A raw pointer is not an argument. p[0:n] is the slice.

// True when both slices are comptime values and hold the same elements.
// Chosen instead of the runtime overload when both arguments are comptime.
export func memeql[T type](lhs comptime []const T, rhs comptime []const T) bool {
    if (lhs.len != rhs.len) {
        return false;
    }
    var i i32 = 0;
    while (i < lhs.len) {
        if (lhs[i] != rhs[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// True when the slices have the same length and the same elements.
export func memeql[T type](lhs []const T, rhs []const T) bool {
    if (lhs.len != rhs.len) {
        return false;
    }
    var i i32 = 0;
    while (i < lhs.len) {
        if (lhs[i] != rhs[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Element order of two comptime slices. -1 when lhs is less, 1 when lhs is greater, 0 when they match.
// A shared prefix takes the shorter length as less.
// Chosen instead of the runtime overload when both arguments are comptime.
export func memcmp[T type](lhs comptime []const T, rhs comptime []const T) i32 {
    var n i32 = lhs.len;
    if (rhs.len < n) {
        n = rhs.len;
    }
    var i i32 = 0;
    while (i < n) {
        if (lhs[i] < rhs[i]) {
            return -1;
        }
        if (rhs[i] < lhs[i]) {
            return 1;
        }
        i = i + 1;
    }
    if (lhs.len < rhs.len) {
        return -1;
    }
    if (rhs.len < lhs.len) {
        return 1;
    }
    return 0;
}

// Element order of two slices. -1 when lhs is less, 1 when lhs is greater, 0 when they match.
// A shared prefix takes the shorter length as less.
export func memcmp[T type](lhs []const T, rhs []const T) i32 {
    var n i32 = lhs.len;
    if (rhs.len < n) {
        n = rhs.len;
    }
    var i i32 = 0;
    while (i < n) {
        if (lhs[i] < rhs[i]) {
            return -1;
        }
        if (rhs[i] < lhs[i]) {
            return 1;
        }
        i = i + 1;
    }
    if (lhs.len < rhs.len) {
        return -1;
    }
    if (rhs.len < lhs.len) {
        return 1;
    }
    return 0;
}
