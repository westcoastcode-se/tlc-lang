package atomic;

import "builtin";

// There is no consume. The values match the integer the builtin takes.
export type Order enum {
    relaxed = 0,
    acquire = 1,
    release = 2,
    acq_rel = 3,
    seq_cst = 4,
};

// The values match the integer the builtin takes.
export type Op enum {
    xchg = 0,
    add = 1,
    sub = 2,
    and = 3,
    or = 4,
    xor = 5,
};

// Each `comptime if` keeps one call. The builtin does not take this enum.
func load_at[T type](p *T, order comptime Order) T {
    comptime if (order == Order.relaxed) {
        return builtin.atomic_load[T](p, 0);
    }
    comptime if (order == Order.acquire) {
        return builtin.atomic_load[T](p, 1);
    }
    comptime if (order == Order.seq_cst) {
        return builtin.atomic_load[T](p, 4);
    }
    builtin.panic("type mismatch"b);
    return *p;
}

func store_at[T type](p *T, value T, order comptime Order) void {
    comptime if (order == Order.relaxed) {
        builtin.atomic_store[T](p, value, 0);
        return;
    }
    comptime if (order == Order.release) {
        builtin.atomic_store[T](p, value, 2);
        return;
    }
    comptime if (order == Order.seq_cst) {
        builtin.atomic_store[T](p, value, 4);
        return;
    }
    builtin.panic("type mismatch"b);
}

func xchg_at[T type](p *T, value T, order comptime Order) T {
    comptime if (order == Order.relaxed) {
        return builtin.atomic_rmw[T](p, 0, value, 0);
    }
    comptime if (order == Order.acquire) {
        return builtin.atomic_rmw[T](p, 0, value, 1);
    }
    comptime if (order == Order.release) {
        return builtin.atomic_rmw[T](p, 0, value, 2);
    }
    comptime if (order == Order.acq_rel) {
        return builtin.atomic_rmw[T](p, 0, value, 3);
    }
    comptime if (order == Order.seq_cst) {
        return builtin.atomic_rmw[T](p, 0, value, 4);
    }
    builtin.panic("type mismatch"b);
    return *p;
}

func rmw_at[T type](p *T, value T, op comptime Op, order comptime Order) T {
    comptime if (op == Op.xchg) {
        return xchg_at[T](p, value, order);
    }
    comptime if (op == Op.add) {
        comptime if (order == Order.relaxed) {
            return builtin.atomic_rmw[T](p, 1, value, 0);
        }
        comptime if (order == Order.acquire) {
            return builtin.atomic_rmw[T](p, 1, value, 1);
        }
        comptime if (order == Order.release) {
            return builtin.atomic_rmw[T](p, 1, value, 2);
        }
        comptime if (order == Order.acq_rel) {
            return builtin.atomic_rmw[T](p, 1, value, 3);
        }
        comptime if (order == Order.seq_cst) {
            return builtin.atomic_rmw[T](p, 1, value, 4);
        }
    }
    comptime if (op == Op.sub) {
        comptime if (order == Order.relaxed) {
            return builtin.atomic_rmw[T](p, 2, value, 0);
        }
        comptime if (order == Order.acquire) {
            return builtin.atomic_rmw[T](p, 2, value, 1);
        }
        comptime if (order == Order.release) {
            return builtin.atomic_rmw[T](p, 2, value, 2);
        }
        comptime if (order == Order.acq_rel) {
            return builtin.atomic_rmw[T](p, 2, value, 3);
        }
        comptime if (order == Order.seq_cst) {
            return builtin.atomic_rmw[T](p, 2, value, 4);
        }
    }
    comptime if (op == Op.and) {
        comptime if (order == Order.relaxed) {
            return builtin.atomic_rmw[T](p, 3, value, 0);
        }
        comptime if (order == Order.acquire) {
            return builtin.atomic_rmw[T](p, 3, value, 1);
        }
        comptime if (order == Order.release) {
            return builtin.atomic_rmw[T](p, 3, value, 2);
        }
        comptime if (order == Order.acq_rel) {
            return builtin.atomic_rmw[T](p, 3, value, 3);
        }
        comptime if (order == Order.seq_cst) {
            return builtin.atomic_rmw[T](p, 3, value, 4);
        }
    }
    comptime if (op == Op.or) {
        comptime if (order == Order.relaxed) {
            return builtin.atomic_rmw[T](p, 4, value, 0);
        }
        comptime if (order == Order.acquire) {
            return builtin.atomic_rmw[T](p, 4, value, 1);
        }
        comptime if (order == Order.release) {
            return builtin.atomic_rmw[T](p, 4, value, 2);
        }
        comptime if (order == Order.acq_rel) {
            return builtin.atomic_rmw[T](p, 4, value, 3);
        }
        comptime if (order == Order.seq_cst) {
            return builtin.atomic_rmw[T](p, 4, value, 4);
        }
    }
    comptime if (op == Op.xor) {
        comptime if (order == Order.relaxed) {
            return builtin.atomic_rmw[T](p, 5, value, 0);
        }
        comptime if (order == Order.acquire) {
            return builtin.atomic_rmw[T](p, 5, value, 1);
        }
        comptime if (order == Order.release) {
            return builtin.atomic_rmw[T](p, 5, value, 2);
        }
        comptime if (order == Order.acq_rel) {
            return builtin.atomic_rmw[T](p, 5, value, 3);
        }
        comptime if (order == Order.seq_cst) {
            return builtin.atomic_rmw[T](p, 5, value, 4);
        }
    }
    builtin.panic("type mismatch"b);
    return *p;
}

export type Int8 struct {
    value i8;
};

export func Int8::load(self *this) i8 {
    return builtin.atomic_load[i8](&self.value, 4);
}

export func Int8::load_order(self *this, order comptime Order) i8 {
    return load_at[i8](&self.value, order);
}

export func Int8::store(self *this, value i8) void {
    builtin.atomic_store[i8](&self.value, value, 4);
}

export func Int8::store_order(self *this, value i8, order comptime Order) void {
    store_at[i8](&self.value, value, order);
}

export func Int8::swap(self *this, value i8) i8 {
    return builtin.atomic_rmw[i8](&self.value, 0, value, 4);
}

export func Int8::swap_order(self *this, value i8, order comptime Order) i8 {
    return xchg_at[i8](&self.value, value, order);
}

export func Int8::add(self *this, value i8) i8 {
    return builtin.atomic_rmw[i8](&self.value, 1, value, 4);
}

export func Int8::add_order(self *this, value i8, order comptime Order) i8 {
    return rmw_at[i8](&self.value, value, Op.add, order);
}

export func Int8::sub(self *this, value i8) i8 {
    return builtin.atomic_rmw[i8](&self.value, 2, value, 4);
}

export func Int8::sub_order(self *this, value i8, order comptime Order) i8 {
    return rmw_at[i8](&self.value, value, Op.sub, order);
}

export func Int8::and(self *this, value i8) i8 {
    return builtin.atomic_rmw[i8](&self.value, 3, value, 4);
}

export func Int8::and_order(self *this, value i8, order comptime Order) i8 {
    return rmw_at[i8](&self.value, value, Op.and, order);
}

export func Int8::or(self *this, value i8) i8 {
    return builtin.atomic_rmw[i8](&self.value, 4, value, 4);
}

export func Int8::or_order(self *this, value i8, order comptime Order) i8 {
    return rmw_at[i8](&self.value, value, Op.or, order);
}

export func Int8::xor(self *this, value i8) i8 {
    return builtin.atomic_rmw[i8](&self.value, 5, value, 4);
}

export func Int8::xor_order(self *this, value i8, order comptime Order) i8 {
    return rmw_at[i8](&self.value, value, Op.xor, order);
}

export func Int8::cmpxchg(self *this, expected i8, desired i8) (i8, bool) {
    var prev, ok = builtin.atomic_cmpxchg[i8](&self.value, expected, desired, 4, 0);
    return prev, ok;
}

