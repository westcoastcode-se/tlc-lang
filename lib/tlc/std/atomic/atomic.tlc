export func Uint32::xor(self *this, value u32) u32 {
    return builtin.atomic_rmw[u32](&self.value, 5, value, 4);
}

export func Uint32::xor_order(self *this, value u32, order comptime Order) u32 {
    return rmw_at[u32](&self.value, value, Op.xor, order);
}

export func Uint32::cmpxchg(self *this, expected u32, desired u32) (u32, bool) {
    var prev, ok = builtin.atomic_cmpxchg[u32](&self.value, expected, desired, 4, 0);
    return prev, ok;
}

