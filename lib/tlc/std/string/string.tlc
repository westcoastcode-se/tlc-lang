package string;

// C bytes. The length does not include the terminating null.
export type byte_string_view []const u8;

export type byte_string struct {
    export bytes []u8;
}

export func byte_string::view(self this) byte_string_view {
    return self.bytes;
}

export func from(text []const u8) byte_string_view {
    return byte_string_view(text);
}

export func byte_string_view::equals(self this, other byte_string_view) bool {
    if (self.len() != other.len()) {
        return false;
    }
    var i i32 = 0;
    while (i < self.len()) {
        if (self[i] != other[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

export func byte_string_view::compare(self this, other byte_string_view) i32 {
    var n i32 = self.len();
    if (other.len() < n) {
        n = other.len();
    }
    var i i32 = 0;
    while (i < n) {
        if (self[i] < other[i]) {
            return -1;
        }
        if (other[i] < self[i]) {
            return 1;
        }
        i = i + 1;
    }
    if (self.len() < other.len()) {
        return -1;
    }
    if (other.len() < self.len()) {
        return 1;
    }
    return 0;
}

export func byte_string_view::find_first_of(self this, chars byte_string_view) i32 {
    var i i32 = 0;
    while (i < self.len()) {
        var j i32 = 0;
        while (j < chars.len()) {
            if (self[i] == chars[j]) {
                return i;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return -1;
}

export func byte_string_view::find(self this, needle byte_string_view) i32 {
    if (needle.len() == 0) {
        return 0;
    }
    if (self.len() < needle.len()) {
        return -1;
    }
    var last i32 = self.len() - needle.len();
    var i i32 = 0;
    while (i <= last) {
        if (self[i:i + needle.len()].equals(needle)) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

export func byte_string_view::starts_with(self this, prefix byte_string_view) bool {
    if (self.len() < prefix.len()) {
        return false;
    }
    return self[:prefix.len()].equals(prefix);
}

export func byte_string_view::ends_with(self this, suffix byte_string_view) bool {
    if (self.len() < suffix.len()) {
        return false;
    }
    var start i32 = self.len() - suffix.len();
    return self[start:].equals(suffix);
}
