package string;

export type string_view []const u8;

export func from(text []const u8) string_view {
    return string_view(text);
}

export func string_view::equals(self this, other string_view) bool {
    if (self.len != other.len) {
        return false;
    }
    var i i32 = 0;
    while (i < self.len) {
        if (self[i] != other[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

export func string_view::compare(self this, other string_view) i32 {
    var n i32 = self.len;
    if (other.len < n) {
        n = other.len;
    }
    var i i32 = 0;
    while (i < n) {
        if (self[i] < other[i]) {
            return -1;
        }
        if (other[i] < self[i]) {
            return 1;
        }
        i = i + 1;
    }
    if (self.len < other.len) {
        return -1;
    }
    if (other.len < self.len) {
        return 1;
    }
    return 0;
}

export func string_view::find_first_of(self this, chars string_view) i32 {
    var i i32 = 0;
    while (i < self.len) {
        var j i32 = 0;
        while (j < chars.len) {
            if (self[i] == chars[j]) {
                return i;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return -1;
}

export func string_view::find(self this, needle string_view) i32 {
    if (needle.len == 0) {
        return 0;
    }
    if (self.len < needle.len) {
        return -1;
    }
    var last i32 = self.len - needle.len;
    var i i32 = 0;
    while (i <= last) {
        if (self[i:i + needle.len].equals(needle)) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

export func string_view::starts_with(self this, prefix string_view) bool {
    if (self.len < prefix.len) {
        return false;
    }
    return self[0:prefix.len].equals(prefix);
}

export func string_view::ends_with(self this, suffix string_view) bool {
    if (self.len < suffix.len) {
        return false;
    }
    var start i32 = self.len - suffix.len;
    return self[start:self.len].equals(suffix);
}
