import {
    SDL_Init,
    SDL_Quit,
    SDL_GetError,
    SDL_CreateWindow,
    SDL_DestroyWindow,
    SDL_GL_SetAttribute,
    SDL_GL_CreateContext,
    SDL_GL_MakeCurrent,
    SDL_GL_SwapWindow,
    SDL_PollEvent,
    SDL_Delay,
    SDL_GetTicks,
    SDL_rand,
    SDL_Window,
    SDL_GLContextState,
    SDL_Event,
    SdlInit,
    SdlWindow,
    SdlEventKind,
    SdlGlAttr,
    SdlScancode,
} from "vendor/sdl3";

import {
    glViewport,
    glClearColor,
    glClear,
    glBegin,
    glEnd,
    glColor3f,
    glVertex2f,
    GL,
} from "vendor/gl";

extern(abi="c") func printf(fmt *const u8, ...) i32;

// 10 columns by 20 rows. A cell is 0 when empty, or 1..7 for a piece color.
var board [200]i32;
var shape_x [28]i32;
var shape_y [28]i32;
var kind i32;
var rot i32;
var px i32;
var py i32;
var next_kind i32;
var alive i32;
var lines i32;
var score i32;
var running i32;
var told i32;
var last u64;

func load_shapes() void {
    shape_x[0] = 0;
    shape_y[0] = 1;
    shape_x[1] = 1;
    shape_y[1] = 1;
    shape_x[2] = 2;
    shape_y[2] = 1;
    shape_x[3] = 3;
    shape_y[3] = 1;

    shape_x[4] = 1;
    shape_y[4] = 0;
    shape_x[5] = 2;
    shape_y[5] = 0;
    shape_x[6] = 1;
    shape_y[6] = 1;
    shape_x[7] = 2;
    shape_y[7] = 1;

    shape_x[8] = 1;
    shape_y[8] = 0;
    shape_x[9] = 0;
    shape_y[9] = 1;
    shape_x[10] = 1;
    shape_y[10] = 1;
    shape_x[11] = 2;
    shape_y[11] = 1;

    shape_x[12] = 1;
    shape_y[12] = 0;
    shape_x[13] = 2;
    shape_y[13] = 0;
    shape_x[14] = 0;
    shape_y[14] = 1;
    shape_x[15] = 1;
    shape_y[15] = 1;

    shape_x[16] = 0;
    shape_y[16] = 0;
    shape_x[17] = 1;
    shape_y[17] = 0;
    shape_x[18] = 1;
    shape_y[18] = 1;
    shape_x[19] = 2;
    shape_y[19] = 1;

    shape_x[20] = 0;
    shape_y[20] = 0;
    shape_x[21] = 0;
    shape_y[21] = 1;
    shape_x[22] = 1;
    shape_y[22] = 1;
    shape_x[23] = 2;
    shape_y[23] = 1;

    shape_x[24] = 2;
    shape_y[24] = 0;
    shape_x[25] = 0;
    shape_y[25] = 1;
    shape_x[26] = 1;
    shape_y[26] = 1;
    shape_x[27] = 2;
    shape_y[27] = 1;
}

func spin(x i32, y i32, turn i32) (i32, i32) {
    var i = 0;
    while (i < turn) {
        var nx = 3 - y;
        var ny = x;
        x = nx;
        y = ny;
        i = i + 1;
    }
    return x, y;
}

func cell_at(piece i32, index i32, ox i32, oy i32, turn i32) (i32, i32) {
    var x = shape_x[piece * 4 + index];
    var y = shape_y[piece * 4 + index];
    if (piece == 1) {
        return ox + x, oy + y;
    }
    sx, sy := spin(x, y, turn);
    return ox + sx, oy + sy;
}

func fits(piece i32, turn i32, ox i32, oy i32) i32 {
    var i = 0;
    while (i < 4) {
        x, y := cell_at(piece, i, ox, oy, turn);
        if (x < 0 || x >= 10 || y >= 20) {
            return 0;
        }
        if (y >= 0 && board[y * 10 + x] != 0) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

func wipe() void {
    var i = 0;
    while (i < 200) {
        board[i] = 0;
        i = i + 1;
    }
}

func clear_lines() i32 {
    var cleared = 0;
    var y = 19;
    while (y >= 0) {
        var full = 1;
        var x = 0;
        while (x < 10) {
            if (board[y * 10 + x] == 0) {
                full = 0;
            }
            x = x + 1;
        }
        if (full != 0) {
            var yy = y;
            while (yy > 0) {
                var xx = 0;
                while (xx < 10) {
                    board[yy * 10 + xx] = board[(yy - 1) * 10 + xx];
                    xx = xx + 1;
                }
                yy = yy - 1;
            }
            var zx = 0;
            while (zx < 10) {
                board[zx] = 0;
                zx = zx + 1;
            }
            cleared = cleared + 1;
        } else {
            y = y - 1;
        }
    }
    return cleared;
}

func pace() u64 {
    if (lines >= 28) {
        return 80u64;
    }
    return 500u64 - u64(lines) * 15u64;
}

func spawn() void {
    kind = next_kind;
    next_kind = SDL_rand(7);
    rot = 0;
    px = 3;
    py = 0;
    if (fits(kind, rot, px, py) == 0) {
        alive = 0;
        if (told == 0) {
            printf("game over  lines %d  score %d\n", lines, score);
            told = 1;
        }
        return;
    }
    alive = 1;
}

func settle() void {
    var i = 0;
    var buried = 0;
    while (i < 4) {
        x, y := cell_at(kind, i, px, py, rot);
        if (y < 0) {
            buried = 1;
        } else {
            board[y * 10 + x] = kind + 1;
        }
        i = i + 1;
    }
    if (buried != 0) {
        alive = 0;
        if (told == 0) {
            printf("game over  lines %d  score %d\n", lines, score);
            told = 1;
        }
        return;
    }
    var cleared = clear_lines();
    if (cleared != 0) {
        lines = lines + cleared;
        score = score + cleared * cleared * 100;
        printf("lines %d  score %d\n", lines, score);
    }
    spawn();
}

func restart() void {
    wipe();
    lines = 0;
    score = 0;
    told = 0;
    next_kind = SDL_rand(7);
    spawn();
    last = SDL_GetTicks();
}

func try_turn(dir i32) void {
    var turn = (rot + 4 + dir) % 4;
    if (fits(kind, turn, px, py) != 0) {
        rot = turn;
        return;
    }
    if (fits(kind, turn, px - 1, py) != 0) {
        px = px - 1;
        rot = turn;
        return;
    }
    if (fits(kind, turn, px + 1, py) != 0) {
        px = px + 1;
        rot = turn;
        return;
    }
    if (fits(kind, turn, px - 2, py) != 0) {
        px = px - 2;
        rot = turn;
        return;
    }
    if (fits(kind, turn, px + 2, py) != 0) {
        px = px + 2;
        rot = turn;
    }
}

func hard_drop() void {
    while (fits(kind, rot, px, py + 1) != 0) {
        py = py + 1;
        score = score + 2;
    }
    settle();
    last = SDL_GetTicks();
}

func on_key(code i32, again i32) void {
    if (code == SdlScancode.SDL_SCANCODE_ESCAPE) {
        running = 0;
        return;
    }
    if (alive == 0) {
        if (again == 0 && code == SdlScancode.SDL_SCANCODE_R) {
            restart();
        }
        return;
    }
    if (code == SdlScancode.SDL_SCANCODE_LEFT) {
        if (fits(kind, rot, px - 1, py) != 0) {
            px = px - 1;
        }
        return;
    }
    if (code == SdlScancode.SDL_SCANCODE_RIGHT) {
        if (fits(kind, rot, px + 1, py) != 0) {
            px = px + 1;
        }
        return;
    }
    if (code == SdlScancode.SDL_SCANCODE_DOWN) {
        if (fits(kind, rot, px, py + 1) != 0) {
            py = py + 1;
            score = score + 1;
            last = SDL_GetTicks();
        } else {
            settle();
            last = SDL_GetTicks();
        }
        return;
    }
    if (again != 0) {
        return;
    }
    if (code == SdlScancode.SDL_SCANCODE_UP) {
        try_turn(1);
        return;
    }
    if (code == SdlScancode.SDL_SCANCODE_Z) {
        try_turn(-1);
        return;
    }
    if (code == SdlScancode.SDL_SCANCODE_SPACE) {
        hard_drop();
    }
}

func ndc_x(pixel i32) f32 {
    return f32(pixel) / 480.0f * 2.0f - 1.0f;
}

func ndc_y(pixel i32) f32 {
    return 1.0f - f32(pixel) / 640.0f * 2.0f;
}

func rect(x i32, y i32, w i32, h i32) void {
    var left = ndc_x(x);
    var right = ndc_x(x + w);
    var top = ndc_y(y);
    var bottom = ndc_y(y + h);
    glBegin(GL.TRIANGLES);
    glVertex2f(left, top);
    glVertex2f(right, top);
    glVertex2f(left, bottom);
    glVertex2f(left, bottom);
    glVertex2f(right, top);
    glVertex2f(right, bottom);
    glEnd();
}

func set_color(id i32) void {
    if (id == 1) {
        glColor3f(0.35f, 0.90f, 0.95f);
        return;
    }
    if (id == 2) {
        glColor3f(0.95f, 0.84f, 0.25f);
        return;
    }
    if (id == 3) {
        glColor3f(0.72f, 0.38f, 0.90f);
        return;
    }
    if (id == 4) {
        glColor3f(0.40f, 0.86f, 0.42f);
        return;
    }
    if (id == 5) {
        glColor3f(0.92f, 0.32f, 0.34f);
        return;
    }
    if (id == 6) {
        glColor3f(0.32f, 0.48f, 0.95f);
        return;
    }
    if (id == 7) {
        glColor3f(0.96f, 0.58f, 0.22f);
        return;
    }
    glColor3f(0.45f, 0.48f, 0.55f);
}

func draw_block(col i32, row i32, color i32, ox i32, oy i32) void {
    set_color(color);
    rect(ox + col * 28, oy + row * 28, 26, 26);
}

func draw_piece(piece i32, turn i32, ox i32, oy i32, color i32, drop i32) void {
    var i = 0;
    while (i < 4) {
        x, y := cell_at(piece, i, ox, oy, turn);
        if (drop != 0 || y >= 0) {
            var color_id = color;
            if (drop != 0) {
                color_id = 0;
            }
            if (y >= 0) {
                draw_block(x, y, color_id, 48, 32);
            }
        }
        i = i + 1;
    }
}

func draw_next() void {
    glColor3f(0.12f, 0.13f, 0.16f);
    rect(360, 32, 4 * 28, 4 * 28);
    var i = 0;
    while (i < 4) {
        x, y := cell_at(next_kind, i, 0, 0, 0);
        draw_block(x, y, next_kind + 1, 360, 32);
        i = i + 1;
    }
}

func draw_lines() void {
    var shown = lines;
    if (shown > 20) {
        shown = 20;
    }
    var i = 0;
    while (i < shown) {
        glColor3f(0.90f, 0.90f, 0.85f);
        rect(16, 32 + (19 - i) * 28, 18, 18);
        i = i + 1;
    }
}

func ghost_y() i32 {
    var gy = py;
    while (fits(kind, rot, px, gy + 1) != 0) {
        gy = gy + 1;
    }
    return gy;
}

func draw() void {
    glClear(GL.COLOR_BUFFER_BIT);
    glColor3f(0.10f, 0.11f, 0.14f);
    rect(48, 32, 10 * 28, 20 * 28);
    var row = 0;
    while (row < 20) {
        var col = 0;
        while (col < 10) {
            var filled = board[row * 10 + col];
            if (filled != 0) {
                draw_block(col, row, filled, 48, 32);
            }
            col = col + 1;
        }
        row = row + 1;
    }
    if (alive != 0) {
        var gy = ghost_y();
        if (gy != py) {
            draw_piece(kind, rot, px, gy, 0, 1);
        }
        draw_piece(kind, rot, px, py, kind + 1, 0);
    }
    draw_next();
    draw_lines();
    if (alive == 0) {
        glColor3f(0.55f, 0.16f, 0.18f);
        rect(48, 32, 10 * 28, 8);
        rect(48, 32 + 20 * 28 - 8, 10 * 28, 8);
    }
}

func main() i32 {
    if (SDL_Init(SdlInit.SDL_INIT_VIDEO) == 0) {
        printf("SDL_Init failed: %s\n", SDL_GetError());
        return 1;
    }
    SDL_GL_SetAttribute(SdlGlAttr.SDL_GL_CONTEXT_MAJOR_VERSION, 2);
    SDL_GL_SetAttribute(SdlGlAttr.SDL_GL_CONTEXT_MINOR_VERSION, 1);
    SDL_GL_SetAttribute(SdlGlAttr.SDL_GL_CONTEXT_PROFILE_MASK, SdlGlAttr.SDL_GL_CONTEXT_PROFILE_COMPATIBILITY);

    var window *SDL_Window = SDL_CreateWindow("Tetris", 480, 640, SdlWindow.SDL_WINDOW_OPENGL);
    if (window == null) {
        printf("SDL_CreateWindow failed: %s\n", SDL_GetError());
        SDL_Quit();
        return 1;
    }
    var context *SDL_GLContextState = SDL_GL_CreateContext(window);
    if (context == null) {
        printf("SDL_GL_CreateContext failed: %s\n", SDL_GetError());
        SDL_DestroyWindow(window);
        SDL_Quit();
        return 1;
    }
    SDL_GL_MakeCurrent(window, context);
    glViewport(0, 0, 480, 640);
    glClearColor(0.05f, 0.06f, 0.08f, 1.0f);

    load_shapes();
    next_kind = SDL_rand(7);
    spawn();
    last = SDL_GetTicks();
    running = 1;
    printf("left right down move, up and z rotate, space drops, r restarts\n");

    while (running != 0) {
        var event SDL_Event;
        while (SDL_PollEvent(&event) != 0) {
            if (event.kind == SdlEventKind.SDL_EVENT_QUIT ||
                event.kind == SdlEventKind.SDL_EVENT_WINDOW_CLOSE_REQUESTED) {
                running = 0;
            }
            if (event.kind == SdlEventKind.SDL_EVENT_KEY_DOWN) {
                on_key(event.key.scancode, i32(event.key.repeat));
            }
        }
        if (alive != 0) {
            var now = SDL_GetTicks();
            if (now - last >= pace()) {
                if (fits(kind, rot, px, py + 1) != 0) {
                    py = py + 1;
                } else {
                    settle();
                }
                last = SDL_GetTicks();
            }
        }
        draw();
        SDL_GL_SwapWindow(window);
        SDL_Delay(16);
    }

    SDL_DestroyWindow(window);
    SDL_Quit();
    return 0;
}
