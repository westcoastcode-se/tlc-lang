import {
    SDL_Init,
    SDL_Quit,
    SDL_GetError,
    SDL_CreateWindow,
    SDL_DestroyWindow,
    SDL_GL_SetAttribute,
    SDL_GL_CreateContext,
    SDL_GL_MakeCurrent,
    SDL_GL_SwapWindow,
    SDL_PollEvent,
    SDL_Delay,
    SDL_GetTicks,
    SDL_rand,
    SDL_Event,
    SDL_Window,
    SdlInit,
    SdlWindow,
    SdlEventKind,
    SdlGlAttr,
    SdlScancode,
} from "vendor/sdl3"b;

import {
    GLenum,
    load,
    Viewport,
    ClearColor,
    Clear,
    GenVertexArrays,
    BindVertexArray,
    GenBuffers,
    BindBuffer,
    BufferData,
    EnableVertexAttribArray,
    VertexAttribPointer,
    UseProgram,
    CreateShader,
    ShaderSource,
    CompileShader,
    GetShaderiv,
    GetShaderInfoLog,
    CreateProgram,
    AttachShader,
    LinkProgram,
    GetProgramiv,
    GetProgramInfoLog,
    DeleteShader,
    DrawArrays,
} from "vendor/gl"b;

extern(abi="c") func printf(fmt *const u8, ...) i32;

comptime const window_w = 480;
comptime const window_h = 640;
comptime const columns = 10;
comptime const rows = 20;
comptime const cell = 28;
comptime const origin_x = 48;
comptime const origin_y = 32;
comptime const preview_x = 360;

type Spot struct {
    x i32;
    y i32;
}

type Cell enum {
    Empty,
    I,
    O,
    T,
    S,
    Z,
    J,
    L,
}

type Rgb struct {
    r f32;
    g f32;
    b f32;
}

type Vertex struct {
    x f32;
    y f32;
    r f32;
    g f32;
    b f32;
}

type Gpu struct {
    array u32;
    buffer u32;
}

// Seven pieces, four cells each. I is the first row and O is the second.
comptime const shapes = [_][4]Spot{
    {{.x = 0, .y = 1}, {.x = 1, .y = 1}, {.x = 2, .y = 1}, {.x = 3, .y = 1}},
    {{.x = 1, .y = 0}, {.x = 2, .y = 0}, {.x = 1, .y = 1}, {.x = 2, .y = 1}},
    {{.x = 1, .y = 0}, {.x = 0, .y = 1}, {.x = 1, .y = 1}, {.x = 2, .y = 1}},
    {{.x = 1, .y = 0}, {.x = 2, .y = 0}, {.x = 0, .y = 1}, {.x = 1, .y = 1}},
    {{.x = 0, .y = 0}, {.x = 1, .y = 0}, {.x = 1, .y = 1}, {.x = 2, .y = 1}},
    {{.x = 0, .y = 0}, {.x = 0, .y = 1}, {.x = 1, .y = 1}, {.x = 2, .y = 1}},
    {{.x = 2, .y = 0}, {.x = 0, .y = 1}, {.x = 1, .y = 1}, {.x = 2, .y = 1}},
};

func Spot::turn(self this, times i32) Spot {
    var x = self.x;
    var y = self.y;
    for (var i = 0; i < times; i = i + 1) {
        nx := 3 - y;
        ny := x;
        x = nx;
        y = ny;
    }
    return Spot{.x = x, .y = y};
}

func Cell::shape(self this) [4]Spot {
    var slot = 0;
    switch (self) {
    case Cell.I:
        slot = 0;
        break;
    case Cell.O:
        slot = 1;
        break;
    case Cell.T:
        slot = 2;
        break;
    case Cell.S:
        slot = 3;
        break;
    case Cell.Z:
        slot = 4;
        break;
    case Cell.J:
        slot = 5;
        break;
    case Cell.L:
        slot = 6;
        break;
    default:
        slot = 0;
        break;
    }
    // The table is const. The copy is the array this function returns.
    var copy = shapes[slot];
    return copy;
}

func Cell::roll(n i32) Cell {
    switch (n) {
    case 0:
        return Cell.I;
    case 1:
        return Cell.O;
    case 2:
        return Cell.T;
    case 3:
        return Cell.S;
    case 4:
        return Cell.Z;
    case 5:
        return Cell.J;
    default:
        return Cell.L;
    }
}

func Cell::rgb(self this) Rgb {
    switch (self) {
    case Cell.I:
        return Rgb{.r = 0.35f, .g = 0.90f, .b = 0.95f};
    case Cell.O:
        return Rgb{.r = 0.95f, .g = 0.84f, .b = 0.25f};
    case Cell.T:
        return Rgb{.r = 0.72f, .g = 0.38f, .b = 0.90f};
    case Cell.S:
        return Rgb{.r = 0.40f, .g = 0.86f, .b = 0.42f};
    case Cell.Z:
        return Rgb{.r = 0.92f, .g = 0.32f, .b = 0.34f};
    case Cell.J:
        return Rgb{.r = 0.32f, .g = 0.48f, .b = 0.95f};
    case Cell.L:
        return Rgb{.r = 0.96f, .g = 0.58f, .b = 0.22f};
    default:
        return Rgb{.r = 0.45f, .g = 0.48f, .b = 0.55f};
    }
}

type Game struct {
    gpu Gpu;
    board [20][10]Cell;
    kind Cell;
    rot i32;
    px i32;
    py i32;
    next Cell;
    alive bool;
    lines i32;
    score i32;
    running bool;
    told bool;
    last u64;
}

func Game::place(piece Cell, spot Spot, ox i32, oy i32, turn i32) (i32, i32) {
    // The square is already in its box. Rotating it would walk around that box.
    if (piece == Cell.O) {
        return ox + spot.x, oy + spot.y;
    }
    var turned = spot.turn(turn);
    return ox + turned.x, oy + turned.y;
}

func Game::fits(self *this, piece Cell, turn i32, ox i32, oy i32) bool {
    var shape = piece.shape();
    for (var spot : shape) {
        x, y := Game.place(piece, spot, ox, oy, turn);
        if (x < 0 || x >= columns || y >= rows) {
            return false;
        }
        if (y >= 0 && self.board[y][x] != Cell.Empty) {
            return false;
        }
    }
    return true;
}

func Game::wipe(self *this) void {
    for (var y = 0; y < rows; y = y + 1) {
        for (var x = 0; x < columns; x = x + 1) {
            self.board[y][x] = Cell.Empty;
        }
    }
}

func Game::clear_lines(self *this) i32 {
    var cleared = 0;
    var y = rows - 1;
    while (y >= 0) {
        var full = true;
        for (var x = 0; x < columns; x = x + 1) {
            if (self.board[y][x] == Cell.Empty) {
                full = false;
            }
        }
        if (full) {
            for (var yy = y; yy > 0; yy = yy - 1) {
                for (var xx = 0; xx < columns; xx = xx + 1) {
                    self.board[yy][xx] = self.board[yy - 1][xx];
                }
            }
            for (var zx = 0; zx < columns; zx = zx + 1) {
                self.board[0][zx] = Cell.Empty;
            }
            cleared = cleared + 1;
        } else {
            y = y - 1;
        }
    }
    return cleared;
}

func Game::pace(self this) u64 {
    if (self.lines >= 28) {
        return 80u64;
    }
    return 500u64 - u64(self.lines) * 15u64;
}

func Game::spawn(self *this) void {
    self.kind = self.next;
    self.next = Cell.roll(SDL_rand(7));
    self.rot = 0;
    self.px = 3;
    self.py = 0;
    if (!self.fits(self.kind, self.rot, self.px, self.py)) {
        self.alive = false;
        if (!self.told) {
            printf("game over  lines %d  score %d\n"b, self.lines, self.score);
            self.told = true;
        }
        return;
    }
    self.alive = true;
}

func Game::settle(self *this) void {
    var buried = false;
    var kind Cell = self.kind;
    var shape = kind.shape();
    for (var spot : shape) {
        x, y := Game.place(kind, spot, self.px, self.py, self.rot);
        if (y < 0) {
            buried = true;
        } else {
            self.board[y][x] = kind;
        }
    }
    if (buried) {
        self.alive = false;
        if (!self.told) {
            printf("game over  lines %d  score %d\n"b, self.lines, self.score);
            self.told = true;
        }
        return;
    }
    var cleared = self.clear_lines();
    if (cleared != 0) {
        self.lines = self.lines + cleared;
        self.score = self.score + cleared * cleared * 100;
        printf("lines %d  score %d\n"b, self.lines, self.score);
    }
    self.spawn();
}

func Game::restart(self *this) void {
    self.wipe();
    self.lines = 0;
    self.score = 0;
    self.told = false;
    self.next = Cell.roll(SDL_rand(7));
    self.spawn();
    self.last = SDL_GetTicks();
}

func Game::try_turn(self *this, dir i32) void {
    var turn = (self.rot + 4 + dir) % 4;
    const kicks = [_]i32{0, -1, 1, -2, 2};
    for (var dx : kicks) {
        if (self.fits(self.kind, turn, self.px + dx, self.py)) {
            self.px = self.px + dx;
            self.rot = turn;
            return;
        }
    }
}

func Game::hard_drop(self *this) void {
    while (self.fits(self.kind, self.rot, self.px, self.py + 1)) {
        self.py = self.py + 1;
        self.score = self.score + 2;
    }
    self.settle();
    self.last = SDL_GetTicks();
}

func Game::on_key(self *this, code i32, again bool) void {
    if (code == SdlScancode.SDL_SCANCODE_ESCAPE) {
        self.running = false;
        return;
    }
    if (!self.alive) {
        if (!again && code == SdlScancode.SDL_SCANCODE_R) {
            self.restart();
        }
        return;
    }
    if (code == SdlScancode.SDL_SCANCODE_LEFT) {
        if (self.fits(self.kind, self.rot, self.px - 1, self.py)) {
            self.px = self.px - 1;
        }
        return;
    }
    if (code == SdlScancode.SDL_SCANCODE_RIGHT) {
        if (self.fits(self.kind, self.rot, self.px + 1, self.py)) {
            self.px = self.px + 1;
        }
        return;
    }
    if (code == SdlScancode.SDL_SCANCODE_DOWN) {
        if (self.fits(self.kind, self.rot, self.px, self.py + 1)) {
            self.py = self.py + 1;
            self.score = self.score + 1;
            self.last = SDL_GetTicks();
        } else {
            self.settle();
            self.last = SDL_GetTicks();
        }
        return;
    }
    if (again) {
        return;
    }
    if (code == SdlScancode.SDL_SCANCODE_UP) {
        self.try_turn(1);
        return;
    }
    if (code == SdlScancode.SDL_SCANCODE_Z) {
        self.try_turn(-1);
        return;
    }
    if (code == SdlScancode.SDL_SCANCODE_SPACE) {
        self.hard_drop();
    }
}

func Gpu::status(object u32, pname u32, linked bool) bool {
    var ok i32 = 0;
    if (linked) {
        GetProgramiv(object, pname, &ok);
    } else {
        GetShaderiv(object, pname, &ok);
    }
    if (ok == 0) {
        var log [512]u8;
        if (linked) {
            GetProgramInfoLog(object, 512, null, log);
        } else {
            GetShaderInfoLog(object, 512, null, log);
        }
        printf("%s\n"b, *u8(log));
        return false;
    }
    return true;
}

func Gpu::make_shader(kind u32, source *const u8) u32 {
    var shader = CreateShader(kind);
    ShaderSource(shader, 1, &source, null);
    CompileShader(shader);
    if (!Gpu.status(shader, GLenum.COMPILE_STATUS, false)) {
        return 0;
    }
    return shader;
}

func Gpu::load(self *this) bool {
    if (!load()) {
        return false;
    }

    var vertex_source *const u8 = `#version 330 core
layout(location = 0) in vec2 pos;
layout(location = 1) in vec3 color;
out vec3 v_color;
void main() {
    gl_Position = vec4(pos, 0.0, 1.0);
    v_color = color;
}
`b;
    var fragment_source *const u8 = `#version 330 core
in vec3 v_color;
out vec4 frag;
void main() {
    frag = vec4(v_color, 1.0);
}
`b;
    var vertex = Gpu.make_shader(GLenum.VERTEX_SHADER, vertex_source);
    var fragment = Gpu.make_shader(GLenum.FRAGMENT_SHADER, fragment_source);
    if (vertex == 0 || fragment == 0) {
        return false;
    }
    var program = CreateProgram();
    AttachShader(program, vertex);
    AttachShader(program, fragment);
    LinkProgram(program);
    if (!Gpu.status(program, GLenum.LINK_STATUS, true)) {
        return false;
    }
    DeleteShader(vertex);
    DeleteShader(fragment);

    GenVertexArrays(1, &self.array);
    BindVertexArray(self.array);
    GenBuffers(1, &self.buffer);
    BindBuffer(GLenum.ARRAY_BUFFER, self.buffer);
    EnableVertexAttribArray(0);
    VertexAttribPointer(0, 2, GLenum.FLOAT, 0, sizeof(Vertex), *void(0));
    EnableVertexAttribArray(1);
    VertexAttribPointer(1, 3, GLenum.FLOAT, 0, sizeof(Vertex), *void(sizeof(f32) * 2));
    UseProgram(program);
    return true;
}

func Gpu::mesh(verts *Vertex, count i32) void {
    BufferData(GLenum.ARRAY_BUFFER, i64(count * sizeof(Vertex)), *void(verts), GLenum.DYNAMIC_DRAW);
    DrawArrays(GLenum.TRIANGLES, 0, count);
}

func ndc_x(pixel i32) f32 {
    return f32(pixel) / f32(window_w) * 2.0f - 1.0f;
}

func ndc_y(pixel i32) f32 {
    return 1.0f - f32(pixel) / f32(window_h) * 2.0f;
}

func Game::quad(x0 f32, y0 f32, x1 f32, y1 f32, color Rgb) void {
    var verts = [_]Vertex{
        Vertex{.x = x0, .y = y0, .r = color.r, .g = color.g, .b = color.b},
        Vertex{.x = x1, .y = y0, .r = color.r, .g = color.g, .b = color.b},
        Vertex{.x = x0, .y = y1, .r = color.r, .g = color.g, .b = color.b},
        Vertex{.x = x0, .y = y1, .r = color.r, .g = color.g, .b = color.b},
        Vertex{.x = x1, .y = y0, .r = color.r, .g = color.g, .b = color.b},
        Vertex{.x = x1, .y = y1, .r = color.r, .g = color.g, .b = color.b},
    };
    Gpu.mesh(verts, verts.len);
}

func Game::rect(x i32, y i32, w i32, h i32, color Rgb) void {
    Game.quad(ndc_x(x), ndc_y(y), ndc_x(x + w), ndc_y(y + h), color);
}

func Game::block(col i32, row i32, color Rgb, ox i32, oy i32) void {
    Game.rect(ox + col * cell, oy + row * cell, cell - 2, cell - 2, color);
}

func Game::draw_piece(self *this, piece Cell, turn i32, ox i32, oy i32, color Rgb) void {
    var shape = piece.shape();
    for (var spot : shape) {
        x, y := Game.place(piece, spot, ox, oy, turn);
        if (y >= 0) {
            Game.block(x, y, color, origin_x, origin_y);
        }
    }
}

func Game::draw_next(self *this) void {
    var well = Rgb{.r = 0.12f, .g = 0.13f, .b = 0.16f};
    Game.rect(preview_x, origin_y, 4 * cell, 4 * cell, well);
    var upcoming Cell = self.next;
    var shape = upcoming.shape();
    var color = upcoming.rgb();
    for (var spot : shape) {
        x, y := Game.place(upcoming, spot, 0, 0, 0);
        Game.block(x, y, color, preview_x, origin_y);
    }
}

func Game::draw_lines(self *this) void {
    var shown = self.lines;
    if (shown > rows) {
        shown = rows;
    }
    var mark = Rgb{.r = 0.90f, .g = 0.90f, .b = 0.85f};
    for (var i = 0; i < shown; i = i + 1) {
        Game.rect(16, origin_y + (rows - 1 - i) * cell, 18, 18, mark);
    }
}

func Game::ghost_y(self *this) i32 {
    var gy = self.py;
    while (self.fits(self.kind, self.rot, self.px, gy + 1)) {
        gy = gy + 1;
    }
    return gy;
}

func Game::draw(self *this) void {
    Clear(GLenum.COLOR_BUFFER_BIT);
    var well = Rgb{.r = 0.10f, .g = 0.11f, .b = 0.14f};
    Game.rect(origin_x, origin_y, columns * cell, rows * cell, well);
    for (var row = 0; row < rows; row = row + 1) {
        for (var col = 0; col < columns; col = col + 1) {
            var filled Cell = self.board[row][col];
            if (filled != Cell.Empty) {
                var color Rgb = filled.rgb();
                Game.block(col, row, color, origin_x, origin_y);
            }
        }
    }
    if (self.alive) {
        var gy = self.ghost_y();
        var kind Cell = self.kind;
        var paint = kind.rgb();
        var ghost = Cell.Empty;
        var gray = ghost.rgb();
        if (gy != self.py) {
            self.draw_piece(kind, self.rot, self.px, gy, gray);
        }
        self.draw_piece(kind, self.rot, self.px, self.py, paint);
    }
    self.draw_next();
    self.draw_lines();
    if (!self.alive) {
        var edge = Rgb{.r = 0.55f, .g = 0.16f, .b = 0.18f};
        Game.rect(origin_x, origin_y, columns * cell, 8, edge);
        Game.rect(origin_x, origin_y + rows * cell - 8, columns * cell, 8, edge);
    }
}

func Game::begin(self *this) void {
    self.wipe();
    self.lines = 0;
    self.score = 0;
    self.told = false;
    self.running = true;
    self.next = Cell.roll(SDL_rand(7));
    self.spawn();
    self.last = SDL_GetTicks();
}

func Game::frame(self *this, window *SDL_Window) void {
    var event = SDL_Event{};
    while (SDL_PollEvent(&event)) {
        if (event.kind == SdlEventKind.SDL_EVENT_QUIT ||
            event.kind == SdlEventKind.SDL_EVENT_WINDOW_CLOSE_REQUESTED) {
            self.running = false;
        }
        if (event.kind == SdlEventKind.SDL_EVENT_KEY_DOWN) {
            self.on_key(event.key.scancode, event.key.repeat);
        }
    }
    if (self.alive) {
        var now = SDL_GetTicks();
        if (now - self.last >= self.pace()) {
            if (self.fits(self.kind, self.rot, self.px, self.py + 1)) {
                self.py = self.py + 1;
            } else {
                self.settle();
            }
            self.last = SDL_GetTicks();
        }
    }
    self.draw();
    SDL_GL_SwapWindow(window);
    SDL_Delay(16);
}

func main() i32 {
    if (!SDL_Init(SdlInit.SDL_INIT_VIDEO)) {
        printf("SDL_Init failed: %s\n"b, SDL_GetError());
        return 1;
    }
    defer SDL_Quit();

    SDL_GL_SetAttribute(SdlGlAttr.SDL_GL_CONTEXT_MAJOR_VERSION, 3);
    SDL_GL_SetAttribute(SdlGlAttr.SDL_GL_CONTEXT_MINOR_VERSION, 3);
    SDL_GL_SetAttribute(SdlGlAttr.SDL_GL_CONTEXT_PROFILE_MASK, SdlGlAttr.SDL_GL_CONTEXT_PROFILE_CORE);

    var window = SDL_CreateWindow("Tetris"b, window_w, window_h, SdlWindow.SDL_WINDOW_OPENGL);
    if (window == null) {
        printf("SDL_CreateWindow failed: %s\n"b, SDL_GetError());
        return 1;
    }
    defer SDL_DestroyWindow(window);

    var context = SDL_GL_CreateContext(window);
    if (context == null) {
        printf("SDL_GL_CreateContext failed: %s\n"b, SDL_GetError());
        return 1;
    }
    SDL_GL_MakeCurrent(window, context);
    var game Game;
    if (!game.gpu.load()) {
        printf("OpenGL failed\n"b);
        return 1;
    }
    Viewport(0, 0, window_w, window_h);
    ClearColor(0.05f, 0.06f, 0.08f, 1.0f);
    game.begin();
    printf("left right down move, up and z rotate, space drops, r restarts\n"b);

    while (game.running) {
        game.frame(window);
    }
    return 0;
}
