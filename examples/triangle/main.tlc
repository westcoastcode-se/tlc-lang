import {
    SDL_Init,
    SDL_Quit,
    SDL_GetError,
    SDL_CreateWindow,
    SDL_DestroyWindow,
    SDL_GL_SetAttribute,
    SDL_GL_CreateContext,
    SDL_GL_MakeCurrent,
    SDL_GL_SwapWindow,
    SDL_PollEvent,
    SDL_Delay,
    SDL_Window,
    SDL_GLContextState,
    SDL_Event,
    SdlInit,
    SdlWindow,
    SdlEventKind,
    SdlGlAttr,
} from "vendor/sdl3";

import {
    glViewport,
    glClearColor,
    glClear,
    glBegin,
    glEnd,
    glColor3f,
    glVertex2f,
    Gl,
} from "vendor/gl";

extern(abi="c") func printf(fmt *const char, ...) int;

func draw_triangle() void {
    glClear(Gl.GL_COLOR_BUFFER_BIT);
    glBegin(Gl.GL_TRIANGLES);
    glColor3f(0.95f, 0.35f, 0.30f);
    glVertex2f(-0.6f, -0.5f);
    glColor3f(0.30f, 0.85f, 0.45f);
    glVertex2f(0.6f, -0.5f);
    glColor3f(0.30f, 0.55f, 0.95f);
    glVertex2f(0.0f, 0.6f);
    glEnd();
}

func main() int {
    if (SDL_Init(SdlInit.SDL_INIT_VIDEO) == 0) {
        printf("SDL_Init failed: %s\n", SDL_GetError());
        return 1;
    }
    // Compatibility profile so glBegin is a real libGL entry point.
    SDL_GL_SetAttribute(SdlGlAttr.SDL_GL_CONTEXT_MAJOR_VERSION, 2);
    SDL_GL_SetAttribute(SdlGlAttr.SDL_GL_CONTEXT_MINOR_VERSION, 1);
    SDL_GL_SetAttribute(SdlGlAttr.SDL_GL_CONTEXT_PROFILE_MASK, SdlGlAttr.SDL_GL_CONTEXT_PROFILE_COMPATIBILITY);

    var window *SDL_Window = SDL_CreateWindow("Triangle", 960, 540, SdlWindow.SDL_WINDOW_OPENGL);
    if (window == null) {
        printf("SDL_CreateWindow failed: %s\n", SDL_GetError());
        SDL_Quit();
        return 1;
    }
    var context *SDL_GLContextState = SDL_GL_CreateContext(window);
    if (context == null) {
        printf("SDL_GL_CreateContext failed: %s\n", SDL_GetError());
        SDL_DestroyWindow(window);
        SDL_Quit();
        return 1;
    }
    SDL_GL_MakeCurrent(window, context);
    glViewport(0, 0, 960, 540);
    glClearColor(0.08f, 0.09f, 0.12f, 1.0f);

    var running int = 1;
    while (running != 0) {
        var event SDL_Event;
        while (SDL_PollEvent(&event) != 0) {
            if (event.kind == SdlEventKind.SDL_EVENT_QUIT ||
                event.kind == SdlEventKind.SDL_EVENT_WINDOW_CLOSE_REQUESTED) {
                running = 0;
            }
        }
        draw_triangle();
        SDL_GL_SwapWindow(window);
        SDL_Delay(16);
    }

    SDL_DestroyWindow(window);
    SDL_Quit();
    return 0;
}
