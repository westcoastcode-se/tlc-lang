import {
    SDL_Init,
    SDL_Quit,
    SDL_GetError,
    SDL_CreateWindow,
    SDL_DestroyWindow,
    SDL_GL_SetAttribute,
    SDL_GL_CreateContext,
    SDL_GL_MakeCurrent,
    SDL_GL_SwapWindow,
    SDL_PollEvent,
    SDL_Delay,
    SDL_Event,
    SdlInit,
    SdlWindow,
    SdlEventKind,
    SdlGlAttr,
} from "vendor/sdl3"b;

import {
    GLenum,
    load,
    Viewport,
    ClearColor,
    Clear,
    GenVertexArrays,
    BindVertexArray,
    GenBuffers,
    BindBuffer,
    BufferData,
    EnableVertexAttribArray,
    VertexAttribPointer,
    UseProgram,
    CreateShader,
    ShaderSource,
    CompileShader,
    GetShaderiv,
    GetShaderInfoLog,
    CreateProgram,
    AttachShader,
    LinkProgram,
    GetProgramiv,
    GetProgramInfoLog,
    DeleteShader,
    DrawArrays,
} from "vendor/gl"b;

extern(abi="c") func printf(fmt *const u8, ...) i32;

comptime const width = 960;
comptime const height = 540;

// One vertex is position, then color. The five floats are the attribute stride.
type Vertex struct {
    x f32;
    y f32;
    r f32;
    g f32;
    b f32;
}

type Gpu struct {
    array u32;
    buffer u32;
}

func Gpu::status(object u32, pname u32, linked bool) bool {
    var ok i32 = 0;
    if (linked) {
        GetProgramiv(object, pname, &ok);
    } else {
        GetShaderiv(object, pname, &ok);
    }
    if (ok == 0) {
        var log [512]u8;
        if (linked) {
            GetProgramInfoLog(object, 512, null, log);
        } else {
            GetShaderInfoLog(object, 512, null, log);
        }
        printf("%s\n"b, *u8(log));
        return false;
    }
    return true;
}

func Gpu::make_shader(kind u32, source *const u8) u32 {
    const shader = CreateShader(kind);
    ShaderSource(shader, 1, &source, null);
    CompileShader(shader);
    if (!Gpu.status(shader, GLenum.COMPILE_STATUS, false)) {
        return 0;
    }
    return shader;
}

func Gpu::load(self *this) bool {
    if (!load()) {
        return false;
    }

    // ShaderSource wants a pointer to a C string. A string literal is []const u8
    // and converts to *const u8, which is the pointer that address is taken of.
    var vertex_source *const u8 = `#version 330 core
layout(location = 0) in vec2 pos;
layout(location = 1) in vec3 color;
out vec3 v_color;
void main() {
    gl_Position = vec4(pos, 0.0, 1.0);
    v_color = color;
}
`b;
    var fragment_source *const u8 = `#version 330 core
in vec3 v_color;
out vec4 frag;
void main() {
    frag = vec4(v_color, 1.0);
}
`b;
    const vertex = Gpu.make_shader(GLenum.VERTEX_SHADER, vertex_source);
    const fragment = Gpu.make_shader(GLenum.FRAGMENT_SHADER, fragment_source);
    if (vertex == 0 || fragment == 0) {
        return false;
    }
    const program = CreateProgram();
    AttachShader(program, vertex);
    AttachShader(program, fragment);
    LinkProgram(program);
    if (!Gpu.status(program, GLenum.LINK_STATUS, true)) {
        return false;
    }
    DeleteShader(vertex);
    DeleteShader(fragment);

    GenVertexArrays(1, &self.array);
    BindVertexArray(self.array);
    GenBuffers(1, &self.buffer);
    BindBuffer(GLenum.ARRAY_BUFFER, self.buffer);
    EnableVertexAttribArray(0);
    VertexAttribPointer(0, 2, GLenum.FLOAT, 0, sizeof(Vertex), *void(0));
    EnableVertexAttribArray(1);
    VertexAttribPointer(1, 3, GLenum.FLOAT, 0, sizeof(Vertex), *void(sizeof(f32) * 2));
    UseProgram(program);
    return true;
}

func Gpu::draw(self *this, verts *Vertex, count i32) void {
    BufferData(GLenum.ARRAY_BUFFER, i64(count * sizeof(Vertex)), *void(verts), GLenum.DYNAMIC_DRAW);
    DrawArrays(GLenum.TRIANGLES, 0, count);
}

func Gpu::triangle(self *this) void {
    Clear(GLenum.COLOR_BUFFER_BIT);
    var verts = [_]Vertex{
        Vertex{.x = -0.6f, .y = -0.5f, .r = 0.95f, .g = 0.35f, .b = 0.30f},
        Vertex{.x = 0.6f, .y = -0.5f, .r = 0.30f, .g = 0.85f, .b = 0.45f},
        Vertex{.x = 0.0f, .y = 0.6f, .r = 0.30f, .g = 0.55f, .b = 0.95f},
    };
    self.draw(verts, verts.len);
}

func main() i32 {
    if (!SDL_Init(SdlInit.SDL_INIT_VIDEO)) {
        printf("SDL_Init failed: %s\n"b, SDL_GetError());
        return 1;
    }
    defer SDL_Quit();

    SDL_GL_SetAttribute(SdlGlAttr.SDL_GL_CONTEXT_MAJOR_VERSION, 3);
    SDL_GL_SetAttribute(SdlGlAttr.SDL_GL_CONTEXT_MINOR_VERSION, 3);
    SDL_GL_SetAttribute(SdlGlAttr.SDL_GL_CONTEXT_PROFILE_MASK, SdlGlAttr.SDL_GL_CONTEXT_PROFILE_CORE);

    const window = SDL_CreateWindow("Triangle"b, width, height, SdlWindow.SDL_WINDOW_OPENGL);
    if (window == null) {
        printf("SDL_CreateWindow failed: %s\n"b, SDL_GetError());
        return 1;
    }
    defer SDL_DestroyWindow(window);

    const context = SDL_GL_CreateContext(window);
    if (context == null) {
        printf("SDL_GL_CreateContext failed: %s\n"b, SDL_GetError());
        return 1;
    }
    SDL_GL_MakeCurrent(window, context);
    var gpu Gpu;
    if (!gpu.load()) {
        printf("OpenGL failed\n"b);
        return 1;
    }
    Viewport(0, 0, width, height);
    ClearColor(0.08f, 0.09f, 0.12f, 1.0f);

    var running = true;
    while (running) {
        var event = SDL_Event{};
        while (SDL_PollEvent(&event)) {
            if (event.kind == SdlEventKind.SDL_EVENT_QUIT ||
                event.kind == SdlEventKind.SDL_EVENT_WINDOW_CLOSE_REQUESTED) {
                running = false;
            }
        }
        gpu.triangle();
        SDL_GL_SwapWindow(window);
        SDL_Delay(16);
    }
    return 0;
}
