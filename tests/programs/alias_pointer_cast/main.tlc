// A pointer alias is a different type from the pointer. A cast converts either way. A function alias
// is that function type.
type Point struct {
    x i32;
}

type Ptr *Point;
type Maybe ?*Point;
type BinOp func (i32, i32) i32;

func add(a i32, b i32) i32 {
    return a + b;
}

func read(p Ptr) i32 {
    return p.x;
}

func raw(p *Point) i32 {
    return p.x;
}

func take(f func (i32, i32) i32) i32 {
    return f(40, 2);
}

func main() i32 {
    var p Point;
    p.x = 21;
    var q Ptr = Ptr(&p);
    var back *Point = *Point(q);
    var none Maybe = null;
    var some = Maybe(&p);
    if (none != null || some == null) {
        return 1;
    }
    var op BinOp = add;
    return read(q) + raw(back) + take(op) - 42;
}
