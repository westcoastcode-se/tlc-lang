// A float stored into an integer field, element, or global drops the fraction, as `i32(2.5)` does.
// A `bool` field is true for any value but 0. The `double` was stored as eight bytes into a four-byte slot.
type Point struct {
    x i32;
    y u8;
    z bool;
};
var g Point = {.x = 1, .y = 2, .z = false};
func ret() i32 { return 7; }
func arg(v i32) i32 { return v; }
func main() i32 {
    var row [3]i32 = {1.5, 2.5, 3.9};
    var p Point = {.x = 4.5, .y = 200.7, .z = 0.5};
    p.x = 9.9;
    g.y = 3.3;
    row[1] = 5.5;
    var q *Point = &p;
    q.x += 1;
    var r = 0;
    if (row[0] != 1 || row[1] != 5 || row[2] != 3) { r += 1; }
    if (p.x != 10 || p.y != 200 || !p.z) { r += 2; }
    if (g.y != 3 || ret() != 7 || arg(6.6) != 6) { r += 4; }
    return r == 0 ? 42 : r;
}
