func id[T type](value T) T {
    return value;
}

func id[T type](value T, extra i32) T {
    return value + extra;
}

func main() i32 {
    var f = id;
    const g = id;
    h := f;
    var k = h;
    func inner() i32 {
        var local = f;
        return local(1);
    }
    return f(40) + f[i32](0) + g(0) + h(1, 0) + k[i32](0) + inner();
}
