import "math";

type Vec[T type] struct {
    n T;
    extra i32;
};

type Box[T type] struct {
    value T;
};

type Buf[N i32, T type] struct {
    n T;
};

func Vec[T]::get(self this) T {
    return self.n;
}

const origin = Vec[i32]{};

func main() i32 {
    var filled = Vec[i32]{.n = 40};
    q := Vec[i32]{.extra = 1};
    var nested = Box[Vec[i32]]{.value = Vec[i32]{.n = 3}};
    var buf = Buf[4, i32]{.n = 2};
    var remote = math.Vec[i32]{.n = 7};
    var wide = math.Buf[4, i32]{};
    wide.n = 1;
    var empty = math.Vec[i32]{};
    return filled.get() + q.extra + origin.n + nested.value.n + buf.n + remote.n + wide.n + empty.n - 54;
}
