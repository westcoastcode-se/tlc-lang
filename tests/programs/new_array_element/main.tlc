// `new [n][m]T` reserves n elements that are each an array, and yields `[][m]T`.
type Point struct { x i32 = 1; y i32 = 2; }
const K = 3;
func main() i32 {
    var n = 2;
    var grid = new [n][K]i32;
    grid[1][2] = 5;
    var rows = new [n][]i32;
    var backing [3]i32 = {1, 2, 3};
    rows[0] = backing[:];
    rows[1] = backing[1:];
    var pts = new [n][2]Point;
    var filled = new [n][2]i32{{4, 6}...};
    var listed = new [_][2]i32{{7, 8}, {9, 10}};
    var deep = new [n][2][2]i32;
    deep[1][1][1] = 3;
    var total = grid[1][2] + rows[0][2] + rows[1][0] + i32(rows[1].len) + pts[1][1].y + pts[0][0].x;
    // 5 + 3 + 2 + 2 + 2 + 1 = 15
    total += filled[1][0] + filled[0][1];       // 10
    total += listed[1][1] - listed[0][0];       // 3
    total += deep[1][1][1] + i32(deep[0].len);  // 5
    total += i32(grid.len) + i32(grid[0].len);  // 5
    total += i32(sizeof([2]Point)) - 12;        // 4
    delete grid;
    delete rows;
    delete pts;
    delete filled;
    delete listed;
    delete deep;
    return total;
}
