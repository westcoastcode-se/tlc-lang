var row = [_]i32{10, 20, 30};
comptime const v []i32 = row;
comptime const again []i32 = v;
type Row []i32;
comptime const named Row = row;
comptime const fixed = [_]i32{4, 5};
comptime const from []const i32 = fixed;

func main() i32 {
    if (v.len != 3 || v[0] != 10 || v[2] != 30 || again[1] != 20 || named.len != 3 || named[0] != 10) {
        return 1;
    }
    if (from.len != 2 || from[0] != 4 || from[1] != 5) {
        return 2;
    }
    row[0] = 7;
    if (v[0] != 7 || again[0] != 7 || named[0] != 7) {
        return 3;
    }
    return 0;
}
