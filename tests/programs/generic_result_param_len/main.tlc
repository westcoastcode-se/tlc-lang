func repeat[N i32, T type](value T) [N]T {
    var out [N]T;
    out[0] = value;
    comptime if (N > 1) { out[1] = value; }
    comptime if (N > 2) { out[2] = value; }
    comptime if (N > 3) { out[3] = value; }
    return out;
}

func ordinary(comptime n i32) i32 {
    return repeat[n](1).len;
}

func main() i32 {
    return ordinary(4);
}
