// Every in-range index of a non-square array still reads its element, through a local, a pointer,
// a parameter, a tuple element, and a third dimension.
func row(r [3][2]i32, k i32) i32 {
    return r[k][1];
}

func main() i32 {
    var g [3][2]i32 = {{1, 2}, {3, 4}, {5, 6}};
    var p = &g;
    var t = (g, 0);
    var c [3][2][4]i32 = {{{0, 0, 0, 1}, {0, 0, 0, 2}}, {{0, 0, 0, 3}, {0, 0, 0, 4}}, {{0, 0, 0, 5}, {0, 0, 0, 6}}};
    var k = 2;
    if (g[k][1] != 6 || p[k][0] != 5 || row(g, k) != 6 || t[0][k][1] != 6 || c[k][1][3] != 6) {
        return 1;
    }
    return 42;
}
