comptime func still() [2][2][2][2]u8 {
    return [_][2][2][2]u8{{{{40u8, 2u8}, {1u8, 0u8}}, {{3u8, 4u8}, {5u8, 6u8}}},
                          {{{7u8, 8u8}, {9u8, 10u8}}, {{11u8, 12u8}, {13u8, 14u8}}}};
}

comptime func deep(n i32) [2][2][2][2]u8 {
    var a = n;
    return [_][2][2][2]u8{{{{u8(a), 2u8}, {1u8, 0u8}}, {{3u8, 4u8}, {5u8, 6u8}}},
                          {{{7u8, 8u8}, {9u8, 10u8}}, {{11u8, 12u8}, {13u8, 14u8}}}};
}

func main() i32 {
    var c = deep(40);
    var h = still();
    if (c[0][0][0][0] + c[0][0][0][1] == 42u8 && h[0][0][0][0] == 40u8) {
        return 42;
    }
    return 0;
}
