type Point struct {
    x i32;
    y i32;
};

type Entity struct {
    id i32;
};

func call_func() i32 {
    return 10;
}

func make() Point {
    return Point{.x = item, .y = item};
}

func Point::origin() Point {
    return Point{.x = 1, .y = 1};
}

func Point::value(self this) i32 {
    return self.x + self.y;
}

func one() f32 {
    return 1.0f;
}

unsafe func raw() i32 {
    return 7;
}

func next_id() i32 {
    return 5;
}

var numbers = [_]i32{3, 4, 5};

func pair() []i32 {
    return numbers[0:2];
}

var item = call_func();
var fp = call_func;
var via = fp();
var typed i32 = call_func();
named := call_func();
var point = make();
var got = point.value();
var extra = Point.origin();
var scale = one();
var marked = unsafe raw();
var Entity::item = next_id();
var view = pair();
var typed_view []i32 = pair();

func main() i32 {
    if (scale != 1.0f) {
        return 1;
    }
    if (typed != 10 || named != 10 || marked != 7 || Entity.item != 5 || via != 10) {
        return 2;
    }
    if (view.len != 2 || view[0] != 3 || typed_view[1] != 4) {
        return 3;
    }
    return got + extra.x + extra.y + item + typed;
}
