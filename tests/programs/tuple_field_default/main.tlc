type Box struct {
    pair (i32, i32) = (40, 2);
    n i32 = 1;
};

type Gen[T type] struct {
    pair (T, i32) = (18, 2);
};

var global Box;

func main() i32 {
    var bare Box;
    var named = Box{.pair = (7, 1)};
    var other = Box{.n = 9};
    var zero = Box{0...};
    var gen Gen[i32];
    if (bare.pair[0] != 40 || bare.pair[1] != 2 || bare.n != 1) {
        return 1;
    }
    if (named.pair[0] != 7 || named.pair[1] != 1 || named.n != 1) {
        return 2;
    }
    if (other.pair[0] != 40 || other.pair[1] != 2 || other.n != 9) {
        return 3;
    }
    if (zero.pair[0] != 0 || zero.pair[1] != 0 || zero.n != 0) {
        return 4;
    }
    if (gen.pair[0] != 18 || gen.pair[1] != 2 || global.pair[0] != 40 || global.pair[1] != 2) {
        return 5;
    }
    return bare.pair[0] + bare.pair[1];
}
