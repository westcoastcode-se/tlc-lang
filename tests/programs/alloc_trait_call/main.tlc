type Arena struct {
    used i32;
    align i32;
    slot i32;
};

unsafe func Arena::malloc(self *this, size i32, align i32) ?*u8 {
    self.used = size;
    self.align = align;
    return ?*u8(&self.slot);
}

func Arena::free(self *this, ptr *u8) void {
}

unsafe func Arena::realloc(self *this, ptr *u8, size i32, align i32) ?*u8 {
    return null;
}

func take(a *Allocator) i32 {
    var raw = unsafe a.malloc[i32]();
    if (raw == null) {
        return 0;
    }
    return 1;
}

func main() i32 {
    var arena Arena;
    if (take(&arena) != 1) {
        return 1;
    }
    return arena.used * 10 + arena.align;
}
