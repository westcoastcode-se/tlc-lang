// An ordinary function whose comptime parameter is a generic value, `width<n>()`, folds at each call,
// whatever its integer result. The parameter keeps its written type and its whole range.
func width<N i64>() i64 {
    return N;
}

func small<N u8>() u8 {
    return N;
}

func wide(comptime n i64) i64 {
    return width<n>();
}

func narrow(comptime n i32) i64 {
    return width<n>();
}

func byte(comptime n u8) u8 {
    return small<n>();
}

func main() i32 {
    var bad = 0;
    if (wide(3000000000) != 3000000000) {
        bad |= 1;
    }
    if (narrow(40) != 40) {
        bad |= 2;
    }
    if (byte(200) != 200u8) {
        bad |= 4;
    }
    return bad == 0 ? 42 : bad;
}
