import "builtin";

extern(abi="c") func printf(fmt *const u8, ...) i32;

macro func print_with_tuples[T type](comptime fmt []const u8, comptime values T) void {
    emit printf(builtin.fmt(fmt, values));
}

func main() i32 {
    print_with_tuples("Hello {0}! {0} is {1} years old\n"b, ("John Doe"b, 26));
    return 0;
}
