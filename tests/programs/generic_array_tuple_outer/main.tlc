type Box[T type] struct {
    row [2]T;
}

func pair[T type](a T, b T) [2]T {
    var row [2]T;
    row[0] = a;
    row[1] = b;
    return row;
}

func hold[T type](a T, b T) Box[T] {
    var box Box[T];
    box.row[0] = a;
    box.row[1] = b;
    return box;
}

func take[T type](row [2]T) i32 {
    return row[0][0][0] + row[1][1][1];
}

func rows[T type](a T, b T) [2]T {
    var g [2]T;
    g[0] = a;
    g[1] = b;
    return g;
}

func sum[T type](a T, b T) i32 {
    var g [2]T;
    g[0] = a;
    g[1] = b;
    return g[0][0][0] + g[1][1][1];
}

func grid[T type](value T) i32 {
    var g [2][2]T;
    g[0][1] = value;
    return g[0][1][0][0] + g[0][1][1][1];
}

func main() i32 {
    var a = pair((40, 2), (1, 3));
    var b = pair((4, 5), (6, 7));
    if (sum(a, b) != 47) {
        return 1;
    }
    if (grid(a) != 43) {
        return 2;
    }
    var made = rows(a, b);
    if (take(made) != 47) {
        return 3;
    }
    var box = hold(a, b);
    if (take(box.row) != 47) {
        return 4;
    }
    return box.row[0][0][0] + box.row[1][1][1];
}
