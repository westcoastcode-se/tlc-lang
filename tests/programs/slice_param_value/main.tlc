type Row []i32;

func open(row [4]i32) []i32 {
    return row;
}

func named(row [4]i32) Row {
    return row;
}

func rows(grid [2][3]i32) [][3]i32 {
    return grid;
}

func headers(table [2][]i32) [][]i32 {
    return table;
}

func both(row [4]i32) ([]i32, i32) {
    return row, row.len;
}

func take(a []i32) i32 {
    return a[0] + a.len;
}

func through(row [4]i32) i32 {
    return take(row);
}

func local_view(row [4]i32) i32 {
    var s []i32 = row;
    return s[1] + s.len;
}

func sized[N i32](row [N]i32) []i32 {
    return row;
}

func main() i32 {
    var data [4]i32;
    data[0] = 10;
    data[1] = 20;
    data[2] = 30;
    data[3] = 40;
    var view = open(data);
    if (view.len != 4 || view[0] != 10 || view[3] != 40) {
        return 1;
    }
    data[1] = 8;
    if (view[1] != 8) {
        return 2;
    }
    var alias = named(data);
    if (alias.len != 4 || alias[1] != 8) {
        return 3;
    }
    var grid [2][3]i32;
    grid[0][0] = 1;
    grid[0][1] = 2;
    grid[1][2] = 6;
    var band [][3]i32 = rows(grid);
    if (band.len != 2 || band[0][0] != 1 || band[0][1] != 2 || band[1][2] != 6) {
        return 4;
    }
    var a = [_]i32{7, 8};
    var b = [_]i32{9};
    var table = [_][]i32{a[:], b[:]};
    var flat [][]i32 = headers(table);
    if (flat.len != 2 || flat[0][1] != 8 || flat[1][0] != 9) {
        return 5;
    }
    var left, count = both(data);
    if (left.len != 4 || left[0] != 10 || left[1] != 8 || count != 4) {
        return 6;
    }
    if (through(data) != 14) {
        return 7;
    }
    if (local_view(data) != 12) {
        return 8;
    }
    var part = sized[4](data);
    if (part.len != 4 || part[0] != 10) {
        return 9;
    }
    return 42;
}
