type Holder struct {
    cells [3]i32;
}

const table = [_]i32{1, 2};
var grid [2][3]i32;
var h Holder;

func read(row [2]i32) i32 {
    return row[2];
}

func through(p *[2]i32) i32 {
    return p[2];
}

func main() i32 {
    const fixed = [_]i32{1, 2};
    var row = [_]i32{1, 2};
    const k = 2;
    var sum = fixed[2];
    sum += row[-1];
    sum += row[k];
    sum += table[5];
    sum += grid[1][3];
    sum += grid[2][0];
    sum += h.cells[3];
    row[2] = 1;
    row[k] += 1;
    h.cells[3] = 4;
    return sum + read(row) + through(&row);
}
