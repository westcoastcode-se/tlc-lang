import "builtin";

extern(abi="c") func printf(fmt *const u8, ...) i32;

type Point struct {
    x i32;
    y f32;
};

type Holder struct {
    p Point;
    label *u8;
};

type Box[T type] struct {
    value T;
};

type Alias Point;

type Count i32;

type Empty struct {};

type Node struct {
    next *Node;
    n i32;
};

type Row struct {
    raw [4]i32;
    items []const u8;
};

func main() i32 {
    var fields = typeof(Point).fields();
    var listed []builtin.Field = fields;
    if (fields.len != 2 || listed.len != 2 || listed[0].kind != typeof(i32)) {
        return 1;
    }
    if (fields[0].kind != typeof(i32) || fields[1].kind != typeof(f32)) {
        return 2;
    }
    var kind builtin.Type = typeof(Point);
    var through *builtin.Type = &kind;
    if (through.fields().len != 2 || through.fields()[0].kind != typeof(i32)) {
        return 3;
    }
    if (typeof(i32).fields().len != 0 || typeof(Empty).fields().len != 0 || typeof(Count).fields().len != 0) {
        return 4;
    }
    var held = typeof(Holder).fields();
    if (held.len != 2 || held[0].kind != typeof(Point) || held[1].kind != typeof(*u8)) {
        return 5;
    }
    if (held[0].kind.fields().len != 2 || held[0].kind.fields()[1].kind != typeof(f32)) {
        return 6;
    }
    var box Box[i32];
    if (typeof(box).fields().len != 1 || typeof(box).fields()[0].kind != typeof(i32)) {
        return 7;
    }
    if (typeof(Alias).fields().len != 2 || typeof(Alias).fields()[0].kind != typeof(i32) || typeof(Alias) == typeof(Point)) {
        return 8;
    }
    var node_fields = typeof(Node).fields();
    if (node_fields.len != 2 || node_fields[0].kind != typeof(*Node) || node_fields[1].kind != typeof(i32)) {
        return 9;
    }
    var row = typeof(Row).fields();
    if (row.len != 2 || row[0].kind != typeof([4]i32) || row[1].kind != typeof([]const u8)) {
        return 10;
    }
    if (fields[0].name.len != 1 || fields[1].name.len != 1 || fields[0].kind.name() == null) {
        return 11;
    }
    printf("%s %s\n", fields[0].name, fields[0].kind.name());
    printf("%s %s\n", fields[1].name, fields[1].kind.name());
    printf("%s %s\n", held[0].name, held[1].name);
    printf("%s\n", typeof(box).fields()[0].name);
    return 0;
}
