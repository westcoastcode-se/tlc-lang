type Point struct {
    x i32;
};

type Row []i32;

type Hold struct {
    n i32;
    items []i32;
};

type Bag struct {
    items []i32;
};

type Grid struct {
    cells [4]i32;
};

var numbers = [_]i32{10, 20, 30, 40};
var bag = Bag{.items = numbers};

func take(v []i32) i32 {
    return v[0] + v.len;
}

func take_row(v Row) i32 {
    return v[0] + v.len;
}

func window(v []i32) []i32 {
    return v[1:3];
}

func main() i32 {
    var row = [_]i32{10, 20, 30, 40};
    var mid = row[1:3];
    var again = mid[0:2];
    if (mid.len != 2 || mid[0] != 20 || mid[1] != 30 || again[1] != 30) {
        return 1;
    }
    if (take(row[2:4]) != 32) {
        return 2;
    }
    var points = [_]Point{Point{.x = 7}, Point{.x = 9}, Point{.x = 1}};
    var tail = points[1:2];
    if (tail.len != 1 || tail[0].x != 9) {
        return 3;
    }
    var named Row = row;
    var part Row = named[1:3];
    if (take_row(part) != 22 || take_row(named[1:3]) != 22) {
        return 4;
    }
    var box Hold;
    if (box.items.len != 0) {
        return 5;
    }
    box.n = 4;
    box.items = row[0:2];
    var other = box;
    if (box.items.len != 2 || other.items[0] != 10 || other.n != 4) {
        return 6;
    }
    row[0] = 8;
    if (other.items[0] != 8 || box.items[0] != 8) {
        return 7;
    }
    var held = Hold{.n = 1, .items = row[0:2]};
    if (held.n != 1 || held.items.len != 2 || held.items[1] != 20) {
        return 8;
    }
    if (Hold{.n = 1, .items = row[0:2]}.items[1] != 20) {
        return 9;
    }
    if (bag.items.len != 4 || bag.items[3] != 40) {
        return 10;
    }
    if (sizeof(Hold) != 24 || sizeof box.items != 16 || sizeof([]i32) != 16) {
        return 11;
    }
    var from = window(row);
    if (from.len != 2 || from[0] != 20) {
        return 12;
    }
    var grid Grid;
    grid.cells[0] = 1;
    grid.cells[1] = 2;
    grid.cells[2] = 3;
    grid.cells[3] = 4;
    var view = grid.cells[1:3];
    if (view.len != 2 || view[0] != 2 || view[1] != 3) {
        return 13;
    }
    return mid[0] + tail[0].x + box.n;
}
