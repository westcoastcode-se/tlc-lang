assert(typeof(i32) == typeof(i32), "same type");
assert(typeof(i32) != typeof(i64), "different type");
assert(1.5f + 0.5f == 2.0f, "add");
assert(1.5f < 2.0f, "less");

comptime const bias = 0.5f;
comptime const sum = bias + 1.5f;
var scale = 1.5f + 0.5f;
var neg = -(1.0f + 1.0f);
var less = 1.5f < 2.0f;
var rough = 0.1f + 0.2f;
var from_u f32 = 1u32;
var row = [_]i32{1u32, 2 + 3};
comptime const N = 1u32;

func main() i32 {
    var local = 0.1f + 0.2f;
    var buf [N]i32;
    buf[0] = 29;
    if (scale != 2.0f || sum != 2.0f || from_u != 1.0f || neg != -2.0f || less != true) {
        return 1;
    }
    if (rough != local) {
        return 2;
    }
    if (row[0] != 1 || row[1] != 5) {
        return 3;
    }
    return buf[0] + row[0] + row[1] + 7;
}
