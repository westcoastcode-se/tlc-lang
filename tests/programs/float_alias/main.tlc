func add(a f64, b f32) f64 {
    return a + b;
}

func main() i32 {
    var x f64 = 20.5;
    var y f32 = 1.5f;
    var z f64 = add(x, y);
    if (z != 22.0) {
        return 1;
    }
    if (sizeof(f32) != 4) {
        return 2;
    }
    if (sizeof(f64) != 8) {
        return 3;
    }
    return 42;
}
