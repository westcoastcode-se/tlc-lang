// A file-scope `var g = i8(-2)` is an `i8` and keeps its sign when it is read. A `char` stays `u8`.
var g = i8(-2);
var h = i16(-3);
var k = u8(300);
func main() i32 {
    var bad = 0;
    if (i64(g) != -2) { bad |= 1; }
    if (i64(h) != -3) { bad |= 2; }
    if (i64(k) != 44) { bad |= 4; }
    return bad == 0 ? 42 : bad;
}
