trait Shape {
    func area() int;
    func grow(n int) void;
};

trait Meas {
    func area() int;
};

struct Rect {
    w int;
    h int;
};

struct Box {
    n int;
};

func Rect::area(self this) int {
    return self.w * self.h;
}

func Rect::grow(self *this, n int) void {
    self.w = self.w + n;
    self.h = self.h + n;
}

func Box::area(self this) int {
    return self.n;
}

func Box::grow(self *this, n int) void {
    self.n = self.n + n;
}

func measure(s *Shape) int {
    return s.area();
}

func apply(s *Shape, n int) int {
    s.grow(n);
    return measure(s);
}

func take(m Meas) int {
    return m.area();
}

func main() int {
    var r Rect;
    var b Box;
    r.w = 5;
    r.h = 6;
    b.n = 0;
    var a int = apply(&r, 1);
    var d int = take(r);
    var c int = apply(&b, 21);
    return a + c + d - 63;
}
