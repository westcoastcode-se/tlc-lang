comptime const addr = 20;
comptime const p = &addr;
comptime const n = *p;
comptime const pp = &p;
comptime const again = **pp;

func width[N i32]() i32 {
    return N;
}

func main() i32 {
    comptime const local = 2;
    comptime const lp = &local;
    comptime const len = *lp;
    comptime if (*p == 20) {
        return n + again + width[len]();
    }
    return 0;
}
