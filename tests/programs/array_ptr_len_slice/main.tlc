type Hold struct {
    items *[4]i32;
};

func open(p *[4]i32) []i32 {
    return p;
}

func rows(p *[2][3]i32) [][3]i32 {
    return p;
}

func headers(p *[2][]i32) [][]i32 {
    return p;
}

func give(p *[4]i32) *[4]i32 {
    return p;
}

func field(h *Hold) []i32 {
    return h.items;
}

func frozen(p *const [4]i32) []const i32 {
    return p;
}

func take(a []i32) i32 {
    return a[0] + a.len;
}

func main() i32 {
    var row = [_]i32{38, 1, 2, 3};
    var p = &row;
    var view = open(p);
    if (view.len != 4 || view[0] != 38) {
        return 1;
    }
    row[1] = 8;
    if (view[1] != 8) {
        return 2;
    }
    var grid = [_][3]i32{{1, 2, 3}, {4, 5, 6}};
    var band [][3]i32 = rows(&grid);
    if (band.len != 2 || band[0][0] != 1 || band[1][2] != 6) {
        return 3;
    }
    var left = [_]i32{7, 8};
    var right = [_]i32{9};
    var table = [_][]i32{left[:], right[:]};
    var flat [][]i32 = headers(&table);
    if (flat.len != 2 || flat[0][1] != 8 || flat[1][0] != 9) {
        return 4;
    }
    var again = open(give(p));
    if (again.len != 4 || again[0] != 38 || again[1] != 8) {
        return 5;
    }
    var box = Hold{.items = &row};
    var from_field = field(&box);
    if (from_field.len != 4 || from_field[0] != 38) {
        return 7;
    }
    var cp *const [4]i32 = &row;
    var cold = frozen(cp);
    if (cold.len != 4 || cold[0] != 38) {
        return 8;
    }
    if (take(p) != 42) {
        return 9;
    }
    var s []i32 = p;
    if (s.len != 4 || s[1] != 8) {
        return 10;
    }
    var direct []i32 = box.items;
    if (direct.len != 4 || direct[0] != 38) {
        return 11;
    }
    return 42;
}
