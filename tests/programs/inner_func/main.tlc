var bias i32;

func add(n i32) i32 {
    return 0;
}

func other() i32 {
    func add(n i32) i32 {
        return n;
    }
    return add(0);
}

func main() i32 {
    bias = 1;
    func add(n i32) i32;
    func add(n i32) i32 {
        func step(m i32) i32 {
            switch (m) {
            case 0:
                return bias;
            default:
                return m + bias;
            }
        }
        if (n == 0) {
            return step(0);
        }
        return add(n - 1) + 1;
    }
    return add(41) + other();
}
