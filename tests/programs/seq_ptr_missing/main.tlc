import "std/seq";

type Bag struct {
    n i32;
};

func Bag::len(self this) i32 {
    return self.n;
}

func Bag::at(self this, i i32) i32 {
    return self.n;
}

func use(items *seq.Seq[i32]) i32 {
    return items.len();
}

func main() i32 {
    var bag Bag;
    bag.n = 1;
    return use(&bag);
}
