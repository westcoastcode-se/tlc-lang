type Point struct {
    x i32;
    y i32;
};

comptime const origin = Point{.x = 41, .y = 1};

comptime func move(p Point) Point {
    var copy = p;
    copy.x = copy.x + 1;
    return copy;
}

comptime const made = move(origin);

func width[N i32]() i32 {
    return N;
}

func main() i32 {
    return width[made.x]();
}
