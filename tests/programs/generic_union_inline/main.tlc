type Kind enum {
    One,
    Two,
};

type Shape[T type] union(Kind) {
    One struct {
        value T;
    };
    Two struct {
        n i32;
    };
};

func main() i32 {
    var shape Shape[i32] = {.One = {.value = 42}};
    if (shape.One.value != 42) {
        return 1;
    }
    shape.Two.n = 7;
    if (Kind(shape) != Kind.Two || shape.Two.n != 7) {
        return 2;
    }
    return 42;
}
