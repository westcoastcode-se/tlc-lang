func pair[T type](a T, b T) [2]T {
    var row [2]T;
    row[0] = a;
    row[1] = b;
    return row;
}

func plain[T type](value ?**T) i32 {
    var q ?**T = value;
    if (q == null) {
        return 0;
    }
    return (**q)[0] + (**q)[1];
}

func read[T type](value ?**T) i32 {
    var q ?**T = value;
    if (q == null) {
        return 0;
    }
    return (**q)[0][0] + (**q)[1][1];
}

func main() i32 {
    var one = (40, 2);
    var tp = &one;
    if (plain(&tp) != 42) {
        return 1;
    }
    var row = pair((40, 2), (1, 3));
    var p = &row;
    return read(&p);
}
