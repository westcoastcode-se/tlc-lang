func pair[T type](a T, b T) [2]T {
    var row [2]T;
    row[0] = a;
    row[1] = b;
    return row;
}

func fill[T type](a T, b T, c T, d T) [2][2]T {
    var g [2][2]T;
    g[0][0] = a;
    g[0][1] = b;
    g[1][0] = c;
    g[1][1] = d;
    return g;
}

func id[T type](value *T) *T {
    return value;
}

func main() i32 {
    var one = (40, 2);
    var tp = id(&one);
    if ((*tp)[0] + (*tp)[1] != 42) {
        return 1;
    }
    var g = fill((40, 2), (1, 3), (4, 5), (6, 7));
    var gp = id(&g);
    if ((*gp)[0][0][0] + (*gp)[1][1][1] != 47) {
        return 2;
    }
    var row = pair((40, 2), (1, 3));
    var p = id(&row);
    return (*p)[0][0] + (*p)[1][1];
}
