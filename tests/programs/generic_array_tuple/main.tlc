type Box[T type] struct { row [2]T; }

func make[T type](a T, b T) Box[T] {
    var box Box[T];
    box.row[0] = a;
    box.row[1] = b;
    return box;
}

func main() i32 {
    var one = (40, 2);
    var two = (1, 3);
    var deep = ((40, 2), 1);
    var other = ((3, 4), 5);
    var box = make(one, two);
    var wide = make(deep, other);
    if (wide.row[0][0][0] + wide.row[1][1] != 45) {
        return 1;
    }
    return box.row[0][0] + box.row[1][1];
}
