import "builtin/env/consts";

func is(text *const u8, want *const u8) i32 {
    var i i32 = 0;
    while (text[i] == want[i]) {
        if (text[i] == 0) {
            return 1;
        }
        i = i + 1;
        if (i > 8) {
            return 0;
        }
    }
    return 0;
}

func main() i32 {
    if (is(consts.family, "unix") == 1 || is(consts.family, "windows") == 1) {
        return 0;
    }
    return 1;
}
