import "builtin";

extern(abi="c") func printf(fmt *const u8, ...) i32;

var kind builtin.Type = typeof(i32);

type Point struct {
    x i32;
};

type Box[T type] struct {
    value T;
};

func id[T type](value T) i32 {
    if (typeof(T) != typeof(value)) {
        return 1;
    }
    return 0;
}

func take(value builtin.Type) *u8 {
    return value.name();
}

func main() i32 {
    var n i32 = 1;
    var t builtin.Type = typeof(n);
    var p ?*i32 = null;
    var a [4]i32;
    var box Box[i32];
    var point Point;
    if (sizeof(builtin.Type) != 8) {
        return 1;
    }
    if (typeof(i64) == typeof(i32) || kind != typeof(i32)) {
        return 2;
    }
    if (typeof(n) != t) {
        return 3;
    }
    if (typeof(Point) == typeof(i32)) {
        return 4;
    }
    if (typeof(u8) == typeof(i8)) {
        return 5;
    }
    if (id(n) != 0) {
        return 6;
    }
    if (take(typeof(i32)) != take(t)) {
        return 7;
    }
    var through *builtin.Type = &t;
    if (through.name() != t.name()) {
        return 8;
    }
    printf("%s\n", t.name());
    printf("%s\n", typeof(*i32).name());
    printf("%s\n", typeof(p).name());
    printf("%s\n", typeof(a).name());
    printf("%s\n", typeof(box).name());
    printf("%s\n", typeof(point).name());
    printf("%s\n", typeof("hi").name());
    printf("%s\n", typeof(builtin.Type).name());
    printf("%s\n", typeof(f32).name());
    printf("%s\n", typeof(f32).name());
    return 0;
}
