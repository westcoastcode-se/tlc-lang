// A runtime shift amount at or past the width, or a negative amount, has a defined result.
// `<<` and an unsigned `>>` give 0. A signed `>>` fills with the sign bit. Every `-O` level agrees.
func main() i32 {
    var b = 32;
    var neg = -1;
    var forty = 40u32;
    if ((1 << b) != 0) { return 1; }
    if ((-8 >> b) != -1) { return 2; }
    if ((8 >> b) != 0) { return 3; }
    if ((8u32 >> forty) != 0u32) { return 4; }
    if ((1 << neg) != 0) { return 5; }
    if ((16 >> 2) != 4) { return 6; }
    var x = 1;
    x <<= b;
    if (x != 0) { return 7; }
    var y = -64;
    y >>= b;
    if (y != -1) { return 8; }
    var big = 5i64;
    var s64 = 64i64;
    if ((big << s64) != 0i64) { return 9; }
    var under = 31;
    if ((1 << under) != -2147483647 - 1) { return 10; }
    return 42;
}
