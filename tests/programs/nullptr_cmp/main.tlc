func main() int {
    var p int *;
    var x int;
    var n int;
    x = 7;
    p = nullptr;
    n = 0;
    if (p == nullptr) {
        n = 1;
    }
    if (p != nullptr) {
        return 0;
    }
    p = &x;
    if (p == nullptr) {
        return 0;
    }
    if (p != nullptr) {
        n = n + 41;
    }
    return n;
}
