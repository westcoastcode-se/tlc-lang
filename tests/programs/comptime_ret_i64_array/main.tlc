comptime func still() [2]i64 {
    return [_]i64{3000000000, 2};
}

comptime func row(n i32) [2]i64 {
    var a = 3000000000 + i64(n);
    var b = 2i64;
    return [_]i64{a, b};
}

func main() i32 {
    var r = row(0);
    var s = still();
    if (r[0] == 3000000000 && r[1] == 2 && s[0] == 3000000000) {
        return 42;
    }
    return 0;
}
