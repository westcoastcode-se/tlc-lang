func id[T type](value *T) *T {
    return value;
}

func wide[T type](value *T) *T {
    return value;
}

func main() i32 {
    var row = (40, 2);
    var deep = ((40, 2), 1);
    var p = id(&row);
    var q = wide(&deep);
    if ((*q)[0][0] + (*q)[1] != 41) {
        return 1;
    }
    return (*p)[0] + (*p)[1];
}
