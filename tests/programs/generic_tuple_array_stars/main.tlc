func pair[T type](a T, b T) [2]T {
    var row [2]T;
    row[0] = a;
    row[1] = b;
    return row;
}

func id[T type](value ***const T) i32 {
    return (***value)[0][0] + (***value)[1][1];
}

func main() i32 {
    var row = pair((40, 2), (1, 3));
    var p = &row;
    var pp = &p;
    return id(&pp);
}
