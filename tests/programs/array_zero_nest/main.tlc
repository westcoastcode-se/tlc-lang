type Holder struct {
    raw [2][2]i32;
}

func main() i32 {
    var grid [2][2]i32 = {{8, 8}, {8, 8}};
    grid = {{1, 0...}, {4, 5}};
    if (grid[0][0] != 1 || grid[0][1] != 0 || grid[1][0] != 4 || grid[1][1] != 5) {
        return 1;
    }
    grid[1] = {7, 0...};
    if (grid[1][0] != 7 || grid[1][1] != 0 || grid[0][0] != 1) {
        return 2;
    }

    var h Holder;
    h.raw = {{8, 8}, {8, 8}};
    h.raw = {{6, 0...}, {1, 2}};
    if (h.raw[0][0] != 6 || h.raw[0][1] != 0 || h.raw[1][0] != 1 || h.raw[1][1] != 2) {
        return 3;
    }
    h.raw[0] = {4, 0...};
    if (h.raw[0][0] != 4 || h.raw[0][1] != 0 || h.raw[1][1] != 2) {
        return 4;
    }

    var slot [2][2]i32 = {{8, 8}, {8, 8}};
    slot = [_][2]i32{{3, 0...}, {1, 1}};
    if (slot[0][0] != 3 || slot[0][1] != 0 || slot[1][0] != 1 || slot[1][1] != 1) {
        return 5;
    }

    var line [2]i32 = {8, 8};
    line = {4, 0...};
    if (line[0] != 4 || line[1] != 0) {
        return 6;
    }
    return 0;
}
