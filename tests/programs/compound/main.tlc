func main() i32 {
    var n = 10;
    n += 2;
    if (n != 12) {
        return 1;
    }
    n -= 3;
    if (n != 9) {
        return 2;
    }
    n *= 4;
    if (n != 36) {
        return 3;
    }
    n /= 6;
    if (n != 6) {
        return 4;
    }
    var m = 2;
    n += m += 3;
    if (m != 5 || n != 11) {
        return 5;
    }
    var p = &n;
    *p += 1;
    if (n != 12) {
        return 6;
    }
    var row [1]i32;
    row[0] = 8;
    row[0] *= 2;
    if (row[0] != 16) {
        return 7;
    }
    var top = -2147483647 - 1;
    top /= -1;
    if (top != -2147483647 - 1) {
        return 8;
    }
    var a = (n -= 2);
    if (a != 10 || n != 10) {
        return 9;
    }
    return 0;
}
