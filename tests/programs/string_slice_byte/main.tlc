const label = "hello";
const cut = label[1:4];
const again = cut[0:2];
const i = 0;
const n = "hello"[1:4][i];
const named = cut[0];
const deep = again[1];
const open = "hello"[1:][0];
const low = "hello"[:2][1];
const whole = "hello"[:][1];
const tail = "hello"[4:][0];
const nl = "\n"[0:1][0];
const raw = `hello`[1:4][0];
const hex = "\xFF"[0:1][0];
const nul = "a\000b"[1:2][0];
const N = "\xFF\x01"[1:2][0];
const row = [_]i32{"hello"[1:4][0], 1};
var live = "hello"[1:4][0];

assert(n == 101, "byte");
assert(named == 101, "name");
assert(deep == 108, "deep");
assert(open == 101, "open");
assert(low == 101, "low");
assert(whole == 101, "whole");
assert(tail == 111, "tail");
assert(nl == 10, "nl");
assert(raw == 101, "raw");
assert(hex == 255, "hex");
assert(nul == 0, "nul");
assert(sizeof([N]i32) == 4, "len");

comptime func byte() i32 {
    return label[1:4][0];
}

func main() i32 {
    const text = "hello";
    var k = 0;
    if (text[1:4][0] != n || "hello"[1:4][k] != byte() || live != n || row[0] != 101) {
        return 0;
    }
    if (cut.len != 3 || cut[1] != deep || again.len != 2 || again[0] != n) {
        return 0;
    }
    return n - 59;
}
