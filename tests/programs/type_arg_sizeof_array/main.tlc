type Point struct { x i32; y i32; };

type Buf[N i32] struct {
    raw [N]u8;
};

func Buf[N]::span() i32 { return N; }

func width[N i32]() i32 { return N; }

func use[T type]() i32 {
    assert(sizeof(T) > 0, "size");
    return width[sizeof(T)]();
}

func plain[T type]() i32 { return sizeof(T); }

func bare[T type]() i32 { return sizeof T; }

func aligned[T type]() i32 { return alignof(T); }

func span_of[T type]() i32 { return Buf[sizeof(T)].span(); }

func main() i32 {
    if (use[[4]i32]() != 16) { return 1; }
    if (plain[[4]i32]() != 16) { return 2; }
    if (bare[[4]i32]() != 16) { return 3; }
    if (use[[4]u8]() != 4) { return 4; }
    if (plain[[2]Point]() != 16) { return 5; }
    if (use[[2][3]i32]() != 24) { return 6; }
    if (plain[[]i32]() != 16) { return 7; }
    if (use[*[4]i32]() != 8) { return 8; }
    if (plain[[4]*i32]() != 32) { return 9; }
    if (aligned[[4]i32]() != 4) { return 10; }
    if (aligned[[4]u8]() != 1) { return 11; }
    if (use[[2][]i32]() != 32) { return 12; }
    if (span_of[[4]u8]() != 4) { return 13; }
    if (width[sizeof([4]i32)]() != use[[4]i32]()) { return 14; }
    return 42;
}
