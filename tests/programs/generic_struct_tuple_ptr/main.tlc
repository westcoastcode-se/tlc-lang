type Box[T type] struct {
    p *T;
}

func make[T type](value *T) Box[T] {
    var box Box[T] = {.p = value};
    return box;
}

func main() i32 {
    var n = 40;
    var num = make(&n);
    if (*num.p != 40) {
        return 1;
    }
    var deep = ((40, 2), 1);
    var wide = make(&deep);
    if ((*wide.p)[0][0] + (*wide.p)[1] != 41) {
        return 2;
    }
    var row = (40, 2);
    var box = make(&row);
    return (*box.p)[0] + (*box.p)[1];
}
