func pair[T type](a T, b T) [2]T {
    var row [2]T;
    row[0] = a;
    row[1] = b;
    return row;
}

func take[T type](row [2]T) i32 {
    return row[0][0] + row[1][1];
}

func wide[T type](row [2]T) i32 {
    return row[0][0][0] + row[1][1];
}

func sum[T type](row [2]T) i32 {
    return row[0] + row[1];
}

func main() i32 {
    var one = (40, 2);
    var two = (1, 3);
    var deep = ((40, 2), 1);
    var other = ((3, 4), 5);
    var nums [2]i32;
    nums[0] = 40;
    nums[1] = 2;
    if (wide(pair(deep, other)) != 45) {
        return 1;
    }
    if (sum(nums) != 42) {
        return 2;
    }
    var row = pair(one, two);
    return take(row);
}
