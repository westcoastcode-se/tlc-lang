import "builtin";

extern(abi="c"b) func printf(fmt *const u8, ...) i32;

type Point struct {
    x i32;
    y i32;
};

macro func names() void {
    for (var i = 0; i < typeof(Point).fields().len; i = i + 1) {
        emit printf("%s\n"b, typeof(Point).fields()[i].name);
    }
}

macro func bytes() void {
    for (var i = 0; i < "hi"b.len; i = i + 1) {
        emit printf("%d\n"b, "hi"b[i]);
    }
}

func main() i32 {
    names();
    bytes();
    return 0;
}
