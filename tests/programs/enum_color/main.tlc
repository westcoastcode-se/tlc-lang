enum Color {
    Red,
    Green = 40,
    Blue,
};

enum Tiny i8 {
    A,
    B,
};

func Color::code(self this) int {
    if (self == Color.Blue) {
        return 40;
    }
    return 0;
}

func Tiny::id(self this) int {
    if (self == Tiny.B) {
        return 2;
    }
    return 0;
}

func main() int {
    value := Color.Blue;
    small := Tiny.B;
    if (value.code() == 40 && small.id() == 2 && sizeof(Tiny) == 1 && sizeof(Color) == 4) {
        return 42;
    }
    return 0;
}
