func add(a i32, b i32) i32 {
    return a + b;
}

func myfunc(ptr func (i32, i32) i32) i32 {
    return ptr(20, 22);
}

func ignore(n i32) void {
}

func note(p func (i32) void, n i32) i32 {
    p(n);
    return n;
}

func id(n i32) i32 {
    return n;
}

func call(f func (i32) i32) i32 {
    return f(40);
}

func apply(p func (func (i32) i32) i32, f func (i32) i32) i32 {
    return p(f);
}

type BinOp func (i32, i32) i32;

var saved func (i32, i32) i32;

func main() i32 {
    var fp func (i32, i32) i32;
    fp = add;
    saved = fp;
    var op BinOp = saved;
    if (op(1, 1) != 2) {
        return 1;
    }
    if (note(ignore, 7) != 7) {
        return 3;
    }
    if (apply(call, id) != 40) {
        return 4;
    }
    return myfunc(add);
}
