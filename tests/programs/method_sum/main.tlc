type Point struct {
    x i32;
    y i32;
};

type Pair struct {
    a i32;
    b i32;
};

func make(x i32, y i32) Point {
    var p Point;
    p.x = x;
    p.y = y;
    return p;
}

func Point::sum(self this, extra i32) i32 {
    return self.x + self.y + extra;
}

func Pair::sum(self this, extra i32) i32 {
    return self.a + self.b + extra;
}

func sum(n i32) i32 {
    return n;
}

func main() i32 {
    var q Pair;
    q.a = 1;
    q.b = 1;
    return make(10, 10).sum(2) + q.sum(0) + sum(18);
}
