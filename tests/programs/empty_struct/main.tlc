type Empty struct {}

func Empty::id(self this) i32 {
    return 7;
}

func Empty::bump(self *this) i32 {
    return 3;
}

type Marker trait {
    func id() i32;
}

func take(value Marker) i32 {
    return value.id();
}

func keep[T type](value T) T {
    return value;
}

type Hold struct {
    tag Empty;
    n i32;
}

extern type Plain struct {}

func main() i32 {
    var e Empty;
    if (sizeof(Empty) != 0 || sizeof(e) != 0) {
        return 1;
    }
    if (e.id() != 7 || e.bump() != 3) {
        return 2;
    }
    if (take(e) != 7) {
        return 3;
    }
    var again = keep(e);
    if (again.id() != 7 || sizeof(again) != 0) {
        return 5;
    }
    var hold Hold;
    hold.n = 40;
    if (sizeof(hold) != 4 || hold.n != 40 || hold.tag.id() != 7) {
        return 6;
    }
    if (sizeof(Plain) != 0) {
        return 7;
    }
    var row [2]Empty;
    if (sizeof(row) != 0) {
        return 8;
    }
    return 42;
}
