type Box[T type] struct { grid [2][2]T; }

func fill[T type](a T, b T, c T, d T) i32 {
    var g [2][2]T;
    g[0][0] = a;
    g[0][1] = b;
    g[1][0] = c;
    g[1][1] = d;
    return g[0][0][0] + g[1][1][1];
}

func flat[T type](a T, b T, c T, d T) i32 {
    var g [2][2]T;
    g[0][0] = a;
    g[0][1] = b;
    g[1][0] = c;
    g[1][1] = d;
    return g[0][0] + g[1][1];
}

func cube[T type](value T) i32 {
    var g [2][2][2]T;
    g[0][1][0] = value;
    return g[0][1][0][0] + g[0][1][0][1];
}

func make[T type](a T, b T, c T, d T) i32 {
    var box Box[T];
    box.grid[0][0] = a;
    box.grid[0][1] = b;
    box.grid[1][0] = c;
    box.grid[1][1] = d;
    return box.grid[0][0][0] + box.grid[1][1][1];
}

func give[T type](a T, b T, c T, d T) [2][2]T {
    var g [2][2]T;
    g[0][0] = a;
    g[0][1] = b;
    g[1][0] = c;
    g[1][1] = d;
    return g;
}

func take[T type](g [2][2]T) i32 {
    return g[0][0][0] + g[1][1][1];
}

func main() i32 {
    if (flat(40, 1, 2, 3) != 43) {
        return 1;
    }
    if (cube((40, 2)) != 42) {
        return 2;
    }
    if (make((40, 2), (1, 3), (4, 5), (6, 7)) != 47) {
        return 3;
    }
    if (take(give((40, 2), (1, 3), (4, 5), (6, 7))) != 47) {
        return 4;
    }
    return fill((40, 2), (1, 3), (4, 5), (6, 7));
}
