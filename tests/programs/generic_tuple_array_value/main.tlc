func pair[T type](a T, b T) [2]T {
    var row [2]T;
    row[0] = a;
    row[1] = b;
    return row;
}

func fill[T type](a T, b T, c T, d T) [2][2]T {
    var g [2][2]T;
    g[0][0] = a;
    g[0][1] = b;
    g[1][0] = c;
    g[1][1] = d;
    return g;
}

func id[T type](value T) i32 {
    return value[0][0] + value[1][1];
}

func wide[T type](value T) i32 {
    return value[0][0][0] + value[1][1][1];
}

func sum[T type](value T) i32 {
    return value[0] + value[1];
}

func flat[T type](value T) i32 {
    return value[0][0] + value[1][1];
}

func copy[T type](value T) i32 {
    var g T = value;
    return g[0][0] + g[1][1];
}

func give[T type](value T) T {
    return value;
}

func main() i32 {
    var nums [2]i32;
    nums[0] = 40;
    nums[1] = 2;
    if (sum(nums) != 42) {
        return 1;
    }
    var passed = give(nums);
    if (passed[0] + passed[1] != 42) {
        return 2;
    }
    var grid [2][2]i32;
    grid[0][0] = 40;
    grid[0][1] = 1;
    grid[1][0] = 2;
    grid[1][1] = 3;
    if (flat(grid) != 43) {
        return 3;
    }
    var g = fill((40, 2), (1, 3), (4, 5), (6, 7));
    if (wide(g) != 47) {
        return 4;
    }
    var deep = give(g);
    if (deep[0][0][0] + deep[1][1][1] != 47) {
        return 5;
    }
    var row = pair((40, 2), (1, 3));
    if (copy(row) != 43) {
        return 6;
    }
    var got = give(row);
    if (got[0][0] + got[1][1] != 43) {
        return 7;
    }
    return id(row);
}
