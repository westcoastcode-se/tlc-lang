type Inner struct {
    inner_value i32;
};

type Box struct {
    value i32;
    complex Inner;
};

var bias Box = {.value = 2};

func twenty() i32 {
    return 20;
}

func take(box Box) i32 {
    return box.value + box.complex.inner_value;
}

func made() Box {
    return {.value = 10, .complex = {.inner_value = 20}};
}

func main() i32 {
    var box Box = {.value = twenty(), .complex = {.inner_value=20}};
    if (box.value + box.complex.inner_value + bias.value != 42) {
        return 0;
    }
    if (take({.value = 22, 0...}) != 22) {
        return 0;
    }
    if (take({.complex = {.inner_value = 7}, .value = 3}) != 10) {
        return 0;
    }
    if (take(made()) != 30) {
        return 0;
    }
    box = {.complex = {.inner_value=42}, 0...};
    return box.value + box.complex.inner_value;
}
