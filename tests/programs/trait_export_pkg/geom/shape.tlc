package geom;

type Shape trait {
    func area() i32;
};

export func measure(s Shape) i32 {
    return s.area();
}

export func measure_at(s *Shape) i32 {
    return s.area();
}

export type Rect struct {
    export w i32;
};

export func Rect::paint(self *this, s Shape) i32 {
    return self.w + s.area();
}
