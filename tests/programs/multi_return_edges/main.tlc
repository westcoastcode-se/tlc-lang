var acc i32;
var slot i32;
var global_slot i32;

func put(n i32) void {
    acc = acc * 10 + n;
}

func add(x i32, y i32) (i32, i32) {
    return x + y, x;
}

func bump() i32 {
    slot = slot + 1;
    return slot;
}

func ordered() (i32, i32) {
    return bump(), bump();
}

func once() (i32, i32) {
    slot = slot + 1;
    return slot, slot * 10;
}

func observe() (i32, i32) {
    defer put(1);
    defer put(2);
    return acc, acc + 3;
}

func touch() (i32, i32) {
    acc = acc + 5;
    return 1, 2;
}

func blank() (i32, i32) {
    var unused i32 = 1;
}

func id(n i32) (i32) {
    return n;
}

func wrap() (u32, i32) {
    var n u32;
    n = 0;
    n = n - 1;
    return n, 1;
}

func big() (i64, i32) {
    var a i64;
    a = 100000;
    a = a * 100000;
    return a, 2;
}

func narrow() (i16, u8, bool) {
    return -2, 200, 4;
}

func pick(p *i32) (*i32, i32) {
    return p, 7;
}

func none() (?*i32, i32) {
    return null, 3;
}

type Point struct {
    x i32;
    y i32;
};

func make(n i32) (Point, i32) {
    var p Point;
    p.x = n;
    p.y = n + 1;
    return p, 2;
}

type Box struct {
    v i32;
    w i32;
};

func Box::both(self *this) (i32, i32) {
    return self.v, self.w;
}

static func hidden() (i32, i32) {
    return 40, 2;
}

func adjust(n i32) i32 {
    var p *i32 = &n;
    n, extra := add(n, 1);
    return *p + extra;
}

func shadow(n i32) i32 {
    var p *i32 = &n;
    {
        n, extra := add(1, 2);
    }
    return *p;
}

func set_outer(n i32) i32 {
    var extra i32 = 0;
    var p *i32 = &n;
    {
        n, extra = add(4, 1);
    }
    return *p + extra;
}

func mix(keep i32) i32 {
    var p *i32 = &keep;
    keep, fresh := add(keep, 2);
    return *p + fresh;
}

func read_global() i32 {
    return global_slot;
}

func hide(outer i32) i32 {
    func inner() i32 {
        outer, n := add(1, 2);
        return outer + n;
    }
    return inner() + outer;
}

func main() i32 {
    var q ?*i32;
    var n i32;
    var np ?*i32;
    var nn i32;
    var wide i64;
    var wk i32;
    var s i16;
    var ch u8;
    var flag bool;
    var point Point;
    var pk i32;
    var box Box;
    var left i32;
    var right i32;
    var h1 i32;
    var h2 i32;

    slot = 0;
    a, b := ordered();
    if (a != 1) {
        return 1;
    }
    if (b != 2) {
        return 2;
    }

    slot = 0;
    c, d := once();
    if (c != 1) {
        return 3;
    }
    if (d != 10) {
        return 4;
    }
    if (slot != 1) {
        return 5;
    }

    acc = 0;
    e, f := observe();
    if (e != 0) {
        return 6;
    }
    if (f != 3) {
        return 7;
    }
    if (acc != 21) {
        return 8;
    }

    g, h := blank();
    if (g != 0) {
        return 9;
    }
    if (h != 0) {
        return 10;
    }

    if (id(40) != 40) {
        return 11;
    }
    var single = id(6);
    other := 4;
    if (single + other != 10) {
        return 12;
    }

    u, k := wrap();
    if (u < 1) {
        return 13;
    }
    if (u + 2 + k != 2) {
        return 14;
    }

    wide, wk = big();
    if (wide / 100000 / 100000 + wk != 3) {
        return 15;
    }

    s, ch, flag = narrow();
    if (ch != 200) {
        return 16;
    }
    if (flag != 1) {
        return 17;
    }
    if (s != -2) {
        return 18;
    }

    var x i32 = 5;
    q, n = pick(&x);
    if (q == null) {
        return 19;
    }
    if (*q + n != 12) {
        return 20;
    }

    np, nn = none();
    if (np != null) {
        return 21;
    }
    if (nn != 3) {
        return 22;
    }

    point, pk = make(10);
    if (point.x + point.y + pk != 23) {
        return 23;
    }

    box.v = 8;
    box.w = 9;
    left, right = box.both();
    if (left + right != 17) {
        return 24;
    }

    if (adjust(10) != 21) {
        return 25;
    }
    if (shadow(10) != 10) {
        return 26;
    }
    if (set_outer(10) != 9) {
        return 27;
    }
    if (mix(6) != 14) {
        return 28;
    }

    global_slot = 7;
    global_slot, extra := add(3, 1);
    if (read_global() + extra != 10) {
        return 29;
    }
    extra, single = add(0, 0);
    if (extra != 0) {
        return 30;
    }
    if (single != 0) {
        return 31;
    }

    if (hide(10) != 14) {
        return 32;
    }

    h1, h2 = hidden();
    if (h1 + h2 != 42) {
        return 33;
    }

    acc = 1;
    {
        defer touch();
    }
    if (acc != 6) {
        return 34;
    }
    return 42;
}
