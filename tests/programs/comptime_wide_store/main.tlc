// `x = x + 1i64` in a comptime body stores the low 32 bits into the `i32`. The eight-byte store overwrote
// the evaluator's frame and crashed the compiler.
comptime func add(n i32) i32 {
    var x = n;
    var i = 0;
    while (i < 3) {
        x = x + 4294967297i64;
        i = i + 1;
    }
    return x;
}

const k = add(39);

func main() i32 {
    return k;
}
