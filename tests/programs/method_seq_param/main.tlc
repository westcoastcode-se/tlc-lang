type Seq[T type] trait {
    func at(i i32) T;
};

type Bag struct {
    n i32;
};

func Bag::at(self this, i i32) i32 {
    return self.n + i;
}

func Bag::read[T type](self *this, items Seq[T]) i32 {
    return items.at(2);
}

func main() i32 {
    var bag Bag;
    bag.n = 40;
    return bag.read(bag);
}
