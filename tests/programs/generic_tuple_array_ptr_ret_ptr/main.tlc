func pair[T type](a T, b T) [2]T {
    var row [2]T;
    row[0] = a;
    row[1] = b;
    return row;
}

func fill[T type](a T, b T, c T, d T) [2][2]T {
    var g [2][2]T;
    g[0][0] = a;
    g[0][1] = b;
    g[1][0] = c;
    g[1][1] = d;
    return g;
}

func plain[T type](value **T) **T {
    return value;
}

func id[T type](value **T) **T {
    return value;
}

func wide[T type](value **T) **T {
    return value;
}

func tri[T type](value ***T) ***T {
    return value;
}

func main() i32 {
    var one = (40, 2);
    var tp = &one;
    if ((**plain(&tp))[0] + (**plain(&tp))[1] != 42) {
        return 1;
    }
    var g = fill((40, 2), (1, 3), (4, 5), (6, 7));
    var gp = &g;
    if ((**wide(&gp))[0][0][0] + (**wide(&gp))[1][1][1] != 47) {
        return 2;
    }
    var row = pair((40, 2), (1, 3));
    var p = &row;
    var pp = &p;
    if ((***tri(&pp))[0][0] + (***tri(&pp))[1][1] != 43) {
        return 3;
    }
    var q = id(&p);
    return (**q)[0][0] + (**q)[1][1];
}
