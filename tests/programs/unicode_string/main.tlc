import "std/string";

func main() i32 {
    var text string.string_view = "héllo";
    if (text.len() != 5) {
        return 1;
    }
    if (text.bytes.len() != 6) {
        return 2;
    }
    if (!text.equals("héllo")) {
        return 3;
    }
    var bytes string.byte_string_view = "héllo"b;
    if (bytes.len() != 6) {
        return 4;
    }
    var ch = 'A';
    var raw u8 = 'A'b;
    if (ch != 65 || sizeof(raw) != 1) {
        return 5;
    }
    return 0;
}
