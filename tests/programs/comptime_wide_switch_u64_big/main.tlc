func u64s() i32 {
    comptime const n = 3000000000u64;
    comptime switch (n) {
    case 3000000000u64:
        return 14;
    default:
        return 0;
    }
}

func u32s() i32 {
    comptime const n = 3000000000u32;
    comptime switch (n) {
    case 3000000000u32:
        return 14;
    default:
        return 0;
    }
}

func negs() i32 {
    comptime const n = -3000000000;
    comptime switch (n) {
    case -3000000000:
        return 14;
    default:
        return 0;
    }
}

func main() i32 {
    return u64s() + u32s() + negs();
}
