type Point struct {
    x i32;
    y i32;
}

type Duo (i32, i32);

func sum(t (i32, i32)) i32 {
    return t[0] + t[1];
}

func duo(t Duo) i32 {
    return t[0] + t[1];
}

func nest(t ((i32, i32), i32)) i32 {
    return t[0][0] + t[0][1] + t[1];
}

func axis(t (Point, i32)) i32 {
    return t[0].x + t[0].y + t[1];
}

func bump(t ([4]i32, i32)) i32 {
    t[0][0] = t[0][0] + t[1];
    return t[0][0];
}

func main() i32 {
    if (sum((40, 2)) != 42) {
        return 1;
    }
    var op func ((i32, i32)) i32 = sum;
    if (op((40, 2)) != 42) {
        return 2;
    }
    var local = (40, 2);
    if (sum(local) != 42) {
        return 3;
    }
    local[0] = 10;
    if (sum(local) != 12) {
        return 9;
    }
    var step = (40, 2);
    var total = 0;
    for (var i i32 = 0; i < 2; i = i + 1) {
        total = total + sum(step);
        step[0] = step[0] + 1;
    }
    if (total != 85) {
        return 10;
    }
    if (duo(Duo((20, 22))) != 42) {
        return 4;
    }
    if (nest(((20, 20), 2)) != 42) {
        return 5;
    }
    var point Point;
    point.x = 20;
    point.y = 20;
    if (axis((point, 2)) != 42) {
        return 6;
    }
    var row [4]i32 = {40, 0, 0, 0};
    if (bump((row, 2)) != 42 || row[0] != 42) {
        return 7;
    }
    return 42;
}
