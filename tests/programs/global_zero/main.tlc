// A file-scope value, field, or element with no value is zero, not undef. -O2 must not read garbage.
type Point struct {
    x i32;
    y i32;
};

type Holder struct {
    n i32;
    raw [4]i32;
};

var h i32;
var w u64;
var f f64;
var b bool;
var p ?*i32;
var s []i32;
var pt Point = {.x = 1};
var held Holder = {.n = 1};
var short Holder = {.n = 1, .raw = {4}};
var row [4]i32 = {1, 2};
var grid [2][3]i32 = {{1}, {2, 3}};

func main() i32 {
    if (h != 0 || w != 0u64 || f != 0.0 || b || p != null || s.len != 0) {
        return 1;
    }
    if (pt.y != 0 || held.raw[3] != 0 || short.raw[0] != 4 || short.raw[3] != 0) {
        return 2;
    }
    if (row[1] != 2 || row[3] != 0 || grid[0][2] != 0 || grid[1][1] != 3 || grid[1][2] != 0) {
        return 3;
    }
    return 42;
}
