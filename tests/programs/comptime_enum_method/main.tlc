type Order enum {
    relaxed,
    acquire,
};

type Point struct {
    x i32;
};

func Point::id(self *this, order comptime Order) i32 {
    if (order == Order.acquire) {
        return self.x + 41;
    }
    return self.x;
}

func main() i32 {
    var p Point;
    p.x = 1;
    return p.id(Order.acquire);
}
