func main() i32 {
    var items [4]i32;
    items[0] = 40;
    var row = [_]i32{2};
    var slice []i32 = row;
    var a = 0;
    var b = 0;
    for (var p : ptr_of(items)) {
        a = *p;
        break;
    }
    for (var p : ptr_of(slice)) {
        b = *p;
        break;
    }
    return a + b;
}
