var acc i32;

func put(n i32) void {
    acc = acc * 3 + n;
}

type Box struct {
    v i32;
    w i32;
};

func Box::put(self this, n i32) void {
    acc = acc * 3 + self.v + n;
}

func Box::touch(self *this) void {
    acc = acc + self.w;
}

func main() i32 {
    acc = acc + func() i32 {
        return 0;
    }();
    func inner(n i32) void {
        acc = acc * 3 + n;
    }
    {
        defer func() {
        }();
        var arg i32 = 1;
        defer func(v i32) {
            acc = acc * 3 + v;
        }(arg);
        arg = 4;
        var box Box;
        box.v = 1;
        box.w = 3;
        defer box.put(0);
        defer box.touch();
        box.v = 4;
        box.w = 0;
        defer inner(2);
        if (false) {
            defer put(2);
        }
        for (var k i32 = 0; k < 1; k = k + 1) {
            defer put(1);
            continue;
        }
        var i i32 = 0;
        while (i < 1) {
            defer put(2);
            i = 1;
            break;
        }
    }
    defer put(0);
    return acc;
}
