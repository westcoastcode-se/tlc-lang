import "builtin";

type Arena struct {
    bytes [64]u8;
    used i32;
};

unsafe func Arena::malloc(self *this, size i32, align i32) ?*u8 {
    _ = align;
    if (size < 1 || self.used + size > 64) {
        return null;
    }
    var start = self.used;
    self.used = self.used + size;
    return ?*u8(&self.bytes[start]);
}

func Arena::free(self *this, ptr *u8) void {
    _ = ptr;
}

unsafe func Arena::realloc(self *this, ptr *u8, size i32, align i32) ?*u8 {
    _ = ptr;
    return self.malloc(size, align);
}

func main() i32 {
    var arena Arena;
    arena.used = 0;
    var one = arena.alloc[i32]();
    *one = 20;
    var again = arena.realloc[i32](one);
    *again = 40;
    var buf = arena.alloc[i32](1);
    buf[0] = 2;
    var grown = arena.realloc[i32](buf, 1);
    grown[0] = 2;
    return *again + grown[0];
}
