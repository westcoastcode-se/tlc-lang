func num[T type](value **T) i32 {
    return **value;
}

func at[T type](value **T) i32 {
    return (**value)[0];
}

func id[T type](value **T) i32 {
    return (**value)[0] + (**value)[1];
}

func deep[T type](value **T) i32 {
    return (**value)[0][0] + (**value)[1];
}

func main() i32 {
    var n = 40;
    var np = &n;
    if (num(&np) != 40) {
        return 1;
    }
    var nums [4]i32;
    nums[0] = 40;
    var ap = &nums;
    if (at(&ap) != 40) {
        return 2;
    }
    var wide = ((40, 2), 1);
    var wp = &wide;
    if (deep(&wp) != 41) {
        return 3;
    }
    var row = (40, 2);
    var p = &row;
    return id(&p);
}
