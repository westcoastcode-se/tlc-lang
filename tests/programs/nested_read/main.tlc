func inc(n i32) i32 {
    return n + 1;
}

func main() i32 {
    const n = 40;
    func add(b i32) i32 {
        return n + b;
    }
    comptime const m = 20;
    func addm(b i32) i32 {
        return m + b;
    }
    const t = (40, 2);
    func both() i32 {
        return t[0] + t[1];
    }
    const fp = inc;
    func pass() i32 {
        return fp(41);
    }
    if (add(2) != 42) {
        return 1;
    }
    if (addm(22) != 42) {
        return 2;
    }
    if (both() != 42) {
        return 3;
    }
    if (pass() != 42) {
        return 4;
    }
    return 42;
}
