func outer(n i32) i32 {
    func add(b i32) i32 {
        return n + b;
    }
    return add(2);
}

func nest(n i32) i32 {
    func mid() i32 {
        func inner() i32 {
            return n;
        }
        return inner();
    }
    return mid();
}

func main() i32 {
    var n = 40;
    func add(b i32) i32 {
        return n + b;
    }
    var a = 20;
    var b = 22;
    func sum() i32 {
        return a + b;
    }
    if (add(2) != 42) {
        return 1;
    }
    if (outer(40) != 42) {
        return 2;
    }
    if (nest(7) != 7) {
        return 3;
    }
    if (sum() != 42) {
        return 4;
    }
    return 42;
}
