import "math";

export type Local struct {
    x i32;
};

var g math.Vec[i32];

func read(v math.Vec[i32]) i32 {
    return v.n;
}

func make() math.Vec[i32] {
    var v math.Vec[i32];
    v.n = 30;
    return v;
}

func main() i32 {
    var v math.Vec[i32] = make();
    var again math.Vec[i32];
    again.n = v.n;
    g.n = 1;
    var ptr *math.Vec[i32] = &v;
    var buf math.Buf[4, i32];
    buf.n = 2;
    var nested math.Vec[math.Point];
    nested.n.x = 7;
    var wide math.Vec[math.Buf[4, i32]];
    wide.n.n = 5;
    var local math.Vec[Local];
    local.n.x = 3;
    return read(v) + again.n + ptr.n + g.n + buf.n + nested.n.x + wide.n.n + local.n.x - 108;
}
