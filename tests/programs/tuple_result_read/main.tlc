func pair() ((i32, i32)) {
    return (40, 2);
}

func main() i32 {
    var value = pair();
    if (value[0] + value[1] != 42) {
        return 1;
    }
    value[0] = 10;
    if (value[0] + value[1] != 12) {
        return 2;
    }
    var p = &value;
    (*p)[1] = 30;
    if (value[0] + value[1] != 40) {
        return 3;
    }
    var total = 0;
    var step = pair();
    for (var i i32 = 0; i < 2; i = i + 1) {
        total = total + step[0];
        step[0] = step[0] + 1;
    }
    if (total != 81) {
        return 4;
    }
    return 42;
}
