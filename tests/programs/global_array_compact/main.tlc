// A short list in a large file-scope array is the list and one zero tail. The listed elements, the
// zeros after them, nested rows, a `const`, and a copy of the array all read as the list says.
var flat [200000]i32 = {1, 2, 3};
var grid [3][100000]i32 = {{5, 6}, {7}};
const frozen [10000]u8 = {9, 0...};
var copy = grid;

func main() i32 {
    var bad = 0;
    if (flat[0] != 1 || flat[2] != 3 || flat[3] != 0 || flat[199999] != 0) {
        bad |= 1;
    }
    if (grid[0][1] != 6 || grid[1][0] != 7 || grid[1][1] != 0 || grid[2][99999] != 0) {
        bad |= 2;
    }
    if (frozen[0] != 9u8 || frozen[9999] != 0u8) {
        bad |= 4;
    }
    if (copy[0][0] != 5 || copy[1][0] != 7 || copy[2][0] != 0) {
        bad |= 8;
    }
    flat[199999] = 40;
    copy[2][5] = 2;
    return bad == 0 ? flat[199999] + copy[2][5] : bad;
}
