type Point struct {
    x i32;
    y i32;
};

func mid(p *[4]i32) i32 {
    var s = p[1:3];
    return s[0] + s[1] + s.len;
}

func whole(p *[4]i32) i32 {
    var s = p[:];
    return s[0] + s[3] + s.len;
}

func tail(p *[4]i32) i32 {
    var s = p[2:];
    return s[0] + s.len;
}

func head(p *[4]i32) i32 {
    var s = p[:1];
    return s[0] + s.len;
}

func star(p *[4]i32) i32 {
    var a = (*p)[1:3];
    var b = (*p)[:];
    var c = (*p)[1:];
    var d = (*p)[:2];
    return a[0] + a[1] + b.len + c.len + d[1];
}

func rows(p *[2][3]i32) i32 {
    var view = p[0:2];
    var rest = (*p)[1:];
    return view.len + view[1][0] + rest.len + rest[0][2];
}

func runtime(p *[4]i32, i i32) i32 {
    var s = p[i:];
    return s[0] * 10 + s.len;
}

func live() i32 {
    var row = [_]i32{1, 2, 3, 4};
    var s = (&row)[1:3];
    row[1] = 7;
    return s[0];
}

func narrowed(opt ?*[4]i32) i32 {
    if (opt == null) {
        return 0;
    }
    return opt[:][3];
}

func frozen(p *const [4]i32) i32 {
    return p[1:3][0];
}

func from_local() i32 {
    var row = [_]i32{1, 2, 3, 4};
    return (&row)[1:3][1] + (&row)[:].len;
}

func from_new() i32 {
    var buf = new [_]i32{1, 2, 3, 4};
    var n = buf[1:3][0] + buf[:].len;
    delete buf;
    return n;
}

func ptrs(p *[2]*i32) i32 {
    var s = p[:];
    var t = (*p)[1:];
    return *s[0] + *s[1] + t.len + *t[0];
}

func points(p *[2]Point) i32 {
    var s = p[1:];
    return s[0].y + s.len;
}

func elem(p *[4]i32) i32 {
    return p[2] + (*p).len;
}

func headers(p *[2][]i32) i32 {
    var s = p[:];
    var t = (*p)[1:];
    return s[1][0] + t[0][1] + (*p)[1:][0][1] + s.len + t.len;
}

func viewed(p *[4]i32) i32 {
    var s []i32 = *p;
    return s[0] + s[3] + s.len;
}

func main() i32 {
    var row = [_]i32{1, 2, 3, 4};
    var grid = [_][3]i32{{1, 2, 3}, {4, 5, 6}};
    var a i32 = 8;
    var b i32 = 9;
    var ps = [_]*i32{&a, &b};
    var spots = [_]Point{Point{.x = 1, .y = 2}, Point{.x = 3, .y = 6}};
    var left = [_]i32{1, 2};
    var right = [_]i32{3, 4};
    var table = [_][]i32{left[:], right[:]};
    var opt ?*[4]i32 = null;
    return mid(&row) + whole(&row) + tail(&row) + head(&row) + star(&row) + rows(&grid) + runtime(&row, 1) +
        live() + narrowed(opt) + frozen(&row) + from_local() + from_new() + ptrs(&ps) +
        points(&spots) + elem(&row) + headers(&table) + viewed(&row);
}
