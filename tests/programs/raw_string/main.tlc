func main() int {
    char *text = `hello
world`;
    if (text[0] != 'h' || text[5] != '\n' || text[6] != 'w' || text[11] != 0) {
        return 1;
    }
    char *raw = `a\n"b`;
    if (raw[0] != 'a' || raw[1] != '\\' || raw[2] != 'n' || raw[3] != '"' || raw[4] != 'b' || raw[5] != 0) {
        return 2;
    }
    return 42;
}
