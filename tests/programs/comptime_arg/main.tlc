extern(abi="c") func printf(fmt *const u8, ...) i32;

comptime const label = "Per"b;

macro func hello(comptime name []const u8, tail []const u8, comptime n i32) void {
    emit printf("Hello %s %s %d\n"b, name, tail, n);
}

func main() i32 {
    var tail = "Ada"b;
    hello(label, tail, 40 + 2);
    return 0;
}
