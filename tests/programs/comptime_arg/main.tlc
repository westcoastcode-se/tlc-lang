extern(abi="c") func printf(fmt *const u8, ...) i32;

const label = "Per";

macro func hello(name comptime []const u8, tail []const u8, n comptime i32) void {
    emit printf("Hello %s %s %d\n", name, tail, n);
}

func main() i32 {
    var tail = "Ada";
    hello(label, tail, 40 + 2);
    return 0;
}
