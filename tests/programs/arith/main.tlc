func main() int {
    int a = 1 + 2 * 3;
    int b = -4;
    int c = 10 % 4;
    int d = 2147483647 + 1;
    if (a != 7) return 1;
    if (b != -4) return 2;
    if (c != 2) return 3;
    if (d + 1 != -2147483647) return 4;
    if ((6 & 3) != 2) return 5;
    if ((1 | 2) != 3) return 6;
    if ((1 ^ 3) != 2) return 7;
    if ((1 << 3) != 8) return 8;
    if ((8 >> 2) != 2) return 9;
    if (~0 != -1) return 10;
    if (!0 != 1) return 11;
    if (!2 != 0) return 12;
    return 42;
}
