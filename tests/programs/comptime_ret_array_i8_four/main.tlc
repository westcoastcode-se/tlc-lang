comptime func still() [2][2][2][2]i8 {
    return [_][2][2][2]i8{{{{40i8, 2i8}, {1i8, 0i8}}, {{3i8, 4i8}, {5i8, 6i8}}},
                          {{{7i8, 8i8}, {9i8, 10i8}}, {{11i8, 12i8}, {13i8, 14i8}}}};
}

comptime func deep(n i32) [2][2][2][2]i8 {
    var a = n;
    return [_][2][2][2]i8{{{{i8(a), 2i8}, {1i8, 0i8}}, {{3i8, 4i8}, {5i8, 6i8}}},
                          {{{7i8, 8i8}, {9i8, 10i8}}, {{11i8, 12i8}, {13i8, 14i8}}}};
}

func main() i32 {
    var c = deep(40);
    var h = still();
    if (c[0][0][0][0] + c[0][0][0][1] == 42i8 && h[0][0][0][0] == 40i8) {
        return 42;
    }
    return 0;
}
