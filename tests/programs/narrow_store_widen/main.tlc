// A store into a narrowed name is checked against the declared `?*Node`. `p = p.next` walks a list.
// A `*Node` store keeps the narrowing, and a `for` step sees the name narrowed by the condition.
type Node struct {
    next ?*Node;
    v i32;
};

func main() i32 {
    var c Node = {.next = null, .v = 30};
    var b Node = {.next = &c, .v = 2};
    var a Node = {.next = &b, .v = 1};
    var sum = 0;
    var p ?*Node = &a;
    while (p != null) {
        sum += p.v;
        p = p.next;
    }
    for (var q ?*Node = &a; q != null; q = q.next) {
        sum += q.v;
    }
    var r ?*Node = &a;
    if (r != null) {
        r = &b;
        sum += r.v;
        r = r.next;
        if (r != null) {
            sum -= r.v;
        }
    }
    return sum - 25;
}
