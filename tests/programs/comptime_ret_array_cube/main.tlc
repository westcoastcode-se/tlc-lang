comptime func still() [2][2][2]i32 {
    return [_][2][2]i32{{{40, 1}, {2, 0}}, {{3, 4}, {5, 6}}};
}

comptime func cube(n i32) [2][2][2]i32 {
    var a = n;
    return [_][2][2]i32{{{a, 1}, {2, 0}}, {{3, 4}, {5, 6}}};
}

comptime func wide(n i32) [2][2][2]f64 {
    var a = n;
    return [_][2][2]f64{{{f64(a), 1.0}, {2.0, 0.0}}, {{3.0, 4.0}, {5.0, 6.0}}};
}

func main() i32 {
    var c = cube(40);
    var h = still();
    var f = wide(40);
    if (c[0][0][0] + c[0][1][0] == 42 && h[0][0][0] == 40 && f[0][0][0] == 40.0) {
        return 42;
    }
    return 0;
}
