// A comptime call that reads a global set at start would read 0. The read is reported with the call chain.
type H struct {
    tag i32;
}

func make() H {
    return H{.tag = 30};
}

var h = make();

comptime func peek() i32 {
    return h.tag;
}

func main() i32 {
    comptime const a = peek();
    return a;
}
