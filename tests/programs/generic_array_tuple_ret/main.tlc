func pair[T type](a T, b T) [2]T {
    var row [2]T;
    row[0] = a;
    row[1] = b;
    return row;
}

func main() i32 {
    var one = (40, 2);
    var two = (1, 3);
    var deep = ((40, 2), 1);
    var other = ((3, 4), 5);
    var got = pair(one, two);
    var wide = pair(deep, other);
    if (wide[0][0][0] + wide[1][1] != 45) {
        return 1;
    }
    if (pair(40, 2)[0] + pair(40, 2)[1] != 42) {
        return 2;
    }
    return got[0][0] + got[1][1];
}
