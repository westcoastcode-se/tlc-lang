type ShapeType enum {
    Circle,
    Rectangle,
}

type Shape union(ShapeType) {
    Circle struct {
        radius i32;
    };
    Rectangle struct {
        width i32;
        height i32;
    };
}

type Circle struct {
    radius i32;
}

type Rectangle struct {
    width i32;
    height i32;
}

type Named union(ShapeType) {
    Circle Circle;
    Rectangle Rectangle;
}

type Kind enum {
    A = 2,
    B,
}

type One struct {
    n i32;
}

type Two struct {
    n i32;
}

type Pick union(Kind) {
    A One;
    B Two;
}

type WideKind enum {
    A,
    B,
}

type WideA struct {
    n i64;
}

type WideB struct {
    n i64;
}

type Wide union(WideKind) {
    A WideA;
    B WideB;
}

var g Shape = {.Rectangle = {.width = 4, .height = 5}};

func main() i32 {
    var s Shape = {.Circle = {.radius = 1}};
    if (ShapeType(s) != ShapeType.Circle || s.Circle.radius != 1) {
        return 1;
    }
    var p *Shape = &s;
    p.Rectangle.width = 20;
    p.Rectangle.height = 22;
    if (ShapeType(s) != ShapeType.Rectangle || s.Rectangle.width != 20 || s.Rectangle.height != 22) {
        return 2;
    }
    var n Named;
    n.Circle.radius = 7;
    if (ShapeType(n) != ShapeType.Circle || n.Circle.radius != 7 || n.Rectangle.width != 7) {
        return 3;
    }
    if (sizeof(Shape) != 12 || sizeof(Named) != 12 || sizeof(Wide) != 16) {
        return sizeof(Shape);
    }
    if (ShapeType(g) != ShapeType.Rectangle || g.Rectangle.width != 4 || g.Rectangle.height != 5) {
        return 4;
    }
    var pick Pick = {.B = {.n = 9}};
    if (Kind(pick) != Kind.B || pick.B.n != 9) {
        return 5;
    }
    var wide Wide = {.A = {.n = 40}};
    if (WideKind(wide) != WideKind.A || wide.A.n != 40) {
        return 6;
    }
    // The payload is at offset 0. The enum tag is stored after it.
    var placed Shape = {.Rectangle = {.width = 0, .height = 0}};
    var raw *u8 = *u8(&placed);
    if (raw[0] != 0 || raw[4] != 0 || raw[8] != 1 || raw[9] != 0 || raw[10] != 0 || raw[11] != 0) {
        return 7;
    }
    var wide_b Wide = {.B = {.n = 0}};
    var wide_raw *u8 = *u8(&wide_b);
    if (wide_raw[0] != 0 || wide_raw[8] != 1 || wide_raw[9] != 0 || wide_raw[10] != 0 || wide_raw[11] != 0) {
        return 8;
    }
    var pick_b Pick = {.B = {.n = 0}};
    var pick_raw *u8 = *u8(&pick_b);
    if (pick_raw[0] != 0 || pick_raw[4] != 3 || pick_raw[5] != 0 || pick_raw[6] != 0 || pick_raw[7] != 0) {
        return 9;
    }
    return s.Rectangle.width + s.Rectangle.height;
}
