func num[T type](value **T) **T {
    return value;
}

func id[T type](value **T) **T {
    return value;
}

func deep[T type](value **T) **T {
    return value;
}

func tri[T type](value ***T) ***T {
    return value;
}

func main() i32 {
    var n = 40;
    var np = &n;
    if (**num(&np) != 40) {
        return 1;
    }
    var wide = ((40, 2), 1);
    var wp = &wide;
    if ((**deep(&wp))[0][0] + (**deep(&wp))[1] != 41) {
        return 2;
    }
    var row = (40, 2);
    var p = &row;
    var pp = &p;
    if ((***tri(&pp))[0] + (***tri(&pp))[1] != 42) {
        return 3;
    }
    var q = id(&p);
    return (**q)[0] + (**q)[1];
}
