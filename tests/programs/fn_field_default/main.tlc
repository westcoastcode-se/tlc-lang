func add(a i32, b i32) i32 {
    return a + b;
}

func sub(a i32, b i32) i32 {
    return a - b;
}

type Box struct {
    op func (i32, i32) i32 = add;
};

var global Box;

func main() i32 {
    var bare Box;
    var named = Box{.op = sub};
    var zero = Box{0...};
    var heap *Box = new Box;
    if (bare.op(40, 2) != 42 || named.op(40, 2) != 38 || global.op(20, 22) != 42 || heap.op(11, 31) != 42) {
        return 1;
    }
    if (zero.op != null) {
        return 2;
    }
    delete heap;
    return bare.op(40, 2);
}
