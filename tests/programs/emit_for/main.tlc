macro func add_all(items *const i32, n i32, total *i32) void {
    emit for (var i = 0; i < n; i = i + 1) {
        *total = *total + items[i];
    }
}

func main() i32 {
    var items [3]i32;
    items[0] = 1;
    items[1] = 2;
    items[2] = 4;
    var total = 0;
    var n = 3;
    add_all(items, n, &total);
    return total;
}
