macro func add_all(items []const i32, total *i32) void {
    emit for (var i = 0; i < items.len; i = i + 1) {
        *total = *total + items[i];
    }
}

func main() i32 {
    var items [3]i32;
    items[0] = 1;
    items[1] = 2;
    items[2] = 4;
    var total = 0;
    add_all(items[:], &total);
    return total;
}
