func pair[T type](a T, b T) [2]T {
    var row [2]T;
    row[0] = a;
    row[1] = b;
    return row;
}

func fill[T type](a T, b T, c T, d T) [2][2]T {
    var g [2][2]T;
    g[0][0] = a;
    g[0][1] = b;
    g[1][0] = c;
    g[1][1] = d;
    return g;
}

func read[T type](value *T, present bool) i32 {
    var q ?*T = null;
    if (present) {
        q = ?*T(value);
    }
    if (q == null) {
        return 0;
    }
    return (*q)[0][0] + (*q)[1][1];
}

func wide[T type](value *T) i32 {
    var q ?*T = ?*T(value);
    if (q == null) {
        return 0;
    }
    return (*q)[0][0][0] + (*q)[1][1][1];
}

func plain[T type](value *T) i32 {
    var q ?*T = ?*T(value);
    if (q == null) {
        return 0;
    }
    return (*q)[0] + (*q)[1];
}

func main() i32 {
    var one = (40, 2);
    if (plain(&one) != 42) {
        return 1;
    }
    var g = fill((40, 2), (1, 3), (4, 5), (6, 7));
    if (wide(&g) != 47) {
        return 2;
    }
    var row = pair((40, 2), (1, 3));
    if (read(&row, false) != 0) {
        return 3;
    }
    return read(&row, true);
}
