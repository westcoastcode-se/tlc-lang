func add(n i32) i32 {
    return n + 1;
}

type Proc func () void;

type Op func (i32) i32;

func get(name *const u8) Proc {
    return Proc(add);
}

func get_raw(name *const u8) *void {
    return *void(add);
}

func main() i32 {
    var named = Op(get("add"b));
    var raw = func (i32) i32(get_raw("add"b));
    return named(10) + raw(10) + Op(get("add"b))(19);
}
