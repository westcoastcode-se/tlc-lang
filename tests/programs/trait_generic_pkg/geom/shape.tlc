package geom;

type Shape trait {
    func area() i32;
};

export type Box struct {
    export n i32;
};

export func Box::area(self this) i32 {
    return self.n;
}

export func measure[T Shape](value T) i32 {
    return value.area();
}

export func measure_at[T Shape](value *T) i32 {
    return value.area();
}
