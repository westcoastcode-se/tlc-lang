// `comptime const` of a `comptime func` keeps the result type: `bool`, an enumerator, `f64`, and `f32`.
type Order enum { low, mid, high }

comptime func yes() bool {
    return true;
}

comptime func pick() Order {
    return Order.high;
}

comptime func rank(o Order) i32 {
    if (o == Order.high) {
        return 2;
    }
    return 0;
}

comptime func bias(n i32) f64 {
    var x = 0.5;
    for (i := 0; i < n; i++) {
        x = x + 1.0;
    }
    return x;
}

comptime func narrow() f32 {
    return 1.5f;
}

comptime const on = yes();
comptime const off = !on;
comptime const less = 1 < 2;
comptime const typed bool = true;
comptime const order = pick();
comptime const middle = Order.mid;
comptime const wide = bias(2);
comptime const twice = wide * 2.0;
comptime const small = narrow();
const sum = bias(3) + 1.0;

func take(flag bool) i32 {
    if (flag) {
        return 1;
    }
    return 0;
}

func main() i32 {
    var r = 4;
    // `bool` names: a condition, an argument, and `comptime if`.
    if (on && !off && less && typed) {
        r = r + 1;
    }
    r = r + take(on);
    comptime if (on) {
        r = r + 1;
    }
    // Enumerators: a comparison, a `comptime func` argument, and `comptime if`.
    if (order == Order.high && middle == Order.mid) {
        r = r + 1;
    }
    r = r + rank(order);
    comptime if (order == Order.high) {
        r = r + 1;
    }
    // Floats: 2.5, 5.0, 1.5, and 4.5.
    comptime const local = bias(1);
    r = r + i32(wide * 4.0) + i32(twice) + i32(small * 2.0f) + i32(sum * 2.0) + i32(local * 2.0);
    comptime if (twice == 5.0) {
        r = r + 1;
    }
    return r;
}
