func pair[T type](a T, b T) [2]T {
    var row [2]T;
    row[0] = a;
    row[1] = b;
    return row;
}

func id[T type](value *const *T) i32 {
    var other = pair((1, 2), (3, 4));
    *value = &other;
    return (**value)[0][0];
}

func main() i32 {
    var row = pair((40, 2), (1, 3));
    var p = &row;
    return id(&p);
}
