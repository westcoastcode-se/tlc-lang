struct Point {
    x int;
    y int;
};

typedef *Point Ptr;
typedef int Integer;
typedef int Pair[2];

func make(x int, y int) Point {
    var p Point;
    p.x = x;
    p.y = y;
    return p;
}

func sum(p Point) int {
    return p.x + p.y;
}

func main() int {
    var p Point;
    var q Ptr;
    var bias Integer;
    var extra Pair;
    p = make(40, 2);
    q = &p;
    bias = 0;
    extra[0] = 0;
    extra[1] = 0;
    return sum(*q) + bias + extra[0];
}
