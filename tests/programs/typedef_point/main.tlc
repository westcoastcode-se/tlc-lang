type Point struct {
    x i32;
    y i32;
};

type Ptr *Point;
type Integer i32;
type Pair [2]i32;

func make(x i32, y i32) Point {
    var p Point;
    p.x = x;
    p.y = y;
    return p;
}

func sum(p Point) i32 {
    return p.x + p.y;
}

func main() i32 {
    var p Point;
    var bias Integer;
    var extra Pair;
    p = make(40, 2);
    var q Ptr = &p;
    bias = 0;
    extra[0] = 0;
    extra[1] = 0;
    return sum(*q) + bias + extra[0];
}
