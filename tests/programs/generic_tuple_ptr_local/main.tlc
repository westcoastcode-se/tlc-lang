func num[T type](value **T) i32 {
    var q **T = value;
    return **q;
}

func id[T type](value **T) i32 {
    var q **T = value;
    return (**q)[0] + (**q)[1];
}

func deep[T type](value **T) i32 {
    var q **T = value;
    return (**q)[0][0] + (**q)[1];
}

func tri[T type](value ***T) i32 {
    var q ***T = value;
    return (***q)[0] + (***q)[1];
}

func main() i32 {
    var n = 40;
    var np = &n;
    if (num(&np) != 40) {
        return 1;
    }
    var wide = ((40, 2), 1);
    var wp = &wide;
    if (deep(&wp) != 41) {
        return 2;
    }
    var row = (40, 2);
    var p = &row;
    var pp = &p;
    if (tri(&pp) != 42) {
        return 3;
    }
    return id(&p);
}
