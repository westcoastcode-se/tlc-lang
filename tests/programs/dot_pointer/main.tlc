type Point struct {
    x int;
    y int;
};

func Point::sum(self this) int {
    return self.x + self.y;
}

func Point::add(self *this, dx int, dy int) void {
    self.x = self.x + dx;
    self.y = self.y + dy;
}

func main() int {
    var p Point;
    p.x = 0;
    p.y = 0;
    var q *Point = &p;
    q.x = 1;
    q.y = 1;
    q.add(10, 10);
    p.add(10, 10);
    return q.sum();
}
