type Point struct {
    x i32;
    y i32;
};

func Point::sum(self this) i32 {
    return self.x + self.y;
}

func Point::add(self *this, dx i32, dy i32) void {
    self.x = self.x + dx;
    self.y = self.y + dy;
}

func main() i32 {
    var p Point;
    p.x = 0;
    p.y = 0;
    var q *Point = &p;
    q.x = 1;
    q.y = 1;
    q.add(10, 10);
    p.add(10, 10);
    return q.sum();
}
