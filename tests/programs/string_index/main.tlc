func tail() []const u8 {
    return "hello"[1:];
}

func at(text []const u8) i32 {
    if (text.len != 4 || text[0] != 'e' || text[3] != 'o') {
        return 1;
    }
    return 0;
}

func main() i32 {
    if ("hello"[0] != 'h' || "hello"[1] != 'e' || "hello"[4] != 'o') {
        return 1;
    }
    var i i32 = 1;
    if ("hello"[i] != 'e') {
        return 2;
    }
    if ("hello"[1:][0] != 'e' || "hello"[1:].len != 4 || "hello"[1:][3] != 'o') {
        return 3;
    }
    if ("hello"[1:4][0] != 'e' || "hello"[1:4].len != 3 || "hello"[1:4][2] != 'l') {
        return 4;
    }
    if ("hello"[:2][0] != 'h' || "hello"[:2][1] != 'e' || "hello"[:2].len != 2) {
        return 5;
    }
    if ("hello"[:][1] != 'e' || "hello"[:].len != 5 || ""[:].len != 0) {
        return 6;
    }
    var cut = "hello"[1:];
    if (cut[0] != 'e' || cut.len != 4 || cut[3] != 'o') {
        return 7;
    }
    if (at(tail()) != 0 || at("hello"[1:]) != 0) {
        return 8;
    }
    return 0;
}
