import "builtin";

comptime const label = "hello"b;
comptime const cut = label[1:4];
comptime const same = builtin.memeql[u8]("hi"b, "hi"b);
comptime const diff = builtin.memeql[u8]("hi"b, "ha"b);
comptime const longer = builtin.memeql[u8]("hi"b, "hi!"b);
comptime const empty = builtin.memeql[u8](""b, ""b);
comptime const slice = builtin.memeql[u8]("hello"b[0:2], "he"b);
comptime const named = builtin.memeql[u8](label[1:4], "ell"b);
comptime const again = builtin.memeql[u8](cut, "ell"b);
comptime const both = builtin.memeql[u8](label, label);
comptime const nul = builtin.memeql[u8]("a\000b"b, "a\000b"b);
comptime const not_ab = builtin.memeql[u8]("a\000b"b, "ab"b);
comptime const raw = builtin.memeql[u8](`hi`b, "hi"b);
comptime const tail = builtin.memeql[u8]("hello"b[1:], "ello"b);
comptime const head = builtin.memeql[u8]("hello"b[:2], "he"b);
comptime const whole = builtin.memeql[u8]("hello"b[:], "hello"b);
comptime const blank = builtin.memeql[u8]("hello"b[2:2], ""b);
comptime const inferred = builtin.memeql("hi"b, "hi"b);
var live = builtin.memeql[u8]("hi"b, "hi"b);
comptime const cmp_eq = builtin.memcmp[u8]("ab"b, "ab"b);
comptime const cmp_lt = builtin.memcmp[u8]("ab"b, "ac"b);
comptime const cmp_gt = builtin.memcmp[u8]("ac"b, "ab"b);
comptime const cmp_short = builtin.memcmp[u8]("a"b, "ab"b);
comptime const cmp_long = builtin.memcmp[u8]("ab"b, "a"b);
comptime const cmp_empty = builtin.memcmp[u8](""b, ""b);
comptime const cmp_nul = builtin.memcmp[u8]("a\000b"b, "a\000c"b);
comptime const cmp_prefix = builtin.memcmp[u8]("hi"b, "hi!"b);
comptime const cmp_inferred = builtin.memcmp("ab"b, "ac"b);
var live_cmp = builtin.memcmp[u8]("ab"b, "ac"b);

assert(builtin.memeql[u8]("hi"b, "hi"b), "eq"b);
assert(same == 1, "same"b);
assert(diff == 0, "diff"b);
assert(longer == 0, "long"b);
assert(empty == 1, "empty"b);
assert(slice == 1, "slice"b);
assert(named == 1, "named"b);
assert(again == 1, "again"b);
assert(both == 1, "both"b);
assert(nul == 1, "nul"b);
assert(not_ab == 0, "ab"b);
assert(raw == 1, "raw"b);
assert(tail == 1, "tail"b);
assert(head == 1, "head"b);
assert(whole == 1, "whole"b);
assert(blank == 1, "blank"b);
assert(inferred == 1, "infer"b);
assert(cmp_eq == 0, "ceq"b);
assert(cmp_lt == -1, "clt"b);
assert(cmp_gt == 1, "cgt"b);
assert(cmp_short == -1, "cshort"b);
assert(cmp_long == 1, "clong"b);
assert(cmp_empty == 0, "cempty"b);
assert(cmp_nul == -1, "cnul"b);
assert(cmp_prefix == -1, "cprefix"b);
assert(cmp_inferred == -1, "cinfer"b);

comptime func answer() i32 {
    return builtin.memeql[u8]("hi"b, "hi"b);
}

func main() i32 {
    var text = "hi"b;
    const local = "ha"b;
    var xs = [_]i32{1, 2};
    var ys = [_]i32{1, 3};
    var zs = [_]i32{1, 2};
    if (!live || live_cmp != -1 || same != 1 || diff != 0 || not_ab != 0 || answer() != 1) {
        return 0;
    }
    if (builtin.memeql[u8]("hi"b, "ha"b) || !builtin.memeql[u8]("hi"b, "hi"b)) {
        return 0;
    }
    if (!builtin.memeql[u8](text, "hi"b) || builtin.memeql[u8](text, local) || !builtin.memeql[u8](local, "ha"b)) {
        return 1;
    }
    if (builtin.memeql[u8](text[0:2], local[0:2]) || !builtin.memeql[u8]("hi"b[0:2], "hi"b)) {
        return 2;
    }
    if (!builtin.memeql[u8](""b, ""b) || builtin.memcmp[u8]("a"b, "ab"b) != -1) {
        return 3;
    }
    if (builtin.memcmp[u8](text, "ha"b) != 1 || builtin.memcmp[u8](local, text) != -1) {
        return 4;
    }
    if (builtin.memeql[i32](xs[:], ys[:]) || !builtin.memeql[i32](xs[:], zs[:])) {
        return 5;
    }
    if (builtin.memcmp[i32](xs[:], ys[:]) != -1 || builtin.memcmp[i32](xs[0:2], zs[:]) != 0) {
        return 6;
    }
    if (builtin.memeql[i32](xs[0:2], ys[:]) || !builtin.memeql[i32](xs[0:2], zs[:]) ||
        builtin.memeql(text, "hi"b) == false) {
        return 7;
    }
    return 42;
}
