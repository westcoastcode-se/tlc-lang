import "std/mem";

comptime const label = "hello"b;
comptime const cut = label[1:4];
comptime const same = mem.memeql<u8>("hi"b, "hi"b);
comptime const diff = mem.memeql<u8>("hi"b, "ha"b);
comptime const longer = mem.memeql<u8>("hi"b, "hi!"b);
comptime const empty = mem.memeql<u8>(""b, ""b);
comptime const slice = mem.memeql<u8>("hello"b[0:2], "he"b);
comptime const named = mem.memeql<u8>(label[1:4], "ell"b);
comptime const again = mem.memeql<u8>(cut, "ell"b);
comptime const both = mem.memeql<u8>(label, label);
comptime const nul = mem.memeql<u8>("a\000b"b, "a\000b"b);
comptime const not_ab = mem.memeql<u8>("a\000b"b, "ab"b);
comptime const raw = mem.memeql<u8>(`hi`b, "hi"b);
comptime const tail = mem.memeql<u8>("hello"b[1:], "ello"b);
comptime const head = mem.memeql<u8>("hello"b[:2], "he"b);
comptime const whole = mem.memeql<u8>("hello"b[:], "hello"b);
comptime const blank = mem.memeql<u8>("hello"b[2:2], ""b);
comptime const inferred = mem.memeql("hi"b, "hi"b);
var live = mem.memeql<u8>("hi"b, "hi"b);
comptime const cmp_eq = mem.memcmp<u8>("ab"b, "ab"b);
comptime const cmp_lt = mem.memcmp<u8>("ab"b, "ac"b);
comptime const cmp_gt = mem.memcmp<u8>("ac"b, "ab"b);
comptime const cmp_short = mem.memcmp<u8>("a"b, "ab"b);
comptime const cmp_long = mem.memcmp<u8>("ab"b, "a"b);
comptime const cmp_empty = mem.memcmp<u8>(""b, ""b);
comptime const cmp_nul = mem.memcmp<u8>("a\000b"b, "a\000c"b);
comptime const cmp_prefix = mem.memcmp<u8>("hi"b, "hi!"b);
comptime const cmp_inferred = mem.memcmp("ab"b, "ac"b);
var live_cmp = mem.memcmp<u8>("ab"b, "ac"b);

assert(mem.memeql<u8>("hi"b, "hi"b), "eq"b);
assert(same, "same"b);
assert(!diff, "diff"b);
assert(!longer, "long"b);
assert(empty, "empty"b);
assert(slice, "slice"b);
assert(named, "named"b);
assert(again, "again"b);
assert(both, "both"b);
assert(nul, "nul"b);
assert(!not_ab, "ab"b);
assert(raw, "raw"b);
assert(tail, "tail"b);
assert(head, "head"b);
assert(whole, "whole"b);
assert(blank, "blank"b);
assert(inferred, "infer"b);
assert(cmp_eq == 0, "ceq"b);
assert(cmp_lt == -1, "clt"b);
assert(cmp_gt == 1, "cgt"b);
assert(cmp_short == -1, "cshort"b);
assert(cmp_long == 1, "clong"b);
assert(cmp_empty == 0, "cempty"b);
assert(cmp_nul == -1, "cnul"b);
assert(cmp_prefix == -1, "cprefix"b);
assert(cmp_inferred == -1, "cinfer"b);

comptime func answer() i32 {
    return mem.memeql<u8>("hi"b, "hi"b);
}

func main() i32 {
    var text = "hi"b;
    const local = "ha"b;
    var xs = [_]i32{1, 2};
    var ys = [_]i32{1, 3};
    var zs = [_]i32{1, 2};
    if (!live || live_cmp != -1 || !same || diff || not_ab || answer() != 1) {
        return 0;
    }
    if (mem.memeql<u8>("hi"b, "ha"b) || !mem.memeql<u8>("hi"b, "hi"b)) {
        return 0;
    }
    if (!mem.memeql<u8>(text, "hi"b) || mem.memeql<u8>(text, local) || !mem.memeql<u8>(local, "ha"b)) {
        return 1;
    }
    if (mem.memeql<u8>(text[0:2], local[0:2]) || !mem.memeql<u8>("hi"b[0:2], "hi"b)) {
        return 2;
    }
    if (!mem.memeql<u8>(""b, ""b) || mem.memcmp<u8>("a"b, "ab"b) != -1) {
        return 3;
    }
    if (mem.memcmp<u8>(text, "ha"b) != 1 || mem.memcmp<u8>(local, text) != -1) {
        return 4;
    }
    if (mem.memeql<i32>(xs[:], ys[:]) || !mem.memeql<i32>(xs[:], zs[:])) {
        return 5;
    }
    if (mem.memcmp<i32>(xs[:], ys[:]) != -1 || mem.memcmp<i32>(xs[0:2], zs[:]) != 0) {
        return 6;
    }
    if (mem.memeql<i32>(xs[0:2], ys[:]) || !mem.memeql<i32>(xs[0:2], zs[:]) ||
        mem.memeql(text, "hi"b) == false) {
        return 7;
    }
    return 42;
}
