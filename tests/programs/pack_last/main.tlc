func head[T type](value T) T {
    return value;
}

func rest_of[T type](value i32, rest T) T {
    return rest;
}

func width[N i32](rest i32) i32 {
    return N;
}

func main() i32 {
    if (head(40) != 40) {
        return 1;
    }
    a, b := rest_of(5, (7, 8));
    if (a != 7 || b != 8) {
        return 2;
    }
    if (rest_of(5, 9) != 9) {
        return 3;
    }
    x, y := rest_of(3, (4, 'b'));
    if (x != 4 || y != 'b' || sizeof(y) != 1) {
        return 4;
    }
    if (width[4](1) != 4) {
        return 5;
    }
    if (head[i32](40) != 40) {
        return 6;
    }
    if (head[i32](8) != 8) {
        return 7;
    }
    return 42;
}
