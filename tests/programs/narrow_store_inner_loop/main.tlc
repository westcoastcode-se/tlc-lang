// An inner loop that stores a `?*Node` into the name runs its read again after that store. The name is a
// `?*Node` for that whole loop, so `p.v` there needs its own check.
type Node struct {
    next ?*Node;
    v i32;
};

func main() i32 {
    var a Node = {.next = null, .v = 1};
    var p ?*Node = &a;
    var sum = 0;
    while (p != null) {
        var i = 0;
        while (i < 2) {
            sum += p.v;
            p = p.next;
            i++;
        }
    }
    return sum;
}
