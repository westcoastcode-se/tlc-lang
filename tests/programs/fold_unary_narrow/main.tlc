// `-n` and `~n` on a `u8` or a `u16` work on the operand promoted to a signed `i32`, at run time as in a
// constant. `i64(-n)` keeps that sign.
func neg(n u8) i64 {
    return i64(-n);
}
func not16(n u16) i64 {
    return i64(~n);
}
func main() i32 {
    var bad = 0;
    if (neg(101u8) != -101 || neg(101u8) != i64(-(u8(101)))) { bad |= 1; }
    if (not16(7u16) != -8) { bad |= 2; }
    var s i8 = 5;
    if (i64(-s) != -5) { bad |= 4; }
    return bad == 0 ? 42 : bad;
}
