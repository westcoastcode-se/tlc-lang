struct Point {
    x int;
    y int;
};

struct Node {
    n int;
    next *Node;
};

func make(a Point) Point {
    var p Point;
    p.x = a.x;
    p.y = a.y;
    return p;
}

func Point::sum(this self Point, extra int) int {
    return self.x + self.y + extra;
}

func main() int {
    var p Point;
    p.x = 20;
    p.y = 10;
    var q *Point;
    q = &p;
    var head Node;
    head.n = 4;
    head.next = &head;
    var made Point;
    made = make(*q);
    return made.sum(0) + head.next.n + sizeof(Point);
}
