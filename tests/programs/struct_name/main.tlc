type Point struct {
    x i32;
    y i32;
};

type Node struct {
    n i32;
    next *Node;
};

func make(a Point) Point {
    var p Point;
    p.x = a.x;
    p.y = a.y;
    return p;
}

func Point::sum(self this, extra i32) i32 {
    return self.x + self.y + extra;
}

func main() i32 {
    var p Point;
    p.x = 20;
    p.y = 10;
    var q *Point = &p;
    var head Node = {.n = 4, .next = &head};
    var made Point;
    made = make(*q);
    return made.sum(0) + head.next.n + sizeof(Point);
}
