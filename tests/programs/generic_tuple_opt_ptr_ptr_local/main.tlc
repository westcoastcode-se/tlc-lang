func num[T type](value ?**T) i32 {
    var q ?**T = value;
    if (q == null) {
        return 0;
    }
    return **q;
}

func read[T type](value ?**T) i32 {
    var q ?**T = value;
    if (q == null) {
        return 0;
    }
    return (**q)[0] + (**q)[1];
}

func deep[T type](value ?**T) i32 {
    var q ?**T = value;
    if (q == null) {
        return 0;
    }
    return (**q)[0][0] + (**q)[1];
}

func main() i32 {
    var n = 40;
    var np = &n;
    if (num(&np) != 40) {
        return 1;
    }
    var wide = ((40, 2), 1);
    var wp = &wide;
    if (deep(&wp) != 41) {
        return 2;
    }
    var row = (40, 2);
    var p = &row;
    return read(&p);
}
