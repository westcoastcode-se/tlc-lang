type Point struct {
    x i32;
};

func Point::id[T type](value T) T {
    return value;
}

extern func Point::add[T type](value T) T {
    return value;
}

type Ptr *i32;

func Ptr::make[T type](value T) T {
    return value;
}

func main() i32 {
    return Point.id[i32](20) + Point.add[i32](20) + Ptr.make[i32](2);
}
