type Quad [4]i32;

type Hold struct {
    items *[4]i32;
};

const COUNT = 4;

var file_row = [_]i32{1, 2, 3, 4};
const FILE_N = (&file_row).len;

func written(p *[4]i32) i32 {
    return p.len;
}

func rows(p *[2][3]i32) i32 {
    return p.len * 10 + p[0].len + (*p)[1].len;
}

func headers(p *[2][]i32) i32 {
    return p.len;
}

func frozen(p *const [4]i32) i32 {
    return p.len;
}

func local() i32 {
    var row = [_]i32{1, 2, 3, 4};
    var p = &row;
    row[0] = 9;
    return (&row).len + p.len;
}

func from_new() i32 {
    var buf = new [_]i32{1, 2, 3, 4};
    var n = buf.len;
    delete buf;
    return n;
}

func narrowed(opt ?*[4]i32) i32 {
    if (opt == null) {
        return 0;
    }
    return opt.len;
}

func held(p *[4]i32) i32 {
    const N = p.len;
    return N;
}

func star(p *[4]i32) i32 {
    return (*p).len;
}

func named(p *Quad) i32 {
    return p.len;
}

func field(h *Hold) i32 {
    return h.items.len;
}

func sized_name(p *[COUNT]i32) i32 {
    return p.len;
}

func cube(p *[2][2][2]i32) i32 {
    return p.len;
}

func main() i32 {
    var row = [_]i32{1, 2, 3, 4};
    var grid = [_][3]i32{{1, 2, 3}, {4, 5, 6}};
    var left = [_]i32{1, 2};
    var right = [_]i32{3, 4};
    var table = [_][]i32{left[:], right[:]};
    var box = Hold{.items = &row};
    var cube_row = [_][2][2]i32{{{1, 2}, {3, 4}}, {{5, 6}, {7, 8}}};
    var q Quad;
    return written(&row) + rows(&grid) + headers(&table) + frozen(&row) + local() + from_new() +
        narrowed(null) + held(&row) + star(&row) + named(&q) + field(&box) +
        sized_name(&row) + cube(&cube_row) + FILE_N;
}
