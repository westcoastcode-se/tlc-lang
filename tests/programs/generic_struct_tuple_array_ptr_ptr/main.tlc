type Box[T type] struct {
    p **T;
}

type Deep[T type] struct {
    p ***T;
}

func make[T type](value **T) Box[T] {
    var box Box[T] = {.p = value};
    return box;
}

func make_deep[T type](value ***T) Deep[T] {
    var box Deep[T] = {.p = value};
    return box;
}

func pair[T type](a T, b T) [2]T {
    var row [2]T;
    row[0] = a;
    row[1] = b;
    return row;
}

func fill[T type](a T, b T, c T, d T) [2][2]T {
    var g [2][2]T;
    g[0][0] = a;
    g[0][1] = b;
    g[1][0] = c;
    g[1][1] = d;
    return g;
}

func main() i32 {
    var one = (40, 2);
    var tp = &one;
    var plain = make(&tp);
    if ((**plain.p)[0] + (**plain.p)[1] != 42) {
        return 1;
    }
    var g = fill((40, 2), (1, 3), (4, 5), (6, 7));
    var gp = &g;
    var wide = make(&gp);
    if ((**wide.p)[0][0][0] + (**wide.p)[1][1][1] != 47) {
        return 2;
    }
    var row = pair((40, 2), (1, 3));
    var p = &row;
    var pp = &p;
    var tri = make_deep(&pp);
    if ((***tri.p)[0][0] + (***tri.p)[1][1] != 43) {
        return 3;
    }
    var box = make(&p);
    return (**box.p)[0][0] + (**box.p)[1][1];
}
