type Box struct {
    v i32;
};

func Box::split(self this) (i32, i32) {
    return self.v, self.v + 1;
}

func add(x i32, y i32) (i32, i32) {
    return x + y, x;
}

func main() i32 {
    func pair(n i32) (i32, i32) {
        return n + 2, n;
    }
    sum, orig := add(20, 22);
    var extra, base = add(1, 1);
    extra, base = add(0, 0);
    var box Box;
    box.v = 3;
    var left, right = box.split();
    var z, w = func() (i32, i32) {
        return 0, 0;
    }();
    p, q := pair(0);
    return sum - orig + 20 + base - extra + left - right + 1 + z + w + p - q - 2;
}
