// A pointer alias does not convert to or from the pointer without a cast.
type Point struct {
    x i32;
}

type Ptr *Point;

func read(p Ptr) i32 {
    return p.x;
}

func raw(p *Point) i32 {
    return p.x;
}

func main() i32 {
    var p Point;
    p.x = 1;
    var good = Ptr(&p);
    var q Ptr = &p;
    var back *Point = good;
    return read(&p) + raw(good);
}
