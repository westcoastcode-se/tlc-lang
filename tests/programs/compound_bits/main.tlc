    }
    n >>= 2;
    if (n != 4) {
        return 6;
    }
    var neg = -8;
    neg >>= 1;
    if (neg != -4) {
        return 7;
    }
    var wide u32 = 0 - 1;
    wide >>= 1;
    if (wide != 2147483647u32) {
