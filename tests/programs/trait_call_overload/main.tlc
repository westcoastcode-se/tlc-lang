type Shape trait {
    func area() i32;
};

func Shape::twice(self *this) i32 {
    return self.area() + self.area();
}

type Rect struct {
    w i32;
    h i32;
};

func Rect::area(self *this) i32 {
    return self.w * self.h;
}

func Rect::twice(self *this, n i32) i32 {
    return n;
}

type Box struct {
    n i32;
};

func Box::area(self *this) i32 {
    return self.n;
}

func Box::twice(self *this) i32 {
    return 7;
}

func Box::twice(self *this, n i32) i32 {
    return n;
}

func use(s *Shape) i32 {
    return s.twice();
}

func main() i32 {
    var r Rect;
    r.w = 5;
    r.h = 6;
    var b Box;
    b.n = 3;
    return use(&r) + use(&b) + r.twice(4);
}
