type Kind enum {
    A,
    B,
};

type Holder struct {
    value union(Kind) {
        A struct {
            data union {
                n i32;
                m i32;
            };
        };
        B struct { n i32; };
    };
    extra i32;
};

type Wrap struct {
    data union {
        point struct {
            inner union {
                n i32;
                m i32;
            };
        };
        k i32;
    };
};

func main() i32 {
    var h Holder = {.value = {.A = {.data = {.n = 4}}}};
    h.extra = 8;
    var w Wrap;
    w.data.point.inner.n = 6;
    if (Kind(h.value) != Kind.A || h.value.A.data.m != 4 || h.extra != 8 || w.data.point.inner.m != 6) {
        return 0;
    }
    var sum = h.value.A.data.m + w.data.point.inner.m + h.extra;
    w.data.k = 1;
    if (w.data.k != 1) {
        return 0;
    }
    return sum + w.data.k;
}
