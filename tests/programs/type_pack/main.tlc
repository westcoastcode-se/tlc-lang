func keep[...U](args U) U { return args; }

func first[...U](args U) typeof(args[0]) { return args[0]; }

func pass() (i32, i32) { return keep((3, 4)); }

func main() i32 {
    var n = keep(40);
    a, b := keep((40, 2));
    x, y := keep((40, 'a'));
    var row [3]i32 = {10, 20, 12};
    var head = first((7, 8));
    var one = keep((5));
    var p = keep[i32](1);
    c, d := keep[i32, u8]((3, 'b'));
    if (n != 40) { return 1; }
    if (a != 40 || b != 2) { return 2; }
    if (x != 40 || y != 'a') { return 3; }
    if (row[0] != 10 || row[1] != 20 || row[2] != 12) { return 4; }
    if (head != 7) { return 5; }
    if (one != 5) { return 6; }
    if (p != 1) { return 7; }
    if (c != 3 || d != 'b') { return 8; }
    if (sizeof(y) != 1) { return 9; }
    e, f := pass();
    if (e != 3 || f != 4) { return 10; }
    return 42;
}
