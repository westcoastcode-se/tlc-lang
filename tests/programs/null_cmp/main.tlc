func main() int {
    var p *int;
    var x int;
    var n int;
    x = 7;
    p = null;
    n = 0;
    if (p == null) {
        n = 1;
    }
    if (p != null) {
        return 0;
    }
    p = &x;
    if (p == null) {
        return 0;
    }
    if (p != null) {
        n = n + 41;
    }
    return n;
}
