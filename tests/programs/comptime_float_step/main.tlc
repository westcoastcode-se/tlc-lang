// `i = i32(i + 1.0)` on an `i32` loop variable stores the converted value. The comptime loop runs and returns.
// The `double` store overwrote the evaluator's frame and crashed the compiler.
comptime func count(n i32) i32 {
    var x = 0;
    for (var i = 0; i < n; i = i32(i + 1.0)) {
        x = x + 2;
    }
    return x;
}

const twenty = count(10);

func main() i32 {
    var y = 0;
    for (var i = 0; i < 22; i = i32(i + 1.5)) {
        y = y + 1;
    }
    return twenty + y;
}
