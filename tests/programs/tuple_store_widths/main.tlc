// A tuple value is stored at the element widths of the place it goes to. `(40u64, 2)` into a
// `(u32, i32)` wrote the `i64` over both elements, so the second one read 0.
type Box struct {
    value (u32, i32);
}

var g (u32, i32);

func main() i32 {
    var bad = 0;
    var box Box;
    box.value = (40u64, 2);
    if (box.value[0] != 40u32 || box.value[1] != 2) {
        bad |= 1;
    }
    var t (u32, i32) = (0u32, 0);
    t = (40u64, 2);
    var p = &t;
    *p = (41u64, 3);
    if (t[0] != 41u32 || t[1] != 3) {
        bad |= 2;
    }
    g = (40u64, 2);
    if (g[0] != 40u32 || g[1] != 2) {
        bad |= 4;
    }
    // A signed element widens with its sign, an unsigned one with zeros.
    var wide (i64, u64) = (0, 0u64);
    wide = (-3, 4294967295u32);
    if (wide[0] != -3 || wide[1] != 4294967295u64) {
        bad |= 8;
    }
    var nested ((u32, i32), i8) = ((0u32, 0), 0i8);
    nested = ((40u64, 2), 1i8);
    if (nested[0][0] != 40u32 || nested[0][1] != 2 || nested[1] != 1i8) {
        bad |= 16;
    }
    var mixed (f64, i32) = (0.0, 0);
    mixed = (1.5f, 2);
    if (mixed[0] != 1.5 || mixed[1] != 2) {
        bad |= 32;
    }
    return bad == 0 ? 42 : bad;
}
