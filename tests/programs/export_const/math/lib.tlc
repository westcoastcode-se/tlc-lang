package math;

export type Entity struct {
    export id i32;
};

export comptime const Entity::next = 15;
export comptime const Entity::bias = 1.0f;
comptime const Entity::hidden = 100;

export func width() i32 {
    return sizeof(Entity);
}

export type Box[T type] struct {
    value T;
};

export comptime const Box[T]::limit = 6;

export comptime const spare = 2;
