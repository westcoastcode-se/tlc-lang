const row = [_]i32{2, 0};
const grid = [_][2]i32{{2, 0}, {40, 0}};

type Point struct { x i32; y i32; }
const points = [_]Point{Point{.x = 2, .y = 0}, Point{.x = 40, .y = 0}};

comptime func field(p ([2]i32, i32)) i32 {
    return p[0][0] + p[1];
}

comptime func nested(p ([2][2]i32, i32)) i32 {
    return p[0][0][0] + p[0][1][0];
}

comptime func place(p ([2]Point, i32)) i32 {
    return p[0][0].x + p[0][1].x;
}

func main() i32 {
    if (field((row, 40)) == 42 && nested((grid, 0)) == 42 && place((points, 0)) == 42) {
        return 42;
    }
    return 0;
}
