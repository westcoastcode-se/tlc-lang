func main() int {
    var n int = 0;
    var bits int = 0;
    var c *char = *char(0);
    var v *void = *void(0);
    var p *int = &n;
    bits = 42;
    c = *char(bits);
    v = *void(c);
    bits = int(v);
    n = 300;
    p = &n;
    c = *char(p);
    v = *void(c);
    p = *int(v);
    if (*p != 300) {
        return 1;
    }
    return bits;
}
