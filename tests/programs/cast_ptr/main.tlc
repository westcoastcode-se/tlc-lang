func main() int {
    var n int;
    var bits int;
    var c *char;
    var v *void;
    var p *int;
    bits = 42;
    c = *char(bits);
    v = *void(c);
    bits = int(v);
    n = 300;
    p = &n;
    c = *char(p);
    v = *void(c);
    p = *int(v);
    if (*p != 300) {
        return 1;
    }
    return bits;
}
