type Point struct {
    x i32;
    y i32;
};

func Point::put(self *this, other Point) void {
    *self = other;
}

func Point::move(self *this) void {
    self.x = self.x + 1;
}

func main() i32 {
    var p Point;
    p.x = 0;
    p.y = 0;
    var q Point;
    q.x = 40;
    q.y = 1;
    p.put(q);
    p.move();
    return p.x + p.y;
}
