// A file-scope array, slice, or struct list holds strings and ranges as constant headers.
const label = "hello";
var nums [3]i32 = {1, 2, 3};
var a [3][]const u8 = {label, label[1:3], "z"};
var b [2][]i32 = {nums[:], nums[1:]};
var c [2][2][]const u8 = {{"a", "bb"}, {"ccc", label}};
type Entry struct { name []const u8; n i32; }
var table [2]Entry = {{.name = "one", .n = 1}, {.name = "three", .n = 3}};
func main() i32 {
    var t = i32(a[0].len + a[1].len + a[2].len);   // 5 + 2 + 1 = 8
    t += i32(b[1].len) + b[1][0];                 // 2 + 2 = 4
    t += i32(c[1][0].len + c[1][1].len);          // 3 + 5 = 8
    t += i32(table[1].name.len) + table[1].n;     // 5 + 3 = 8
    b[0][0] = 9;
    t += nums[0];                                 // 9
    return t + i32(a[1][0]) - 101 + 5 + count() - 3;  // `e` is 101
}

var words [][]const u8 = [_][]const u8{"ab", "cde"};

func count() i32 {
    return i32(words[1].len);
}
