// A `comptime func` calls an ordinary function with a body. That function runs in the same compiled call.
func square(n i32) i32 { return n * n; }
func helper(n i32) i32 {
    var total = 0;
    for (var i = 0; i < n; i += 1) { total += square(i); }
    return total;
}
comptime func compute(n i32) i32 { return helper(n) + square(2); }
comptime const k = compute(4);   // 0+1+4+9 = 14 + 4 = 18
func main() i32 {
    var row [k]i32;
    return i32(row.len) + compute(3) + 15;   // 18 + 9 + 15
}
