func num[T type](value *const T) i32 {
    return *value;
}

func at[T type](value *const T) i32 {
    return (*value)[0];
}

func id[T type](value *const T) i32 {
    return (*value)[0] + (*value)[1];
}

func deep[T type](value *const T) i32 {
    return (*value)[0][0] + (*value)[1];
}

func main() i32 {
    var n = 40;
    if (num(&n) != 40) {
        return 1;
    }
    var nums [4]i32;
    nums[0] = 1;
    nums[1] = 2;
    nums[2] = 6;
    nums[3] = 7;
    if (at(&nums) != 1) {
        return 2;
    }
    var wide = ((40, 2), 1);
    if (deep(&wide) != 41) {
        return 3;
    }
    var row = (40, 2);
    return id(&row);
}
