package math;

export type Entity struct {
    id i32;
};

export type Integer i32;

export type Color enum { Red, Blue };

type Point struct {
    export x i32;
    export y i32;
};

export var Entity::next i32 = 20;
export var Entity::bias = 1.0f;
export var Integer::ten i32 = 10;
export var Color::label i32 = 8;
var Entity::hidden i32 = 100;

export comptime const base = 4;
export comptime const pad = 0.0f;
export comptime const origin Point = {.x = 1, .y = 1};
export comptime const row = [_]i32{3, 1};
