type Point struct {
    x i32;
};

type Box[T type] struct {
    n T;
};

func touch() {
    var n i32 = 1;
}

func ready() void;

func ready() {
    var n i32 = 2;
}

func Point::clear(self *this) {
    self.x = 0;
}

func hold[T type](value T) {
    var kept = value;
}

func Box[T]::wipe(self *this) {
    var kept = self.n;
}

func nest() {
    func inner() {
        var n i32 = 3;
    }
    inner();
}

func take(op func () void) i32 {
    op();
    return 40;
}

func main() i32 {
    touch();
    ready();
    var p Point;
    p.x = 7;
    p.clear();
    hold(1);
    var box Box[i32];
    box.n = 4;
    box.wipe();
