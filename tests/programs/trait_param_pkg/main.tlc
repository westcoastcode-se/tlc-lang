import "geom";

type Rect struct {
    w i32;
    h i32;
};

func Rect::area(self this) i32 {
    return self.w;
}

func Rect::extra(self this) i32 {
    return self.h;
}

func use(s geom.Parent) i32 {
    return s.area() + s.extra();
}

func use_ptr(s *geom.Parent) i32 {
    return s.area() + s.extra();
}

func main() i32 {
    var r Rect;
    r.w = 20;
    r.h = 1;
    return use(r) + use_ptr(&r);
}
