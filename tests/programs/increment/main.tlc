type Box struct {
    x i32;
}

func main() i32 {
    var n = 1;
    var a = ++n;
    var b = n++;
    if (a != 2 || b != 2 || n != 3) {
        return 1;
    }
    var row [2]i32;
    row[0] = 4;
    if (row[0]++ != 4 || row[0] != 5) {
        return 2;
    }
    var p = &n;
    if (++*p != 4) {
        return 3;
    }
    var box Box;
    box.x = 7;
    if (++box.x != 8) {
        return 4;
    }
    var i = 0;
    var sum = 0;
    for (; i < 3; ++i) {
        sum = sum + i;
    }
    if (sum != 3 || i != 3) {
        return 5;
    }
    var top = 2147483647;
    if (++top != -2147483647 - 1) {
        return 6;
    }
    return 0;
}
