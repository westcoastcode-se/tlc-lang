}

var g i32 = 2.5;

func take(n i32) i32 {
    return n;
}

func pinned(comptime n i32) i32 {
    return n;
}

comptime func bias(n i32) i32 {
    return n;
}

func give() f64 {
    return 2.5;
}

func main() i32 {
    var n i32 = 2.5;
    var m = 0;
    m = 1.5f;
    var flag bool = 0.5;
    var from_call i64 = give();
    var p = Point{.x = 2.5};
    var t (i32, u8) = (1, 2.5);
