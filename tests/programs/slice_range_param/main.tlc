func open(row [4]i32) []i32 {
    return row[0:2];
}

func tail(row [4]i32, i i32) []i32 {
    return row[i:];
}

func head(row [4]i32, j i32) []i32 {
    return row[:j];
}

func whole(row [4]i32) []i32 {
    return row[:];
}

func count(row [4]i32) i32 {
    return row.len;
}

func rows(grid [2][3]i32) [][3]i32 {
    return grid[0:2];
}

func headers(table [2][]i32) [][]i32 {
    return table[:];
}

func sized[N i32](row [N]i32) i32 {
    var part = row[0:2];
    return part.len + row.len;
}

func main() i32 {
    var data [4]i32;
    data[0] = 10;
    data[1] = 20;
    data[2] = 30;
    var view []i32 = open(data);
    if (view[0] + view[1] + view.len != 32) {
        return 1;
    }
    var rest = tail(data, 2);
    if (rest.len != 2 || rest[0] != 30) {
        return 2;
    }
    var top = head(data, 1);
    if (top.len != 1 || top[0] != 10) {
        return 3;
    }
    var all = whole(data);
    if (count(data) != 4 || all.len != 4 || all[0] != 10 || all[1] != 20 || all[2] != 30) {
        return 4;
    }
    var grid [2][3]i32;
    grid[0][0] = 1;
    grid[0][1] = 2;
    grid[1][2] = 6;
    var band [][3]i32 = rows(grid);
    if (band.len != 2 || band[0][0] != 1 || band[0][1] != 2 || band[1][2] != 6) {
        return 5;
    }
    var a = [_]i32{7, 8};
    var b = [_]i32{9};
    var table = [_][]i32{a[:], b[:]};
    var flat = headers(table);
    if (flat.len != 2 || flat[0][1] != 8 || flat[1][0] != 9) {
        return 6;
    }
    if (sized[4](data) != 6) {
        return 7;
    }
    var local = data[1:3];
    if (local.len != 2 || local[0] != 20 || local[1] != 30) {
        return 8;
    }
    return view[0] + view[1] + view.len;
}
